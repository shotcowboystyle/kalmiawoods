---
import Separator from './Separator.astro';
import Socials from './Socials.astro';

const currentYear = new Date().getFullYear();
---

<footer id="main-footer" class="pt-16 pb-6 dark:bg-gray-800">
  <div class="container px-8 mx-auto">
    <div class="flex flex-wrap">
      <div class="w-full px-4 md:w-6/12">
        <h4 class="text-xl font-semibold">Let's keep in touch!</h4>
        <h5 class="mt-0 mb-2 text-sm text-slate-600">
          Find us on any of these platforms, we respond 1-2 business days.
        </h5>
        <Socials />
      </div>

      <div class="w-full px-4 md:w-6/12">
        <div class="flex flex-wrap mb-6 items-top">
          <div class="w-full pt-6 ml-auto md:w-6/12 md:px-4 md:pt-0 xl:w-4/12">
            <span class="block mb-2 text-sm font-semibold uppercase text-slate-500"
              >Useful Links</span
            >
            <ul class="list-unstyled">
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="https://www.creative-tim.com/presentation"
                  target="_blank">About Us</a
                >
              </li>
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="/availability">Availability</a
                >
              </li>
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="https://www.github.com/creativetimofficial/tailwind-starter-kit"
                  target="_blank">Github</a
                >
              </li>
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="https://www.creative-tim.com/bootstrap-themes/free"
                  target="_blank">Free Products</a
                >
              </li>
            </ul>
          </div>

          <div class="w-full pt-6 ml-auto md:w-6/12 md:px-4 md:pt-0 xl:w-4/12">
            <span class="block mb-2 text-sm font-semibold uppercase text-slate-500"
              >Other Resources</span
            >
            <ul class="list-unstyled">
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="https://github.com/creativetimofficial/tailwind-starter-kit/blob/master/LICENSE.md"
                  target="_blank">MIT License</a
                >
              </li>
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="https://creative-tim.com/terms"
                  target="_blank">Terms &amp; Conditions</a
                >
              </li>
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="https://creative-tim.com/privacy"
                  target="_blank">Privacy Policy</a
                >
              </li>
              <li>
                <a
                  class="block pb-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
                  href="https://creative-tim.com/contact-us"
                  target="_blank">Contact Us</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <Separator />

    <div class="flex flex-wrap items-center justify-center md:justify-between">
      <div class="w-full px-4 mx-auto text-center md:w-4/12">
        <div class="py-3 text-xs font-semibold text-slate-500">
          <span>Copyright &#169; {currentYear}</span>
          <span class="separator">&nbsp;|&nbsp;</span>
          <span>All rights reserved.</span>
        </div>
      </div>
    </div>
  </div>
</footer>

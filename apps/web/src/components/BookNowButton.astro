  class:list={[
    'z-[-50] transform pl-6 relative flex items-center h-auto pr-0 mx-auto text-left bg-white border border-gray-200 rounded-full shadow-md cursor-pointer min-w-[220px] lg:min-w-[320px] hover:shadow-lg md:absolute left-24 md:left-auto right-2/3 lg:right-1/2 right text-sm translate-x-2/3 lg:translate-x-1/2',
    { 'scale-[1.33] translate-y-[75px] md:opacity-0 duration-200': isHomePage },

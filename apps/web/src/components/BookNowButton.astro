<button
  id="navbar-book-now-button"
  class='hidden z-[-50] transform pl-6 relative md:flex items-center h-auto pr-0 mx-auto text-left bg-white border border-gray-200 rounded-full shadow-md cursor-pointer min-w-[220px] lg:min-w-[320px] hover:shadow-lg md:absolute left-24 md:left-auto right-2/3 lg:right-1/2 right text-sm translate-x-2/3 lg:translate-x-1/2 scale-[1.33] translate-y-[75px] md:opacity-0 duration-200'
>
  <span class="flex-grow text-sm font-medium tracking-wide text-gray-500">Book Now</span>
  <span
    class="flex items-center justify-center w-8 h-8 m-2 ml-0 rounded-full bg-primary hover:saturate-200"
  >
    <Icon name="ri:arrow-right-line" class="h-4 text-white" />
  </span>
</button>

<script>
  const navbarBookingButton = document.getElementById('navbar-book-now-button');
  const navbar = document.getElementById('navbar');
  // Each time the button is clicked, update the count.
  if (navbarBookingButton) {
    navbarBookingButton.addEventListener('click', () => {
      if (navbar) {
        navbar.classList.add('show-booking-quick-form');
      }
    });

    document.addEventListener('click', (event) => {
      const isNavbarClick = navbar?.contains(event.target as HTMLElement);
      if (!isNavbarClick) {
        navbar?.classList.remove('show-booking-quick-form');
      }
    });
  }
</script>

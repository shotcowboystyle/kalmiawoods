---
import BookingOptions from '@components/BookingOptions.astro';
import BookingQuickForm from '@components/BookingQuickForm.astro';
import BookNowButton from '@components/BookNowButton.astro';
import BookNowButtonLink from '@components/BookNowButtonLink.astro';
import Logo from '@components/Logo.astro';
import { ToggleTheme } from '@kalmiawoods/ui';
import { Icon } from 'astro-icon';

export interface Props {
  activeNav?: 'posts' | 'tags' | 'about' | 'search';
}

const navLinks = [
  {
    href: '/availability',
    text: 'Availability',
    icon: 'ri:calendar-line',
  },
];
---

<Fragment>
  <div class="fixed top-0 z-50 w-full py-5 text-white duration-300 md:transition-none" id="navbar">
    <div class="container flex items-start md:grid md:grid-cols-[1fr,5fr,auto,auto]">
      <a href="/" rel="prefetch" class="hidden items-center self-center md:flex">
        <Logo />
      </a>

      <BookNowButton />
      <BookingOptions />

      <div class="flex-grow md:hidden">
        <BookNowButtonLink />
      </div>

      <nav class="ml-2 justify-end md:ml-0" aria-label="Main navigation">
        <ul class="flex justify-end md:w-auto md:flex-row">
          {
            navLinks.map(({ href, text, icon }) => (
              <li>
                <a class="btn-ghost btn font-semibold" href={href} rel="prefetch">
                  <Icon name={icon} class="h-6 w-6 md:hidden" />
                  <span class="sr-only md:not-sr-only">{text}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-1 flex items-center">
        <ToggleTheme client:load />
      </div>
    </div>

    <div id="booking-quick-form-wrapper" class="visible hidden duration-500 md:block">
      <BookingQuickForm />
    </div>
  </div>
</Fragment>

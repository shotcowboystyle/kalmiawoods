---
import BookingOptions from '@components/BookingOptions.astro';
import BookingQuickForm from '@components/BookingQuickForm.astro';
import BookNowButton from '@components/BookNowButton.astro';
import ColorModeToggle from '@components/ColorModeToggle.astro';
import Logo from '@components/Logo.astro';

export interface Props {
  activeNav?: 'posts' | 'tags' | 'about' | 'search';
}

const navLinks = [
  {
    text: 'Availability',
    href: '/availability',
  },
];

const isHomePage = Astro.url.pathname === '/';
---

<Fragment>
  <!-- <a id="skip-to-content" href="#main-content">Skip to content</a> -->
  <div
    class:list={[
      'fixed top-0 z-50 w-full py-5 text-white duration-300 md:transition-none',
      { 'home-navbar': isHomePage },
    ]}
    id="navbar"
  >
    <div class="hidden items-start container md:grid md:grid-cols-[1fr,5fr,auto,auto]">
      <div class="flex items-center self-center">
        <a href="/" rel="prefetch">
          <Logo />
        </a>
      </div>

      <BookNowButton />

      {isHomePage && <BookingOptions />}

      <nav
        class="hidden h-[calc(100vh-72px)] w-full items-center overflow-y-auto md:flex md:h-auto md:w-auto md:justify-end md:overflow-visible"
        aria-label="Main navigation"
      >
        <ul class="flex flex-col justify-end w-full md:w-auto md:flex-row md:self-center">
          {
            navLinks.map(({ text, href }) => (
              <li>
                <a class="font-semibold btn-ghost btn" href={href} rel="prefetch">
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="flex h-[calc(100vh-72px)] w-full items-center overflow-y-auto md:mx-2 md:mb-0 md:flex md:h-auto md:w-auto md:overflow-visible"
      >
        <div class="items-center hidden md:flex">
          <ColorModeToggle />
        </div>
      </div>
    </div>

    {
      isHomePage && (
        <div id="booking-quick-form-wrapper" class="visible duration-500">
          <BookingQuickForm />
        </div>
      )
    }
  </div>
</Fragment>

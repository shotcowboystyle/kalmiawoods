---
import Picture from '@components/Picture.astro';
import { fetchLocalImages } from '@utils/images';
import 'spotlight.js/dist/css/spotlight.min.css';

export const photoGallery = [
  {
    text: 'Cottage',
    href: 'https://google.com',
    image: '@assets/images/house-cottage-two.jpeg',
  },

  {
    text: 'Master Bedroom',
    href: 'https://google.com',
    image: '@assets/images/house-master-bedroom-one.jpeg',
  },

  {
    text: 'Garage Bedroom',
    href: 'https://google.com',
    image: '@assets/images/house-garage-bedroom-one.jpeg',
  },

  {
    text: 'Living Area',
    href: 'https://google.com',
    image: '@assets/images/house-living-area-one.jpeg',
  },

  {
    text: 'Kitchen',
    href: 'https://google.com',
    image: '@assets/images/house-kitchen-one.jpeg',
  },

  {
    text: 'Bathrooms',
    href: 'https://google.com',
    image: '@assets/images/house-bathroom-one.jpeg',
  },

  {
    text: 'Game Room',
    href: 'https://google.com',
    image: '@assets/images/house-game-room-one.jpeg',
  },

  {
    text: 'Porches',
    href: 'https://google.com',
    image: '@assets/images/house-porch-one.jpeg',
  },
];

const imageFiles: Record<string, any> = await fetchLocalImages();
let images = await Promise.all(
  Object.entries(imageFiles).map(
    async ([imageKey, imageValue]) =>
      imageKey.includes('house-') && typeof imageValue === 'function' && (await imageValue()),
  ),
);
images = images.filter((image) => !!image);
---

<section class="container pt-12" data-images={JSON.stringify(images)} id="gallery-root">
  <h2 class="mb-6 text-2xl font-semibold">Explore Inside</h2>
  <div class="grid grid-cols-2 gap-x-4 gap-y-6 lg:grid-cols-4 lg:gap-x-8">
    {
      photoGallery.map(({ image, text }) => (
        <div role="button" class="gallery-thumbnail">
          <div class="image-container min-h-min">
            <figure>
              <Picture
                alt={text}
                class="object-cover w-full h-24 shadow-xl rounded-xl md:h-72"
                widths={[175, 314, 378]}
                sizes="(max-width: 440px) 175px, (max-width: 1023px) 378px, 314px"
                aspectRatio="2:3"
                loading="lazy"
                decoding="async"
                src={image}
              />
              <figcaption class="py-2 text-sm font-medium md:text-md">{text}</figcaption>
            </figure>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  import Spotlight from 'spotlight.js/src/js/spotlight.js';

  const galleryRoot = document.getElementById('gallery-root');
  const images = galleryRoot?.dataset.images;

  const thumbnails = document.querySelectorAll('div.gallery-thumbnail');
  thumbnails.forEach((item) => {
    item.addEventListener('click', () => {
      if (images?.length) {
        Spotlight.show(images && JSON.parse(images), {
          infinite: true,
          autofit: true,
          fit: 'cover',
        });
      }
    });
  });
</script>

---
import { ContactForm } from '@kalmiawoods/ui';
---

<section class="relative py-12 text-gray-600 body-font max-sm:pt-72">
  <div class="absolute inset-0">
    <iframe
      width="100%"
      height="100%"
      title="map"
      src="https://maps.google.com/maps?width=100%&height=600&hl=en&q=255+Kalmia+Ln,+Salem,+SC+29676&ie=UTF8&t=&z=14&iwloc=B&output=embed"
      loading="lazy"
      style="filter: grayscale(1) contrast(1.2) opacity(0.7);"></iframe>
  </div>
  <div class="container flex px-5 py-32 mx-auto">
    <div
      class="relative z-10 flex flex-col w-full p-8 mt-10 bg-white rounded-lg shadow-md md:ml-auto md:mt-0 md:w-1/2 lg:w-1/3"
    >
      <ContactForm client:visible />
    </div>
  </div>
</section>

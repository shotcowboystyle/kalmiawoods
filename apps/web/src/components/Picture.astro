---
import { findImage } from '@/utils/images';
import { Picture } from '@astrojs/image/components';
import type { ColorDefinition } from '@astrojs/image/dist/loaders';

export interface Props extends astroHTML.JSX.HTMLAttributes {
  alt: string;
  src: string;
  sizes: string;
  widths: Array<number>;
  aspectRatio?: number | `${number}:${number}`;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'auto' | 'sync';
  format?: 'avif' | 'jpeg' | 'png' | 'webp';
  background?: ColorDefinition;
  fit?: 'cover' | 'contain' | 'fill' | 'inside' | 'outside';
  position?:
    | 'top'
    | 'right top'
    | 'right'
    | 'right bottom'
    | 'bottom'
    | 'left bottom'
    | 'left'
    | 'left top'
    | 'north'
    | 'northeast'
    | 'east'
    | 'southeast'
    | 'south'
    | 'southwest'
    | 'west'
    | 'northwest'
    | 'center'
    | 'centre'
    | 'cover'
    | 'entropy'
    | 'attention';
}

const {
  alt,
  src,
  sizes,
  widths,
  loading,
  aspectRatio,
  decoding,
  // width,
  // height,
  format,
  background,
  fit,
  position,
  ...attrs
} = Astro.props;

// ugly hack to circumvent astro issue with dynamic import
// https://github.com/withastro/astro/issues/3373
// const images = import.meta.glob<ImageMetadata>('../images/*.{jpeg,jpg,png}', {
//   import: 'default',
// });

const image = await findImage(src);
---
<fragment>
  {
    image && (
      <div class="relative max-w-5xl m-auto">
        {typeof image === 'string' ? (
          <Fragment set:html={image} />
        ) : (
          <Picture
            alt={alt}
            class={attrs.class}
            src={image.src}
            widths={widths}
            sizes={sizes}
            loading={loading}
            aspectRatio={aspectRatio}
            decoding={decoding}
            format={format}
            background={background}
            fit={fit}
            position={position}
          />

        // <Picture
        //     class="w-full mx-auto rounded-md"
        //     widths={[400, 768, 1024, 2040]}
        //     sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
        //     aspectRatio={1024 / 576}
        //     loading="eager"
        //     width={1024}
        //     height={576}
        //     {...image}
        //   />
        )}
      </div>
    )
  }
</fragment>


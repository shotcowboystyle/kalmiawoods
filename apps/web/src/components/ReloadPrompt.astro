<script src="../utils/pwa.ts"></script>

<div id="pwa-toast" role="alert" aria-labelledby="toast-message" class="shadow-xl toast-end toast">
  <div class="alert alert-success">
    <div class="message">
      <span id="toast-message"></span>
    </div>
    <button id="pwa-refresh" class="text-black border-black btn-outline btn-sm btn"> Reload</button>
    <button id="pwa-close" class="text-black border-black btn-outline btn-sm btn"> Close</button>
  </div>
</div>

<style>
  #pwa-toast {
    visibility: hidden;
  }

  #pwa-toast.show {
    visibility: visible;
  }

  button#pwa-refresh {
    display: none;
  }

  #pwa-toast.show.refresh button#pwa-refresh {
    display: inline-block;
  }
</style>

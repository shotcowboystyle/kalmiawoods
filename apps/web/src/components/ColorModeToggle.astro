---
import { Icon } from 'astro-icon';
---

<kw-color-mode-toggle>
  <div class="tooltip tooltip-bottom" data-tip="Color mode">
    <label
      id="color-mode-toggle-button"
      class="swap btn-ghost swap-rotate btn"
      tabindex="0"
      aria-label="Enable dark mode"
    >
      <Icon name="ri:sun-fill" class="w-6 h-6 text-light swap-on" aria-hidden="true" />
      <Icon
        name="ri:moon-clear-fill"
        class="w-6 h-6 text-light swap-off"
        aria-hidden="true"
        size="2rem"
      />
    </label>
  </div>
</kw-color-mode-toggle>

<script>
  class KwColorModeToggle extends HTMLElement {
    constructor() {
      super();
      const colorModeToggleButton = document.getElementById('color-mode-toggle-button');
      const currentMode = localStorage.getItem('colorMode');
      if (
        currentMode === 'dark' ||
        (!currentMode && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        colorModeToggleButton?.setAttribute('aria-pressed', 'true');
        colorModeToggleButton?.setAttribute('aria-label', 'Disable dark mode');
        colorModeToggleButton?.classList.add('swap-active');
      }
    }
  }

  customElements.define('kw-color-mode-toggle', KwColorModeToggle);
</script>

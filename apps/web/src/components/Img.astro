---
import { Image } from '@astrojs/image/components';
import { findImage } from '@utils/images';
export interface Props extends astroHTML.JSX.ImgHTMLAttributes {
  alt: string;
  src: string;
  width?: number;
  height?: number;
  format?: 'avif' | 'jpeg' | 'png' | 'webp';
  quality?: number;
  aspectRatio?: number | `${number}:${number}`;
  fit?: 'cover' | 'contain' | 'fill' | 'inside' | 'outside';
  position?:
    | 'top'
    | 'right top'
    | 'right'
    | 'right bottom'
    | 'bottom'
    | 'left bottom'
    | 'left'
    | 'left top'
    | 'north'
    | 'northeast'
    | 'east'
    | 'southeast'
    | 'south'
    | 'southwest'
    | 'west'
    | 'northwest'
    | 'center'
    | 'centre'
    | 'cover'
    | 'entropy'
    | 'attention';
}

const { alt, src, width, height, format, quality, aspectRatio, fit, position, ...attrs } =
  Astro.props;

// ugly hack to circumvent astro issue with dynamic import
// https://github.com/withastro/astro/issues/3373
// const images = import.meta.glob<ImageMetadata>('../images/*.{jpeg,jpg,png}', {
//   import: 'default',
// });
const image = await findImage(src);
---

<Image
  alt={alt}
  src={image.src}
  class={attrs.class}
  width={width}
  height={height}
  format={format}
  quality={quality}
  aspectRatio={aspectRatio}
  fit={fit}
  position={position}
/>

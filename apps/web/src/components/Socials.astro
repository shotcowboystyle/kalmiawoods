---
import { SOCIALS } from "@config";
import { Icon } from 'astro-icon';
import LinkButton from "./LinkButton.astro";
---

<div class="flex mt-4 gap-x-8">
  {
    SOCIALS.map(({ href, icon, linkTitle, name }) => (
      <LinkButton
        href={href}
        className="btn btn-circle bg-white border-white text-black shadow-lg hover:bg-gray-300 hover:border-gray-300"
        title={linkTitle}
      >
        <Icon name={icon} class="w-6 h-6" />
        <span class="sr-only">{name}</span>
      </LinkButton>
    ))
  }
</div>

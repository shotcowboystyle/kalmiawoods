---
import { SOCIALS } from '@/config';
import { Icon } from 'astro-icon/components';
import LinkButton from './LinkButton.astro';
---

<div class="mt-4 flex gap-x-8">
  {
    SOCIALS.map(({ href, icon, linkTitle, name }) => (
      <LinkButton
        href={href}
        className="btn-circle btn border-white bg-white text-black shadow-lg hover:border-gray-300 hover:bg-gray-300"
        title={linkTitle}
      >
        <Icon name={icon} class="h-6 w-6" />
        <span class="sr-only">{name}</span>
      </LinkButton>
    ))
  }
</div>

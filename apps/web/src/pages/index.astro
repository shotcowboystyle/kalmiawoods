---
import LayoutSidebar from '@/app/LayoutSidebar.astro';
import { auth } from '@/auth/lucia';
import Hero from '@/components/Hero.astro';
import NearbyAttractions from '@/components/NearbyAttractions.astro';
import PhotoGallery from '@/components/PhotoGallery.astro';
import Summary from '@/components/Summary.astro';
import Contact from '@/modules/Contact/Contact.astro';

const authRequest = auth.handleRequest(Astro);
const { user } = await authRequest.validateUser();
if (!user) {
  return Astro.redirect('/login', 302);
}
if (!user.emailVerified || user.status !== 'REGISTERED') {
  return Astro.redirect('/complete-registration', 302);
}
---

<LayoutSidebar>
  <Hero />
  <NearbyAttractions />
  <PhotoGallery />
  <Summary />
  <Contact />
</LayoutSidebar>

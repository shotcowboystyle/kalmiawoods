---
import LoginLayout from '@/layouts/LoginLayout.astro';
import Logo from '@components/Logo.astro';
// import { LoginForm } from '@kalmiawoods/ui';

const status = Astro.response.status;
let redirectMessage;
if (status === 301) {
  redirectMessage = 'Your session is finished, please login again';
}
---

<LoginLayout title="Login">
  <section class="flex min-h-screen pb-[12vh] align-middle">
    <div
      class="login pt:mt-0 mx-auto flex w-full flex-col items-center justify-center px-6 pt-8 dark:bg-gray-900"
    >
      <div class="login__inner reveal h-screen">
        <div class="inner__brand">
          <div class="radius-large space-8 bg-neutral-900">
            <Logo />
          </div>
          <div class="brand__text">
            <span>Astro Dashboard</span>
            <span>An Accessible Astro Theme</span>
          </div>
        </div>
        <div class="inner__form space-content">
          <div class="space-content">
            {redirectMessage}
            <h1>Login</h1>
            <!-- <LoginForm client:load /> -->
            <input id="ei" type="email" />
            <input id="pi" type="password" />
            <button onclick="loginHandler()">Login</button>
          </div>
        </div>
        <div class="login__footer text-neutral-700">
          <p><em>Build fast dashboards, faster.</em></p>
        </div>
      </div>
      <div class="login__background h-screen"></div>
    </div>
  </section>
</LoginLayout>

<script is:inline>
  const emailInput = document.querySelector('#ei');
  const passwordInput = document.querySelector('#pi');

  const loginHandler = async () => {
    const response = await fetch('/auth/login', {
      method: 'POST',
      body: JSON.stringify({
        email: emailInput.value,
        password: passwordInput.value,
      }),
    });
    if (response.status == 200) {
      document.location.href = '/';
    }
  };
</script>

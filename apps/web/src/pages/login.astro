---
import LayoutStacked from '@/app/LayoutStacked.astro';
import { auth } from '@/auth/lucia';
// import LoginForm from '@/components/LoginForm.vue';
import { DASHBOARD_HOME } from '@/constants';
import FormLogin from '@/modules/FormLogin.astro';

const authRequest = auth.handleRequest(Astro);

const { session, user } = await authRequest.validateUser();
if (user) {
  if (!user.emailVerified) {
    return Astro.redirect('/auth/email-verification', 302);
  }

  if (session) {
    return Astro.redirect(DASHBOARD_HOME, 302);
  }
}
---

<LayoutStacked title="Login">
  <div class="flex min-h-screen pb-[12vh] align-middle">
    <!-- <LoginForm client:only="vue" /> -->
    <FormLogin />
  </div>


---
// import { ReservationForm, ReservationFormFooter } from '@kalmiawoods/ui';
import { ReservationForm } from '@kalmiawoods/ui';
import '@kalmiawoods/ui/style.css';
import { Icon } from 'astro-icon/components';

import Layout from '@/layouts/Main.astro';

const title = 'Book Now';
---

<Layout title={title}>
  <Fragment slot="navbar">
    <div class="fixed top-0 z-50 mb-2 py-5" id="navbar">
      <div class="container flex w-full items-center space-x-2">
        <a href="/" class="btn-ghost btn" rel="prefetch">
          <Icon name="ri:arrow-left-line" class="h-6 w-6 fill-black text-black" />
        </a>
        <h1 class="text-2xl">{title}</h1>
      </div>
    </div>
  </Fragment>

  <div class="mb-32 mt-24 sm:mt-48">
    <div class="mx-auto max-w-4xl">
      <ReservationForm client:load />
    </div>
  </div>
</Layout>

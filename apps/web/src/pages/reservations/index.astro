---
import LayoutSidebar from '@/app/LayoutSidebar.astro';
import { auth } from '@/auth/lucia';
import FullCalendar from '@/modules/FullCalendar.vue';

const authRequest = auth.handleRequest(Astro);
const { user } = await authRequest.validateUser();
if (!user) {
  return Astro.redirect('/login', 302);
}
if (!user.emailVerified || user.status !== 'REGISTERED') {
  return Astro.redirect('/complete-registration', 302);
}
---

<LayoutSidebar>
  <div class="md:mx-4 md:my-6 md:flex md:items-center md:justify-between md:p-6 xl:p-8">
    <FullCalendar client:only="vue" isAdmin={user?.role === 'ADMIN'} />
  </div>
</LayoutSidebar>

---
import Footer from '@/components/Footer.astro';
import Navbar from '@/components/Navbar.astro';
import { SITE } from '@/config';
import Layout from '@/layouts/Layout.astro';

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}
const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Navbar activeNav="about" />
  <main id="main-content">
    <!-- <section id="about" class="max-w-3xl prose mb-28 prose-img:border-0"> -->
    <section id="about" class="mb-28 max-w-3xl">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      <slot />
    </section>
  </main>
  <Footer />

  <!-- <section class="max-w-4xl px-4 py-16 mx-auto sm:px-6 lg:px-8 lg:py-20">
    <h1 class="text-4xl font-bold tracking-tighter font-heading md:text-5xl leading-tighter">{frontmatter.title}</h1>
    <div
      class="max-w-4xl mx-auto mt-8 prose prose-lg dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg"
    >
      <slot />
    </div>
  </section> -->
</Layout>

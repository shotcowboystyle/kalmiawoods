    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-fastify": "^9.4.3",
    "@nestjs/swagger": "^6.3.0",
    "@nestjs/terminus": "^9.2.2",
    "@nestjs/throttler": "^4.0.0",
    "@ntegral/nestjs-sentry": "^4.0.0",
    "@sentry/hub": "^7.55.0",
    "@sentry/node": "^7.55.0",
    "altair-fastify-plugin": "^5.0.25",
    "argon2": "^0.30.3",

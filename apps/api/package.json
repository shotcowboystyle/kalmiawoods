{
  "name": "@kalmiawoods/api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write . \"**/*.{js,ts,md}\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "dev": "pnpm start:dev",
    "start": "cross-env NODE_ENV=production nest start",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:dev:hmr": "cross-env NODE_ENV=development nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.js"
  },
  "dependencies": {
    "@casl/ability": "^6.5.0",
    "@fastify/compress": "^6.4.0",
    "@fastify/cors": "^8.3.0",
    "@fastify/helmet": "^10.1.1",
    "@fastify/secure-session": "^6.1.0",
    "@fastify/static": "^6.10.2",
    "@kalmiawoods/database": "workspace:*",
    "@liaoliaots/nestjs-redis-health": "^9.0.4",
    "@lukeed/ms": "^2.0.1",
    "@mercuriusjs/gateway": "^2.0.0",
    "@nestjs/cache-manager": "^1.0.0",
    "@nestjs/common": "^9.4.3",

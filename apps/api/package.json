  "devDependencies": {
    "@golevelup/ts-jest": "^0.3.7",
    "@nestjs/cli": "^9.5.0",
    "@nestjs/schematics": "^9.2.0",
    "@nestjs/testing": "^9.4.3",
    "@types/cache-manager": "^4.0.2",
    "@types/jest": "29.5.2",
    "@types/node": "20.3.1",

{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "packages/**",
    "apps/**/public/**",
    "apps/**/astro.config.ts",
    "apps/**/package.json",
    "apps/**/tsconfig.json",
    "**/.env.*local",
    "public/**"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^db:generate", "^build"],
      "outputs": ["dist/**", ".vercel/output/**", ".astro/**"],
      "inputs": ["src/**", "vercel.json"]
    },
    "playwright": {
      "dependsOn": ["^playwright"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^test"]
    },
    "coverage": {
      "dependsOn": ["^coverage"]
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "lint:report": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "dependsOn": ["^db:generate"]
    },
    "db:migrate:deploy": {
      "outputs": []
    },
    "db:push": {
      "outputs": [],
      "cache": false
    },
    "db:seed": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

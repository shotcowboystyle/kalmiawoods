{
	"name": "kalmiawoods",
	"description": "A beautiful mountain vacation rental next to Lake Jocassee and Lake Keowee.",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"clean": "rm -rf .astro dist lighthouse node_modules pnpm-lock.yaml",
		"cz": "git cz",
		"db:deploy": "prisma migrate deploy",
		"db:docs:serve": "pnpm dlx prisma-docs-generator serve",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:dev:create": "prisma migrate dev --create-only",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:resolve": "prisma migrate resolve",
		"db:migrate:status": "prisma migrate status",
		"db:pull": "pnpm dlx prisma db pull",
		"db:push": "prisma db push --skip-generate",
		"db:reset": "prisma migrate reset --skip-seed",
		"db:seed:alt": "tsx prisma/seed.ts",
		"db:seed": "prisma db seed",
		"dev": "astro dev",
		"format:check": "prettier --check '**/*.{tsx,ts,mjs,cjs,js,json,css,yml,yaml,md,astro,vue}'",
		"format:check:js": "prettier --check '**/*.{tsx,ts,mjs,cjs,js,json,css,yml,yaml,md,astro,vue}'",
		"format:fix": "pnpm run format:check -w",
		"format:markdown": "eslint . --quiet --fix --ext md",
		"format:prisma": "prisma format",
		"format:turbo": "turbo run format",
		"format": "prettier --write \"**/*.{ts,tsx,md,mdx,vue,astro,cjs,mjs,js}\"",
		"lint:astro": "prettier --write  \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\" && eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro}\"",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "eslint --ext .js,.cjs,.mjs,.jsx,.ts,.tsx,.astro,.vue --ignore-path '.eslintignore' .",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:package:check": "npmPkgJsonLint .",
		"lint:packages:check": "pnpm dedupe --check",
		"lint:knip:check": "knip --config knip.config.mjs",
		"lint:spelling:check": "cspell lint './**/*.{tsx,ts,mjs,cjs,js,json,css,yml,yaml,md,astro}' --gitignore --cache",
		"lint:styles:check": "stylelint src/**/*.{astro,css} --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"lint:style": "stylelint ./src/**/*.css ./src/**/*.astro --fix",
		"lint": "eslint --ext .js,.cjs,.mjs,.ts,.astro,.vue ./",
		"postinstall": "husky install",
		"prebuild": "pnpm db:generate",
		"predev": "pnpm db:generate",
		"prepare": "husky install",
		"preview": "astro preview",
		"prisma:generate": "prisma generate",
		"prisma:studio": "prisma studio",
		"pwa:generate-assets": "pwa-assets-generator --preset all public/favicon.svg",
		"release": "turbo run build --filter=docs^... && changeset publish",
		"tsc": "tsc",
		"test": "playwright test e2e/tests/",
		"test:e2e": "run-s test:e2e:*",
		"test:e2e:accessibility": "playwright test e2e/tests/accessibility",
		"test:e2e:pages": "playwright test e2e/tests/pages",
		"test:e2e:performance": "playwright test e2e/tests/performance",
		"test:e2e:visual": "playwright test e2e/tests/visual",
		"test:playwright:codegen": "playwright codegen",
		"test:playwright:debug": "playwright test --debug",
		"test:playwright:ui": "playwright test --ui",
		"types:check": "astro sync && tsc --noEmit && astro check",
		"start": "node server/entry.mjs",
		"update:deps": "pnpm update -Li",
		"validate": "run-p format:check lint:check types:check test",
		"vercel-build": "prisma generate && prisma migrate deploy && astro build"
	},
	"devDependencies": {
		"@astrojs/check": "^0.3.1",
		"@astrojs/ts-plugin": "^1.3.1",
		"@astrojs/vercel": "5.2.0",
		"@axe-core/playwright": "^4.8.1",
		"@commitlint/cli": "^18.4.2",
		"@commitlint/config-conventional": "^18.4.2",
		"@ianvs/prettier-plugin-sort-imports": "^4.1.1",
		"@playwright/test": "^1.40.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^11.1.0",
		"@semantic-release/git": "10.0.1",
		"@semantic-release/github": "^9.2.3",
		"@semantic-release/release-notes-generator": "^12.1.0",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@types/eslint": "^8.44.7",
		"@types/leaflet": "^1.9.8",
		"@types/node": "^20.9.2",
		"@typescript-eslint/eslint-plugin": "^6.11.0",
		"@typescript-eslint/parser": "^6.11.0",
		"@vite-pwa/astro": "^0.1.5",
		"@vue/eslint-config-typescript": "^12.0.0",
		"@vue/test-utils": "^2.4.2",
		"@vue/tsconfig": "^0.4.0",
		"astro-compress": "2.2.3",
		"astro-compressor": "^0.4.1",
		"astro-critters": "^2.0.11",
		"astro-dev-only-routes": "^0.0.2",
		"astro-eslint-parser": "^0.16.0",
		"astro-purgecss": "^3.2.1",
		"autoprefixer": "^10.4.16",
		"ci-info": "^4.0.0",
		"commitizen": "^4.3.0",
		"conventional-changelog-conventionalcommits": "^7.0.2",
		"cspell": "^8.0.0",
		"cssnano": "^6.0.1",
		"cz-conventional-changelog": "^3.3.0",
		"daisyui": "^4.4.2",
		"dotenv": "^16.3.1",
		"eslint": "^8.54.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-import-resolver-typescript": "^3.6.1",
		"eslint-plugin-astro": "^0.29.1",
		"eslint-plugin-import": "^2.29.0",
		"eslint-plugin-jsx-a11y": "^6.8.0",
		"eslint-plugin-markdown": "^3.0.1",
		"eslint-plugin-vue": "^9.18.1",
		"husky": "^8.0.3",
		"knip": "^2.41.3",
		"lighthouse": "^11.3.0",
		"lint-staged": "^15.1.0",
		"npm-package-json-lint": "^7.1.0",
		"npm-package-json-lint-config-default": "^6.0.0",
		"npm-run-all2": "^6.1.1",
		"playwright": "^1.40.0",
		"playwright-lighthouse": "^3.1.0",
		"postcss": "^8.4.31",
		"postcss-at-rules-variables": "^0.3.0",
		"postcss-combine-duplicated-selectors": "10.0.3",
		"postcss-combine-media-query": "1.0.1",
		"postcss-for": "^2.1.1",
		"postcss-html": "^1.5.0",
		"postcss-import": "^15.1.0",
		"postcss-nesting": "^12.0.1",
		"postcss-preset-env": "^9.3.0",
		"postcss-random": "^1.0.9",
		"postcss-reporter": "7.0.5",
		"prettier": "^3.1.0",
		"prettier-plugin-astro": "^0.12.2",
		"prettier-plugin-tailwindcss": "^0.5.7",
		"prisma": "5.6.0",
		"purgecss": "^5.0.0",
		"rollup-plugin-analyzer": "^4.0.0",
		"rollup-plugin-visualizer": "^5.9.2",
		"semantic-release": "22.0.8",
		"stylelint": "^15.10.3",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-hudochenkov": "^9.0.0",
		"stylelint-config-standard": "^34.0.0",
		"stylelint-config-tailwindcss": "^0.0.7",
		"tailwindcss": "^3.3.5",
		"tailwindcss-fluid-type": "^2.0.3",
		"turbo": "^1.10.16",
		"typescript": "^5.2.2",
		"unplugin-auto-import": "^0.16.7",
		"unplugin-vue-components": "^0.25.2",
		"vite": "^5.0.0",
		"vite-plugin-pwa": "^0.17.0",
		"vue-eslint-parser": "^9.3.2",
		"workbox-window": "^7.0.0"
	},
	"dependencies": {
		"@astrojs/mdx": "^1.1.5",
		"@astrojs/prefetch": "^0.4.1",
		"@astrojs/tailwind": "^5.0.2",
		"@astrojs/vue": "^3.0.4",
		"@fontsource-variable/dm-sans": "^5.0.3",
		"@fontsource-variable/domine": "^5.0.15",
		"@fontsource-variable/raleway": "^5.0.16",
		"@fontsource/raleway": "^5.0.15",

{
  "name": "kalmiawoods",
  "description": "A beautiful mountain vacation rental next to Lake Jocassee and Lake Keowee.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "clean": "rm -rf .astro dist node_modules pnpm-lock.yaml",
    "dev": "astro dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,vue,astro,cjs,mjs,js,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,vue,astro,cjs,mjs,js,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "test": "playwright test e2e/tests/",
    "test:playwright:ui": "playwright test --ui",
    "types:check": "astro sync && tsc --noEmit && astro check",
    "update:deps": "pnpm update -Li",
    "validate": "run-p format:check lint types:check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/ts-plugin": "^1.10.7",

{
  "name": "kalmiawoods",
  "description": "A beautiful mountain vacation rental next to Lake Jocassee and Lake Keowee.",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.1",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "clean": "rm -rf .astro dist node_modules pnpm-lock.yaml",
    "dev": "astro dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,astro,cjs,mjs,js,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,astro,cjs,mjs,js,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "test": "playwright test e2e/tests/",
    "test:playwright:ui": "playwright test --ui",
    "types:check": "astro sync && tsc --noEmit && astro check",
    "update:deps": "pnpm update -Li",
    "validate": "run-p format:check lint types:check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/ts-plugin": "^1.10.9",
    "@astrojs/vercel": "^10.0.8",
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "astro-compress": "^2.4.1",
    "astro-eslint-parser": "^1.4.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cspell": "^10.0.1",
    "cssnano": "^8.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "daisyui": "^5.5.23",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^6.2.6",
    "playwright": "^1.60.0",
    "postcss": "^8.5.16",
    "postcss-at-rules-variables": "^0.3.0",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-combine-media-query": "^2.1.0",
    "postcss-for": "^2.1.1",
    "postcss-html": "^1.8.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.0",
    "postcss-preset-env": "^11.3.2",
    "postcss-random": "^1.0.9",
    "postcss-reporter": "^7.1.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/domine": "^5.2.8",
    "@fontsource-variable/raleway": "^5.2.8",
    "@fontsource/raleway": "^5.2.8",

{
  "name": "kalmiawoods",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "scripts": {
    "prepare": "husky install",
    "postinstall": "husky install",
    "build": "turbo run build",
    "commit": "git cz",
    "dev": "turbo run dev",
    "dev:nocache": "turbo run dev --no-cache --continue",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,vue,astro,cjs,mjs,js}\"",
    "format:check": "prettier --check  \"**/*.{ts,tsx,md,mdx,vue,astro,cjs,mjs,js}\"",
    "format:markdown": "eslint . --quiet --fix --ext md",
    "format:turbo": "turbo run format",
    "lint": "turbo run lint",
    "lint:report": "turbo run lint:report",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=docs^... && changeset publish",
    "update:deps": "pnpm -r update -Li"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@commitlint/cli": "^17.6.6",
    "@commitlint/config-conventional": "^17.6.6",
    "@kalmiawoods/eslint-config": "workspace:*",
    "@kalmiawoods/prettier-config": "workspace:*",
    "commitizen": "^4.3.0",
    "commitlint": "^17.6.6",
    "cross-env": "^7.0.3",
    "cspell": "^6.31.1",
    "cz-git": "^1.6.1",
    "dotenv-cli": "^7.2.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "tsx": "^3.12.7",
    "turbo": "^1.10.7"
  },
  "engines": {
    "node": ">=16.2.0"
  },
  "packageManager": "pnpm@7.26.3"
}

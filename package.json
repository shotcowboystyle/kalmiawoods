{
  "name": "kalmiawoods",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "scripts": {
    "prepare": "husky install",
    "postinstall": "husky install",
    "build": "turbo run build",
    "commit": "git cz",
    "dev": "turbo run dev --no-cache --continue",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,vue,astro,cjs,mjs,js}\"",
    "format:check": "prettier --check  \"**/*.{ts,tsx,md,mdx,vue,astro,cjs,mjs,js}\"",
    "format:markdown": "eslint . --quiet --fix --ext md",
    "format:turbo": "turbo run format",
    "lint": "turbo run lint",
    "lint:report": "turbo run lint:report",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=docs^... && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.1",
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@kalmiawoods/eslint-config": "workspace:*",
    "@kalmiawoods/prettier-config": "workspace:*",
    "@kalmiawoods/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^5.16.5",
    "@tsconfig/node18": "^1.0.1",
    "commitizen": "^4.3.0",
    "commitlint": "^17.5.1",
    "cspell": "^6.31.1",
    "cz-git": "^1.6.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.7",
    "ts-node-dev": "^2.0.0",
    "tsup": "^6.7.0",
    "turbo": "^1.8.8",
    "vitest": "^0.29.8"
  },
  "engines": {
    "node": ">=16.2.0"
  },
  "packageManager": "pnpm@7.26.3",
  "dependencies": {
    "zod": "^3.21.4"
  }
}

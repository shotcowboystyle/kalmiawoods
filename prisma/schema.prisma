generator client {
  provider      = "prisma-client-js"
  // previewFeatures = ["postgresqlExtensions"]
  // output        = "client"
  binaryTargets = ["native", "linux-musl", "linux-arm64-openssl-1.1.x", "debian-openssl-1.1.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl         = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
  shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING") // used for migrations
}

/// Complete data structure of the User entity for the database and GraphQL.
/// A User represents an account holder.
model AuthUser {
  /// User's unique identifier
  id String @id @unique

  // username       String?

  /// User's email address
  email          String  @unique
  /// User's email address
  email_verified Boolean
  // /// User's password
  // password              String?
  /// User's access role
  role           Role    @default(USER)

  auth_session AuthSession[]
  auth_key     AuthKey[]
  profile      UserProfile?
  reservation  Reservation[]

  // /// Date of User's creation in the database
  // createdAt             DateTime      @default(now()) @map("created_at")
  // /// Date of last update to User's record
  // updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("auth_users")
}

/// Complete data structure of the Profile entity for the database and GraphQL.
/// A Profile represents a User's details.
model UserProfile {
  /// Profile's unique identifier
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Profile's mailing address
  address      String?
  /// Profile's first name
  first_name   String
  /// Profile's last name
  last_name    String
  /// Profile's mobilel phone number
  mobile_phone String  @unique
  /// Profile's picture
  avatar       String?
  // /// Date of Profile's creation in the database
  // createdAt   DateTime @default(now()) @map("created_at")
  // /// Date of last update to Profile's record
  // updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  /// The database identifier of the User associated with this Profile
  user_id   String   @unique
  auth_user AuthUser @relation(fields: [user_id], references: [id])

  @@map("user_profile")
}

model AuthSession {
  id             String   @id @unique
  active_expires BigInt
  idle_expires   BigInt
  user_id        String
  auth_user      AuthUser @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_sessions")
}

model AuthKey {
  id              String   @id @unique
  hashed_password String?
  primary_key     Boolean
  expires         BigInt?
  user_id         String
  auth_user       AuthUser @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_keys")
}

model Email {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject       String
  email_address String
  date_sent     DateTime
  content       String

  @@map("emails")
}

model Reservation {
  /// Reservation's unique identifier
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Start date of Reservation
  check_in_date  DateTime
  /// End date of Reservation
  check_out_date DateTime

  buildings Building[] @default([HOUSE])

  // /// Date of Reservation's creation in the database
  // createdAt   DateTime @default(now()) @map("created_at")
  // /// Date of last update to Reservation's record
  // updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  user_id   String
  auth_user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("reservations")
}

enum Role {
  USER
  ADMIN
}

enum Building {
  HOUSE
  GARAGE
  WORKSHOP
}

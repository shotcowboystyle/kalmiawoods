---
import Layout from '@/app/LayoutLanding.astro';
import BigImage from '@/modules/Discover/BigImage.astro';
import BigText from '@/modules/Discover/BigText.astro';
import Header from '@/modules/Discover/Header.astro';
import MagazineCredit from '@/modules/Discover/MagazineCredit.astro';
import Summary from '@/modules/Discover/Summary.astro';
import SummaryFour from '@/modules/Discover/SummaryFour.astro';
import SummaryPictures from '@/modules/Discover/SummaryPictures.astro';
import SummaryPicturesTwo from '@/modules/Discover/SummaryPicturesTwo.astro';
import SummaryThree from '@/modules/Discover/SummaryThree.astro';
import SummaryTwo from '@/modules/Discover/SummaryTwo.astro';
---

<Layout>
	<Header />

	<div class="o-page__inner">
		<Summary />
		<MagazineCredit />
		<BigImage />
		<SummaryTwo />
		<BigText />
		<SummaryPictures />
		<SummaryThree />
		<SummaryPicturesTwo />
		<SummaryFour />
	</div>
</Layout>

<script>
	import HeaderLoadAnimation from '@/lib/header-load.animation';

	const headerLoadAnimation = new HeaderLoadAnimation();

	function initializeApp() {
		headerLoadAnimation.init();
	}

	// document.addEventListener('astro:before-preparation', () => {
	// 	document.body.classList.add('is-transitioning');
	// 	loaderAnimation.showLoader();
	// });

	// document.addEventListener('astro:after-preparation', () => {
	// 	smoothScroll.kill();
	// 	// headerAnimation.kill();
	// });

	// document.addEventListener('astro:after-swap', () => {
	// 	loaderAnimation.hideLoader();
	// });

	document.addEventListener('astro:page-load', initializeApp);
</script>

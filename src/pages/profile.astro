---
import LayoutSidebar from '@/app/LayoutSidebar.astro';
import UserSettings from '@/modules/Profile/UserSettings.vue';

const { session, user } = await Astro.locals.auth.validateUser();
if (!session) {
  return Astro.redirect("/login", 302);
}

if (!user.emailVerified) {
  return Astro.redirect('/email-verification', 302);
}
---

<LayoutSidebar>
	<UserSettings mode={user.userId} client:only="vue" />
</LayoutSidebar>

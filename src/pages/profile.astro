---
import { HOME } from '@/app/constants';
import Layout from '@/app/LayoutPage.astro';
import SvgSprite from '@/components/SvgSprite.astro';
import UserSettings from '@/modules/Profile/UserSettings.vue';

const { user } = Astro.locals;
---

<Layout>
	<header
		class="bg-profile text-profile-content navbar"
		transition:name="Profile background"
	>
		<div
			class="flex-none"
			transition:name="Profile icon"
		>
			<a
				href={HOME}
				class="btn btn-square btn-ghost"
			>
				<SvgSprite
					name="arrow-left-icon"
					class="stroke-profile h-6 w-6"
				/>
			</a>
		</div>

		<div class="flex-1">
			<span
				class="animate-in m-0 text-xl"
				transition:name="Profile title"
				>Profile</span
			>
		</div>
	</header>

	<div class="px-0 sm:pt-8">
		<UserSettings
			mode={user.userId}
			is-profile
			client:only="vue"
		/>
	</div>
</Layout>

---
import Layout from '@/app/LayoutStacked.astro';
import type { Guidebook } from '@/types/Guidebook';
import { Link } from 'astro-link';
import { getCollection } from 'astro:content';

const guidebookContent = (await getCollection('guidebook'))
	.sort((a, b) => a.data.order - b.data.order)
	.reduce((acc, cur) => {
		const idParts: string[] = cur.id.split('/');
		const categoryId: string = idParts[0];
		const subcategoryId: string = idParts[1];

		let sections = acc;
		if (!sections[categoryId]) {
			sections = {
				...sections,
				[categoryId]: {
					categoryTitle: cur.data.category,
					icon: cur.data.categoryIcon,
					order: cur.data.order,
					subcategories: {
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [cur],
						},
					},
				},
			};
		} else if (!sections[categoryId].subcategories[subcategoryId]) {
			sections = {
				...sections,
				[categoryId]: {
					...sections[categoryId],
					subcategories: {
						...sections[categoryId].subcategories,
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [cur],
						},
					},
				},
			};
		} else {
			sections = {
				...sections,
				[categoryId]: {
					...sections[categoryId],
					subcategories: {
						...sections[categoryId].subcategories,
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [...(sections[categoryId]?.subcategories?.[subcategoryId]?.items ?? []), cur],
						},
					},
				},
			};
		}

		return sections;
	}, {} as Guidebook);
---

<Layout>
	<div slot="sidebar">
		{
			Object.entries(guidebookContent).map(([category, categoryData]) => (
				<div
					tabindex="-1"
					class="collapse collapse-arrow border border-base-300 bg-base-200"
				>
					<input type="checkbox" />
					<div class="collapse-title text-xl font-medium">{category}</div>
					<div class="collapse-content">
						{Object.entries(categoryData.subcategories)
							.sort(([, a], [, b]) => a.order - b.order)
							.map(([subcategory]) => (
								<div>
									<Link href={`guide/${category.toLowerCase()}/${subcategory}`}>{subcategory}</Link>
								</div>
							))}
					</div>
				</div>
			))
		}
	</div>
	<!-- <GuidebookPage guides={guidebookContent} /> -->
</Layout>

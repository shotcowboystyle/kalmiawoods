---
import { HOME } from '@/app/constants';
import Layout from '@/app/LayoutPage.astro';
import SvgSprite from '@/components/SvgSprite.astro';
import AddReservationButton from '@/modules/Reservations/AddReservationButton.astro';
import FullCalendar from '@/modules/Reservations/FullCalendar.vue';
---

<Layout>
	<header
		class="bg-reservations text-reservations-content navbar"
		transition:name="Reservations background"
	>
		<div
			class="flex-none"
			transition:name="Reservations icon"
		>
			<a
				href={HOME}
				class="btn btn-square btn-ghost"
			>
				<SvgSprite
					name="arrow-left"
					class="stroke-reservations h-6 w-6"
				/>
			</a>
		</div>
		<div class="flex-1">
			<span
				class="animate-in m-0 text-xl"
				transition:name="Reservations title"
				>Reservations</span
			>
		</div>
		<div class="flex-none">
			<AddReservationButton />
		</div>
	</header>

	<div class="px-0 sm:mx-auto sm:max-w-7xl sm:pt-8">
		<FullCalendar client:only="vue" />
	</div>
</Layout>

<script>
	document.addEventListener('click', (event) => {
		if (location.pathname === '/') {
			return;
		}

		if ((event?.target as HTMLElement)?.tagName === 'A') {
			document.querySelector('.animate-in')?.classList.add('opacity-0');
		}
	});
</script>

---
import LayoutSidebar from '@/app/LayoutSidebar.astro';
import { checkAuth } from '@/app/check-auth';
import FullCalendar from '@/modules/Reservations/FullCalendar.vue';

const redirect = await checkAuth(Astro);
if (redirect) {
  return Astro.redirect(redirect);
}

const { isAdmin } = Astro.locals.user;
---

<LayoutSidebar>
  <div class="md:mx-4 my-6 md:flex items-center justify-between md:p-6 xl:p-8">
    <FullCalendar client:only="vue" isAdmin={isAdmin} />
  </div>
</LayoutSidebar>

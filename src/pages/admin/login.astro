---
import '../../styles/admin.css';
import FormAlert from '../../components/admin/FormAlert.astro';
import PwaHead from '../../components/admin/PwaHead.astro';
import SubmitButton from '../../components/admin/SubmitButton.astro';
import {
	createSession,
	sessionCookieName,
	sessionCookieOptions,
	validateSession,
	verifyLogin,
} from '../../lib/auth';

export const prerender = false;

let error = '';

const existingToken = Astro.cookies.get(sessionCookieName())?.value;
if (existingToken) {
	const user = await validateSession(existingToken);
	if (user) {
		return Astro.redirect('/admin');
	}
}

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const email = formData.get('email')?.toString() ?? '';
	const password = formData.get('password')?.toString() ?? '';

	const user = await verifyLogin(email, password);
	if (user) {
		const token = await createSession(user.id);
		Astro.cookies.set(sessionCookieName(), token, sessionCookieOptions());
		return Astro.redirect('/admin');
	}
	error = 'Invalid email or password.';
}
---

<html lang="en">
	<head>
		<PwaHead title="Login - KW Admin" />
	</head>
	<body class="bg-base-200 text-base-content font-sans antialiased">
		<div class="app-shell safe-top safe-x safe-bottom items-center justify-center overflow-y-auto">
			<div class="bg-base-100 border-base-300 w-full max-w-md rounded-xl border p-8 shadow-lg">
				<h1 class="text-base-content mb-8 text-center text-3xl font-bold">Admin Login</h1>
				<FormAlert
					tone="error"
					message={error}
				/>
				<form
					method="POST"
					class="flex flex-col gap-4"
					novalidate
				>
					<div>
						<label
							for="email"
							class="text-base-content mb-1 block text-sm font-medium"
							>Email</label
						>
						<input
							id="email"
							type="email"
							name="email"
							autocomplete="email"
							aria-invalid={error ? 'true' : undefined}
							class="input input-bordered bg-base-100 w-full"
							required
						/>
					</div>
					<div>
						<label
							for="password"
							class="text-base-content mb-1 block text-sm font-medium"
						>
							Password
						</label>
						<input
							id="password"
							type="password"
							name="password"
							autocomplete="current-password"
							aria-invalid={error ? 'true' : undefined}
							class="input input-bordered bg-base-100 w-full"
							required
						/>
					</div>
					<SubmitButton
						label="Login"
						labelSubmitting="Signing in…"
						class="mt-2 w-full"
					/>
				</form>
			</div>
		</div>
	</body>
</html>

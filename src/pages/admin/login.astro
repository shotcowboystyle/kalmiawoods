---
import '../../styles/base.css';
import FormAlert from '../../components/admin/FormAlert.astro';
import SubmitButton from '../../components/admin/SubmitButton.astro';
import {
	createSession,
	sessionCookieName,
	sessionCookieOptions,
	validateSession,
	verifyLogin,
} from '../../lib/auth';

export const prerender = false;

let error = '';

const existingToken = Astro.cookies.get(sessionCookieName())?.value;
if (existingToken) {
	const user = await validateSession(existingToken);
	if (user) {
		return Astro.redirect('/admin');
	}
}

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const email = formData.get('email')?.toString() ?? '';
	const password = formData.get('password')?.toString() ?? '';

	const user = await verifyLogin(email, password);
	if (user) {
		const token = await createSession(user.id);
		Astro.cookies.set(sessionCookieName(), token, sessionCookieOptions());
		return Astro.redirect('/admin');
	}
	error = 'Invalid email or password.';
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Admin Login - Kalmia Woods</title>
		<script is:inline>
			document.documentElement.setAttribute('data-theme', 'dark');
			document.documentElement.style.colorScheme = 'dark';
		</script>
	</head>
	<body class="bg-base-200 text-base-content flex items-center justify-center min-h-screen font-sans">
		<div class="bg-base-100 p-8 rounded-xl shadow-lg w-full max-w-md border border-base-300">
			<h1 class="text-3xl font-bold text-center text-base-content mb-8">Admin Login</h1>
			<FormAlert tone="error" message={error} />
			<form method="POST" class="flex flex-col gap-4" novalidate>
				<div>
					<label for="email" class="block text-sm font-medium text-base-content mb-1">Email</label>
					<input
						id="email"
						type="email"
						name="email"
						autocomplete="email"
						aria-invalid={error ? 'true' : undefined}
						class="input input-bordered w-full bg-base-100"
						required
					/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-base-content mb-1">
						Password
					</label>
					<input
						id="password"
						type="password"
						name="password"
						autocomplete="current-password"
						aria-invalid={error ? 'true' : undefined}
						class="input input-bordered w-full bg-base-100"
						required
					/>
				</div>
				<SubmitButton label="Login" labelSubmitting="Signing in…" class="w-full mt-2" />
			</form>
		</div>
	</body>
</html>

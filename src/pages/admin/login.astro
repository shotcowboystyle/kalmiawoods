---
import '../../styles/base.css';
import {
	createSession,
	sessionCookieName,
	sessionCookieOptions,
	validateSession,
	verifyLogin,
} from '../../lib/auth';

export const prerender = false;

let error = '';

// If already logged in, redirect
const existingToken = Astro.cookies.get(sessionCookieName())?.value;
if (existingToken) {
	const user = await validateSession(existingToken);
	if (user) {
		return Astro.redirect('/admin');
	}
}

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const email = formData.get('email')?.toString() ?? '';
	const password = formData.get('password')?.toString() ?? '';

	const user = await verifyLogin(email, password);
	if (user) {
		const token = await createSession(user.id);
		Astro.cookies.set(sessionCookieName(), token, sessionCookieOptions());
		return Astro.redirect('/admin');
	}
	error = 'Invalid email or password.';
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Admin Login - Kalmia Woods</title>
	</head>
	<body class="bg-gray-50 flex items-center justify-center min-h-screen font-sans">
		<div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md border border-gray-100">
			<h1 class="text-3xl font-bold text-center text-gray-800 mb-8">Admin Login</h1>
			<form method="POST" class="flex flex-col gap-4">
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
					<input
						type="email"
						name="email"
						class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
						required
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
					<input
						type="password"
						name="password"
						class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
						required
					/>
				</div>
				<button
					type="submit"
					class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors mt-2 cursor-pointer"
					>Login</button
				>
				{error && <p class="text-red-500 text-sm text-center">{error}</p>}
			</form>
		</div>
	</body>
</html>

---
import AdminLayout from '../../components/AdminLayout.astro';
import { getDb } from '../../lib/db';

export const prerender = false;

const isSuperAdmin = Astro.locals.user?.role === 'super_admin';

const sql = getDb();

type ReservationRow = {
	id: string;
	name: string;
	check_in: string;
	check_out: string;
	property: string;
};

let reservations: ReservationRow[] = [];
let loadError = '';

try {
	reservations = await sql`
		SELECT id, name, check_in, check_out, property
		FROM reservations
		WHERE check_out >= CURRENT_DATE
		ORDER BY check_in ASC
		LIMIT 10
	`;
} catch (e) {
	loadError = e instanceof Error ? e.message : 'Failed to load reservations';
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const propertyLabel = (p: string) => p.replace('_', ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const formatDate = (d: string) =>
	new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const isCurrent = (r: ReservationRow) => {
	const checkIn = new Date(r.check_in);
	const checkOut = new Date(r.check_out);
	checkIn.setHours(0, 0, 0, 0);
	checkOut.setHours(0, 0, 0, 0);
	return checkIn <= today && today <= checkOut;
};
---

<AdminLayout>
	<div class="mb-8">
		<h2 class="text-3xl font-bold text-gray-800">Dashboard</h2>
		<p class="text-gray-600 mt-2">Welcome back. Manage your reservations and users here.</p>
	</div>

	<!-- Current & Upcoming Reservations -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
		<div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
			<h3 class="text-lg font-semibold text-gray-800">Current & Upcoming Reservations</h3>
			<a href="/admin/reservations" class="text-sm text-blue-600 hover:text-blue-800 font-medium"
				>View all →</a
			>
		</div>
		{
			loadError ? (
				<p class="px-6 py-4 text-sm text-red-500">{loadError}</p>
			) : reservations.length === 0 ? (
				<p class="px-6 py-8 text-sm text-gray-500 text-center">
					No current or upcoming reservations.
				</p>
			) : (
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Status
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Name
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Check In
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Check Out
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Property
							</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						{reservations.map((r) => {
							const current = isCurrent(r);
							return (
								<tr class="hover:bg-gray-50 transition-colors">
									<td class="px-6 py-4 whitespace-nowrap">
										<span
											class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${
												current
													? 'bg-green-100 text-green-800'
													: 'bg-blue-100 text-blue-800'
											}`}
										>
											{current ? 'Current' : 'Upcoming'}
										</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
										{r.name}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{formatDate(r.check_in)}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{formatDate(r.check_out)}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{propertyLabel(r.property)}
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			)
		}
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<a
			href="/admin/reservations"
			class="block p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200"
		>
			<h3 class="text-xl font-semibold text-gray-800 mb-2">Reservations</h3>
			<p class="text-gray-600">View, create, and edit property reservations.</p>
		</a>
		{
			isSuperAdmin && (
				<a
					href="/admin/users"
					class="block p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200"
				>
					<h3 class="text-xl font-semibold text-gray-800 mb-2">Admin Users</h3>
					<p class="text-gray-600">Manage administrator access to this system.</p>
				</a>
			)
		}
	</div>
</AdminLayout>

---
import AdminLayout from '../../components/AdminLayout.astro';
import { getDb } from '../../lib/db';

export const prerender = false;

const isSuperAdmin = Astro.locals.user?.role === 'super_admin';

const sql = getDb();

type ReservationRow = {
	id: string;
	name: string;
	check_in: string;
	check_out: string;
	property: string;
};

type ActivityRow = ReservationRow & {
	created_at: string;
	updated_at: string;
	last_change: string;
	was_updated: boolean;
};

type CountRow = { n: number };

type PropertyBreakdownRow = {
	property: string;
	reservation_count: number;
	nights: number;
};

type AdminUserRow = { email: string; role: string; created_at: string };

type SessionRow = {
	created_at: string;
	expires_at: string;
	email: string;
	role: string;
};

let reservations: ReservationRow[] = [];
let loadError = '';

try {
	reservations = await sql`
		SELECT id, name, check_in, check_out, property
		FROM reservations
		WHERE check_out >= CURRENT_DATE
		ORDER BY check_in ASC
		LIMIT 10
	`;
} catch (e) {
	loadError = e instanceof Error ? e.message : 'Failed to load reservations';
}

let checkedInNow = 0;
let checkedInError = '';
try {
	const rows = (await sql`
		SELECT COUNT(*)::int AS n
		FROM reservations
		WHERE check_in <= CURRENT_DATE AND check_out >= CURRENT_DATE
	`) as CountRow[];
	checkedInNow = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	checkedInError = e instanceof Error ? e.message : 'Failed to load';
}

let upcoming30 = 0;
let upcoming30Error = '';
try {
	const rows = (await sql`
		SELECT COUNT(*)::int AS n
		FROM reservations
		WHERE check_in > CURRENT_DATE AND check_in <= CURRENT_DATE + INTERVAL '30 days'
	`) as CountRow[];
	upcoming30 = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	upcoming30Error = e instanceof Error ? e.message : 'Failed to load';
}

let thisYearCount = 0;
let thisYearError = '';
try {
	const rows = (await sql`
		SELECT COUNT(*)::int AS n
		FROM reservations
		WHERE EXTRACT(YEAR FROM check_in) = EXTRACT(YEAR FROM CURRENT_DATE)
	`) as CountRow[];
	thisYearCount = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	thisYearError = e instanceof Error ? e.message : 'Failed to load';
}

let nightsNext30 = 0;
let nightsNext30Error = '';
try {
	const rows = (await sql`
		SELECT COALESCE(SUM(
			GREATEST(0,
				LEAST(check_out, (CURRENT_DATE + INTERVAL '30 days')::date)
				- GREATEST(check_in, CURRENT_DATE)
			)
		), 0)::int AS n
		FROM reservations
		WHERE check_out >= CURRENT_DATE
		  AND check_in <= CURRENT_DATE + INTERVAL '30 days'
	`) as CountRow[];
	nightsNext30 = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	nightsNext30Error = e instanceof Error ? e.message : 'Failed to load';
}

let occupancyRows: ReservationRow[] = [];
let occupancyError = '';
try {
	occupancyRows = (await sql`
		SELECT id, name, property, check_in, check_out
		FROM reservations
		WHERE check_out >= date_trunc('month', CURRENT_DATE)::date
		  AND check_in  <  (date_trunc('month', CURRENT_DATE) + INTERVAL '1 month')::date
		ORDER BY check_in ASC
		LIMIT 200
	`) as ReservationRow[];
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	occupancyError = e instanceof Error ? e.message : 'Failed to load occupancy';
}

let propertyBreakdown: PropertyBreakdownRow[] = [];
let propertyBreakdownError = '';
try {
	propertyBreakdown = (await sql`
		SELECT property,
		       COUNT(*)::int AS reservation_count,
		       COALESCE(SUM(check_out - check_in), 0)::int AS nights
		FROM reservations
		WHERE EXTRACT(YEAR FROM check_in) = EXTRACT(YEAR FROM CURRENT_DATE)
		GROUP BY property
		ORDER BY property
	`) as PropertyBreakdownRow[];
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	propertyBreakdownError = e instanceof Error ? e.message : 'Failed to load breakdown';
}

let recentActivity: ActivityRow[] = [];
let recentActivityError = '';
try {
	recentActivity = (await sql`
		SELECT id, name, property, check_in, check_out, created_at, updated_at,
		       GREATEST(created_at, updated_at) AS last_change,
		       (updated_at > created_at) AS was_updated
		FROM reservations
		ORDER BY GREATEST(created_at, updated_at) DESC
		LIMIT 5
	`) as ActivityRow[];
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	recentActivityError = e instanceof Error ? e.message : 'Failed to load activity';
}

let teamCounts: { role: string; n: number }[] = [];
let recentAdmins: AdminUserRow[] = [];
let teamError = '';
if (isSuperAdmin) {
	try {
		teamCounts = (await sql`
			SELECT role, COUNT(*)::int AS n FROM admin_users GROUP BY role
		`) as { role: string; n: number }[];
		recentAdmins = (await sql`
			SELECT email, role, created_at
			FROM admin_users
			ORDER BY created_at DESC
			LIMIT 3
		`) as AdminUserRow[];
	} catch (e) {
		// Safe to continue: dashboard panel degrades independently; other panels still render
		teamError = e instanceof Error ? e.message : 'Failed to load team';
	}
}

let activeSessionCount = 0;
let recentSessions: SessionRow[] = [];
let sessionError = '';
if (isSuperAdmin) {
	try {
		const rows = (await sql`
			SELECT COUNT(*)::int AS n FROM admin_sessions WHERE expires_at > NOW()
		`) as CountRow[];
		activeSessionCount = rows[0]?.n ?? 0;
		recentSessions = (await sql`
			SELECT s.created_at, s.expires_at, u.email, u.role
			FROM admin_sessions s
			JOIN admin_users u ON u.id = s.user_id
			WHERE s.expires_at > NOW()
			ORDER BY s.created_at DESC
			LIMIT 5
		`) as SessionRow[];
	} catch (e) {
		// Safe to continue: dashboard panel degrades independently; other panels still render
		sessionError = e instanceof Error ? e.message : 'Failed to load sessions';
	}
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const propertyLabel = (p: string) => p.replace('_', ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const formatDate = (d: string) =>
	new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const isCurrent = (r: ReservationRow) => {
	const checkIn = new Date(r.check_in);
	const checkOut = new Date(r.check_out);
	checkIn.setHours(0, 0, 0, 0);
	checkOut.setHours(0, 0, 0, 0);
	return checkIn <= today && today <= checkOut;
};

const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
const relativeTime = (iso: string) => {
	const t = new Date(iso).getTime();
	const diffSec = Math.round((t - Date.now()) / 1000);
	const abs = Math.abs(diffSec);
	if (abs < 60) return rtf.format(diffSec, 'second');
	if (abs < 3600) return rtf.format(Math.round(diffSec / 60), 'minute');
	if (abs < 86400) return rtf.format(Math.round(diffSec / 3600), 'hour');
	if (abs < 2592000) return rtf.format(Math.round(diffSec / 86400), 'day');
	if (abs < 31536000) return rtf.format(Math.round(diffSec / 2592000), 'month');
	return rtf.format(Math.round(diffSec / 31536000), 'year');
};

// Occupancy grid data
const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
const monthEnd = new Date(today.getFullYear(), today.getMonth() + 1, 0);
const daysInMonth = monthEnd.getDate();
const monthLabel = monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const todayDay = today.getDate();

const occupancyProperties: { key: string; label: string }[] = [
	{ key: 'main_house', label: 'Main House' },
	{ key: 'workshop', label: 'Workshop' },
];

function isDayBooked(propertyKey: string, day: number): boolean {
	const dayDate = new Date(today.getFullYear(), today.getMonth(), day);
	dayDate.setHours(0, 0, 0, 0);
	return occupancyRows.some((r) => {
		if (r.property !== propertyKey && r.property !== 'both') return false;
		const ci = new Date(r.check_in);
		const co = new Date(r.check_out);
		ci.setHours(0, 0, 0, 0);
		co.setHours(0, 0, 0, 0);
		return ci <= dayDate && dayDate < co;
	});
}
---

<AdminLayout>
	<div class="mb-8">
		<h2 class="text-3xl font-bold text-gray-800">Dashboard</h2>
		<p class="text-gray-600 mt-2">Welcome back. Manage your reservations and users here.</p>
	</div>

	<!-- Quick Stats -->
	<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
			<p class="text-sm text-gray-500">Currently checked in</p>
			{
				checkedInError ? (
					<p class="text-sm text-red-500 mt-1">{checkedInError}</p>
				) : (
					<p class="text-3xl font-bold text-gray-900 mt-1">{checkedInNow}</p>
				)
			}
		</div>
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
			<p class="text-sm text-gray-500">Upcoming (next 30 days)</p>
			{
				upcoming30Error ? (
					<p class="text-sm text-red-500 mt-1">{upcoming30Error}</p>
				) : (
					<p class="text-3xl font-bold text-gray-900 mt-1">{upcoming30}</p>
				)
			}
		</div>
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
			<p class="text-sm text-gray-500">Reservations this year</p>
			{
				thisYearError ? (
					<p class="text-sm text-red-500 mt-1">{thisYearError}</p>
				) : (
					<p class="text-3xl font-bold text-gray-900 mt-1">{thisYearCount}</p>
				)
			}
		</div>
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
			<p class="text-sm text-gray-500">Nights booked (next 30d)</p>
			{
				nightsNext30Error ? (
					<p class="text-sm text-red-500 mt-1">{nightsNext30Error}</p>
				) : (
					<p class="text-3xl font-bold text-gray-900 mt-1">{nightsNext30}</p>
				)
			}
		</div>
	</div>

	<!-- Current & Upcoming Reservations -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
		<div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
			<h3 class="text-lg font-semibold text-gray-800">Current & Upcoming Reservations</h3>
			<a href="/admin/reservations" class="text-sm text-blue-600 hover:text-blue-800 font-medium"
				>View all →</a
			>
		</div>
		{
			loadError ? (
				<p class="px-6 py-4 text-sm text-red-500">{loadError}</p>
			) : reservations.length === 0 ? (
				<p class="px-6 py-8 text-sm text-gray-500 text-center">
					No current or upcoming reservations.
				</p>
			) : (
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Status
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Name
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Check In
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Check Out
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Property
							</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						{reservations.map((r) => {
							const current = isCurrent(r);
							return (
								<tr class="hover:bg-gray-50 transition-colors">
									<td class="px-6 py-4 whitespace-nowrap">
										<span
											class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${
												current
													? 'bg-green-100 text-green-800'
													: 'bg-blue-100 text-blue-800'
											}`}
										>
											{current ? 'Current' : 'Upcoming'}
										</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
										{r.name}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{formatDate(r.check_in)}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{formatDate(r.check_out)}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{propertyLabel(r.property)}
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			)
		}
	</div>

	<!-- Occupancy + Property Breakdown -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
		<!-- Occupancy This Month -->
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
			<div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
				<h3 class="text-lg font-semibold text-gray-800">Occupancy — {monthLabel}</h3>
			</div>
			<div class="p-6">
				{
					occupancyError ? (
						<p class="text-sm text-red-500">{occupancyError}</p>
					) : (
						<div class="space-y-3">
							{occupancyProperties.map((prop) => (
								<div>
									<p class="text-xs font-medium text-gray-600 mb-1">{prop.label}</p>
									<div class="flex flex-wrap gap-1">
										{Array.from({ length: daysInMonth }, (_, i) => i + 1).map((day) => {
											const booked = isDayBooked(prop.key, day);
											const isToday = day === todayDay;
											return (
												<div
													title={`${prop.label} · Day ${day}${booked ? ' · Booked' : ''}`}
													class={[
														'w-6 h-6 rounded text-[10px] leading-6 text-center',
														booked ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-500',
														isToday ? 'ring-2 ring-blue-600' : '',
													]
														.filter(Boolean)
														.join(' ')}
												>
													{day}
												</div>
											);
										})}
									</div>
								</div>
							))}
							<div class="flex items-center gap-4 pt-2 text-xs text-gray-500">
								<span class="flex items-center gap-1">
									<span class="inline-block w-3 h-3 rounded bg-blue-500" /> Booked
								</span>
								<span class="flex items-center gap-1">
									<span class="inline-block w-3 h-3 rounded bg-gray-100 border border-gray-200" />{' '}
									Free
								</span>
								<span class="flex items-center gap-1">
									<span class="inline-block w-3 h-3 rounded ring-2 ring-blue-600" /> Today
								</span>
							</div>
						</div>
					)
				}
			</div>
		</div>

		<!-- Property Breakdown -->
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
			<div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
				<h3 class="text-lg font-semibold text-gray-800">Property Breakdown (this year)</h3>
			</div>
			{
				propertyBreakdownError ? (
					<p class="px-6 py-4 text-sm text-red-500">{propertyBreakdownError}</p>
				) : propertyBreakdown.length === 0 ? (
					<p class="px-6 py-8 text-sm text-gray-500 text-center">No reservations this year.</p>
				) : (
					<table class="min-w-full divide-y divide-gray-200">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
									Property
								</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
									Reservations
								</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
									Nights
								</th>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							{propertyBreakdown.map((row) => (
								<tr class="hover:bg-gray-50 transition-colors">
									<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
										{propertyLabel(row.property)}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{row.reservation_count}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{row.nights}</td>
								</tr>
							))}
						</tbody>
					</table>
				)
			}
		</div>
	</div>

	<!-- Recent Activity -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
		<div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
			<h3 class="text-lg font-semibold text-gray-800">Recent Activity</h3>
		</div>
		{
			recentActivityError ? (
				<p class="px-6 py-4 text-sm text-red-500">{recentActivityError}</p>
			) : recentActivity.length === 0 ? (
				<p class="px-6 py-8 text-sm text-gray-500 text-center">No activity yet.</p>
			) : (
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Action
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Name
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Property
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								Dates
							</th>
							<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
								When
							</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						{recentActivity.map((row) => (
							<tr class="hover:bg-gray-50 transition-colors">
								<td class="px-6 py-4 whitespace-nowrap">
									<span
										class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${
											row.was_updated
												? 'bg-amber-100 text-amber-800'
												: 'bg-emerald-100 text-emerald-800'
										}`}
									>
										{row.was_updated ? 'Updated' : 'Created'}
									</span>
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
									{row.name}
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
									{propertyLabel(row.property)}
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
									{formatDate(row.check_in)} → {formatDate(row.check_out)}
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
									{relativeTime(row.last_change)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			)
		}
	</div>

	{
		isSuperAdmin && (
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
				<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
					<div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
						<h3 class="text-lg font-semibold text-gray-800">Admin Team</h3>
						<a
							href="/admin/users"
							class="text-sm text-blue-600 hover:text-blue-800 font-medium"
						>
							Manage →
						</a>
					</div>
					<div class="p-6">
						{teamError ? (
							<p class="text-sm text-red-500">{teamError}</p>
						) : (
							<>
								<div class="flex gap-6 mb-4">
									{['super_admin', 'admin'].map((role) => {
										const found = teamCounts.find((t) => t.role === role);
										return (
											<div>
												<p class="text-xs text-gray-500 uppercase tracking-wider">
													{role.replace('_', ' ')}
												</p>
												<p class="text-2xl font-bold text-gray-900">{found?.n ?? 0}</p>
											</div>
										);
									})}
								</div>
								{recentAdmins.length > 0 && (
									<div>
										<p class="text-xs font-medium text-gray-600 mb-2">Recently added</p>
										<ul class="space-y-1">
											{recentAdmins.map((a) => (
												<li class="text-sm text-gray-700 flex justify-between">
													<span>
														{a.email}
														<span class="ml-2 text-xs text-gray-500">
															({a.role.replace('_', ' ')})
														</span>
													</span>
													<span class="text-xs text-gray-500">
														{relativeTime(a.created_at)}
													</span>
												</li>
											))}
										</ul>
									</div>
								)}
							</>
						)}
					</div>
				</div>

				<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
					<div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
						<h3 class="text-lg font-semibold text-gray-800">Active Sessions</h3>
						<span class="text-sm text-gray-500">{activeSessionCount} active</span>
					</div>
					{sessionError ? (
						<p class="px-6 py-4 text-sm text-red-500">{sessionError}</p>
					) : recentSessions.length === 0 ? (
						<p class="px-6 py-8 text-sm text-gray-500 text-center">No active sessions.</p>
					) : (
						<table class="min-w-full divide-y divide-gray-200">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Email
									</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Role
									</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Signed in
									</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
										Expires
									</th>
								</tr>
							</thead>
							<tbody class="bg-white divide-y divide-gray-200">
								{recentSessions.map((s) => (
									<tr class="hover:bg-gray-50 transition-colors">
										<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
											{s.email}
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
											{s.role.replace('_', ' ')}
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
											{relativeTime(s.created_at)}
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
											{relativeTime(s.expires_at)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					)}
				</div>
			</div>
		)
	}

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<a
			href="/admin/reservations"
			class="block p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200"
		>
			<h3 class="text-xl font-semibold text-gray-800 mb-2">Reservations</h3>
			<p class="text-gray-600">View, create, and edit property reservations.</p>
		</a>
		{
			isSuperAdmin && (
				<a
					href="/admin/users"
					class="block p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200"
				>
					<h3 class="text-xl font-semibold text-gray-800 mb-2">Admin Users</h3>
					<p class="text-gray-600">Manage administrator access to this system.</p>
				</a>
			)
		}
	</div>
</AdminLayout>

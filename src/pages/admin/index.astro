---
import Card from '../../components/admin/Card.astro';
import AdminLayout from '../../components/AdminLayout.astro';
import { getDb } from '../../lib/db';
import {
	formatReservationDate,
	formatReservationDateTime,
	propertyLabel,
	toDateInputValue,
} from '../../lib/reservations';

export const prerender = false;

const isSuperAdmin = Astro.locals.user?.role === 'super_admin';

const sql = getDb();

type ReservationRow = {
	id: string;
	name: string;
	check_in: string;
	check_out: string;
	property: string;
};

type ActivityRow = ReservationRow & {
	created_at: string;
	updated_at: string;
	last_change: string;
	was_updated: boolean;
};

type CountRow = { n: number };

type PropertyBreakdownRow = {
	property: string;
	reservation_count: number;
	nights: number;
};

type AdminUserRow = { email: string; role: string; created_at: string };

type SessionRow = {
	created_at: string;
	expires_at: string;
	email: string;
	role: string;
};

const UPCOMING_PAGE_SIZE = 10;
const rawOffset = Number(Astro.url.searchParams.get('upcoming_offset') ?? '0');
const upcomingOffset =
	Number.isFinite(rawOffset) && rawOffset >= 0 ? Math.min(Math.floor(rawOffset), 10000) : 0;

let reservations: ReservationRow[] = [];
let upcomingHasMore = false;
let loadError = '';

try {
	const rows = (await sql`
		SELECT id, name, check_in, check_out, property
		FROM reservations
		WHERE check_out >= now()
		ORDER BY check_in ASC
		LIMIT ${UPCOMING_PAGE_SIZE + 1} OFFSET ${upcomingOffset}
	`) as ReservationRow[];
	upcomingHasMore = rows.length > UPCOMING_PAGE_SIZE;
	reservations = rows.slice(0, UPCOMING_PAGE_SIZE);
} catch (e) {
	loadError = e instanceof Error ? e.message : 'Failed to load reservations';
}

let checkedInNow = 0;
let checkedInError = '';
try {
	const rows = (await sql`
		SELECT COUNT(*)::int AS n
		FROM reservations
		WHERE check_in <= now() AND check_out > now()
	`) as CountRow[];
	checkedInNow = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	checkedInError = e instanceof Error ? e.message : 'Failed to load';
}

let upcoming30 = 0;
let upcoming30Error = '';
try {
	const rows = (await sql`
		SELECT COUNT(*)::int AS n
		FROM reservations
		WHERE check_in > now() AND check_in <= now() + INTERVAL '30 days'
	`) as CountRow[];
	upcoming30 = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	upcoming30Error = e instanceof Error ? e.message : 'Failed to load';
}

let thisYearCount = 0;
let thisYearError = '';
try {
	const rows = (await sql`
		SELECT COUNT(*)::int AS n
		FROM reservations
		WHERE EXTRACT(YEAR FROM check_in) = EXTRACT(YEAR FROM now())
	`) as CountRow[];
	thisYearCount = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	thisYearError = e instanceof Error ? e.message : 'Failed to load';
}

let nightsNext30 = 0;
let nightsNext30Error = '';
try {
	const rows = (await sql`
		SELECT COALESCE(SUM(
			GREATEST(0,
				LEAST(check_out::date, (CURRENT_DATE + INTERVAL '30 days')::date)
				- GREATEST(check_in::date, CURRENT_DATE)
			)
		), 0)::int AS n
		FROM reservations
		WHERE check_out >= now()
		  AND check_in <= now() + INTERVAL '30 days'
	`) as CountRow[];
	nightsNext30 = rows[0]?.n ?? 0;
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	nightsNext30Error = e instanceof Error ? e.message : 'Failed to load';
}

let occupancyRows: ReservationRow[] = [];
let occupancyError = '';
try {
	occupancyRows = (await sql`
		SELECT id, name, property, check_in, check_out
		FROM reservations
		WHERE check_out >= date_trunc('month', CURRENT_DATE)::timestamptz
		  AND check_in  <  (date_trunc('month', CURRENT_DATE) + INTERVAL '1 month')::timestamptz
		ORDER BY check_in ASC
		LIMIT 200
	`) as ReservationRow[];
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	occupancyError = e instanceof Error ? e.message : 'Failed to load occupancy';
}

let propertyBreakdown: PropertyBreakdownRow[] = [];
let propertyBreakdownError = '';
try {
	propertyBreakdown = (await sql`
		SELECT property,
		       COUNT(*)::int AS reservation_count,
		       COALESCE(SUM(check_out::date - check_in::date), 0)::int AS nights
		FROM reservations
		WHERE EXTRACT(YEAR FROM check_in) = EXTRACT(YEAR FROM now())
		GROUP BY property
		ORDER BY property
	`) as PropertyBreakdownRow[];
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	propertyBreakdownError = e instanceof Error ? e.message : 'Failed to load breakdown';
}

let recentActivity: ActivityRow[] = [];
let recentActivityError = '';
try {
	recentActivity = (await sql`
		SELECT id, name, property, check_in, check_out, created_at, updated_at,
		       GREATEST(created_at, updated_at) AS last_change,
		       (updated_at > created_at) AS was_updated
		FROM reservations
		ORDER BY GREATEST(created_at, updated_at) DESC
		LIMIT 5
	`) as ActivityRow[];
} catch (e) {
	// Safe to continue: dashboard panel degrades independently; other panels still render
	recentActivityError = e instanceof Error ? e.message : 'Failed to load activity';
}

let teamCounts: { role: string; n: number }[] = [];
let recentAdmins: AdminUserRow[] = [];
let teamError = '';
if (isSuperAdmin) {
	try {
		teamCounts = (await sql`
			SELECT role, COUNT(*)::int AS n FROM admin_users GROUP BY role
		`) as { role: string; n: number }[];
		recentAdmins = (await sql`
			SELECT email, role, created_at
			FROM admin_users
			ORDER BY created_at DESC
			LIMIT 3
		`) as AdminUserRow[];
	} catch (e) {
		// Safe to continue: dashboard panel degrades independently; other panels still render
		teamError = e instanceof Error ? e.message : 'Failed to load team';
	}
}

let activeSessionCount = 0;
let recentSessions: SessionRow[] = [];
let sessionError = '';
if (isSuperAdmin) {
	try {
		const rows = (await sql`
			SELECT COUNT(*)::int AS n FROM admin_sessions WHERE expires_at > NOW()
		`) as CountRow[];
		activeSessionCount = rows[0]?.n ?? 0;
		recentSessions = (await sql`
			SELECT s.created_at, s.expires_at, u.email, u.role
			FROM admin_sessions s
			JOIN admin_users u ON u.id = s.user_id
			WHERE s.expires_at > NOW()
			ORDER BY s.created_at DESC
			LIMIT 5
		`) as SessionRow[];
	} catch (e) {
		// Safe to continue: dashboard panel degrades independently; other panels still render
		sessionError = e instanceof Error ? e.message : 'Failed to load sessions';
	}
}

const now = new Date();
const isCurrent = (r: ReservationRow) => {
	const checkIn = new Date(r.check_in).getTime();
	const checkOut = new Date(r.check_out).getTime();
	const t = now.getTime();
	return checkIn <= t && t <= checkOut;
};

const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
const relativeTime = (iso: string) => {
	const t = new Date(iso).getTime();
	const diffSec = Math.round((t - Date.now()) / 1000);
	const abs = Math.abs(diffSec);
	if (abs < 60) return rtf.format(diffSec, 'second');
	if (abs < 3600) return rtf.format(Math.round(diffSec / 60), 'minute');
	if (abs < 86400) return rtf.format(Math.round(diffSec / 3600), 'hour');
	if (abs < 2592000) return rtf.format(Math.round(diffSec / 86400), 'day');
	if (abs < 31536000) return rtf.format(Math.round(diffSec / 2592000), 'month');
	return rtf.format(Math.round(diffSec / 31536000), 'year');
};

// Occupancy grid data (computed in America/New_York wall-clock)
const nowInET = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/New_York' }));
const monthStart = new Date(nowInET.getFullYear(), nowInET.getMonth(), 1);
const monthEnd = new Date(nowInET.getFullYear(), nowInET.getMonth() + 1, 0);
const daysInMonth = monthEnd.getDate();
const monthLabel = monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const todayDay = nowInET.getDate();
const monthYear = nowInET.getFullYear();
const monthNumber = nowInET.getMonth();

const occupancyProperties: { key: string; label: string }[] = [
	{ key: 'main_house', label: 'Main House' },
	{ key: 'workshop', label: 'Workshop' },
];

function ymd(y: number, mIdx: number, d: number): string {
	return `${y}-${String(mIdx + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
}

function isDayBooked(propertyKey: string, day: number): boolean {
	const dayStr = ymd(monthYear, monthNumber, day);
	return occupancyRows.some((r) => {
		if (r.property !== propertyKey && r.property !== 'both') return false;
		const ciStr = toDateInputValue(r.check_in);
		const coStr = toDateInputValue(r.check_out);
		return ciStr <= dayStr && dayStr < coStr;
	});
}

const buildUpcomingLink = (offset: number) => {
	const url = new URL(Astro.url.pathname, Astro.url.origin);
	if (offset > 0) url.searchParams.set('upcoming_offset', String(offset));
	return url.pathname + (url.search ? url.search : '');
};
---

<AdminLayout>
	<div class="mb-8">
		<h2 class="text-base-content text-3xl font-bold">Dashboard</h2>
		<p class="text-base-content/70 mt-2">Welcome back. Manage your reservations and users here.</p>
	</div>

	<!-- Quick Stats -->
	<div class="mb-6 grid grid-cols-2 gap-4 md:grid-cols-4">
		<Card>
			<p class="text-base-content/60 text-sm">Currently checked in</p>
			{
				checkedInError ? (
					<p class="text-error mt-1 text-sm">{checkedInError}</p>
				) : (
					<p class="text-base-content mt-1 text-3xl font-bold">{checkedInNow}</p>
				)
			}
		</Card>
		<Card>
			<p class="text-base-content/60 text-sm">Upcoming (next 30 days)</p>
			{
				upcoming30Error ? (
					<p class="text-error mt-1 text-sm">{upcoming30Error}</p>
				) : (
					<p class="text-base-content mt-1 text-3xl font-bold">{upcoming30}</p>
				)
			}
		</Card>
		<Card>
			<p class="text-base-content/60 text-sm">Reservations this year</p>
			{
				thisYearError ? (
					<p class="text-error mt-1 text-sm">{thisYearError}</p>
				) : (
					<p class="text-base-content mt-1 text-3xl font-bold">{thisYearCount}</p>
				)
			}
		</Card>
		<Card>
			<p class="text-base-content/60 text-sm">Nights booked (next 30d)</p>
			{
				nightsNext30Error ? (
					<p class="text-error mt-1 text-sm">{nightsNext30Error}</p>
				) : (
					<p class="text-base-content mt-1 text-3xl font-bold">{nightsNext30}</p>
				)
			}
		</Card>
	</div>

	<!-- Current & Upcoming Reservations -->
	<Card
		padding={false}
		class="mb-6 overflow-hidden"
	>
		<div
			class="border-base-300 flex flex-wrap items-center justify-between gap-2 border-b px-6 py-4"
		>
			<h3 class="text-base-content text-lg font-semibold">Current & Upcoming Reservations</h3>
			<a
				href="/admin/reservations"
				class="text-primary hover:text-primary/80 text-sm font-medium"
				>View all →</a
			>
		</div>
		{
			loadError ? (
				<p class="text-error px-6 py-4 text-sm">{loadError}</p>
			) : reservations.length === 0 ? (
				<p class="text-base-content/60 px-6 py-8 text-center text-sm">
					{upcomingOffset === 0
						? 'No current or upcoming reservations.'
						: 'No more upcoming reservations.'}
				</p>
			) : (
				<table
					class="stacked-table divide-base-300 min-w-full divide-y"
					role="table"
				>
					<thead class="bg-base-200">
						<tr role="row">
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Status
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Name
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Check In
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Check Out
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Property
							</th>
						</tr>
					</thead>
					<tbody class="divide-base-300 divide-y">
						{reservations.map((r) => {
							const current = isCurrent(r);
							return (
								<tr
									class="hover:bg-base-200 transition-colors"
									role="row"
								>
									<td
										role="cell"
										data-label="Status"
										class="px-6 py-4 whitespace-nowrap"
									>
										<span class:list={['badge badge-sm', current ? 'badge-success' : 'badge-info']}>
											{current ? 'Current' : 'Upcoming'}
										</span>
									</td>
									<td
										role="cell"
										data-label="Name"
										class="text-base-content selectable px-6 py-4 text-sm font-medium whitespace-nowrap"
									>
										{r.name}
									</td>
									<td
										role="cell"
										data-label="Check in"
										class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
									>
										{formatReservationDateTime(r.check_in)}
									</td>
									<td
										role="cell"
										data-label="Check out"
										class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
									>
										{formatReservationDateTime(r.check_out)}
									</td>
									<td
										role="cell"
										data-label="Property"
										class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
									>
										{propertyLabel(r.property)}
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			)
		}
		{
			(upcomingOffset > 0 || upcomingHasMore) && (
				<div class="border-base-300 flex items-center justify-between border-t px-6 py-3 text-sm">
					<span class="text-base-content/60">
						Showing {upcomingOffset + 1}
						{reservations.length > 0 ? `–${upcomingOffset + reservations.length}` : ''}
					</span>
					<div class="flex gap-2">
						{upcomingOffset > 0 ? (
							<a
								href={buildUpcomingLink(Math.max(0, upcomingOffset - UPCOMING_PAGE_SIZE))}
								class="btn btn-ghost btn-sm"
							>
								← Previous
							</a>
						) : (
							<span class="btn btn-ghost btn-sm btn-disabled">← Previous</span>
						)}
						{upcomingHasMore ? (
							<a
								href={buildUpcomingLink(upcomingOffset + UPCOMING_PAGE_SIZE)}
								class="btn btn-ghost btn-sm"
							>
								Next →
							</a>
						) : (
							<span class="btn btn-ghost btn-sm btn-disabled">Next →</span>
						)}
					</div>
				</div>
			)
		}
	</Card>

	<!-- Occupancy + Property Breakdown -->
	<div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
		<Card
			padding={false}
			class="overflow-hidden"
		>
			<div
				class="border-base-300 flex flex-wrap items-center justify-between gap-2 border-b px-6 py-4"
			>
				<h3 class="text-base-content text-lg font-semibold">Occupancy — {monthLabel}</h3>
			</div>
			<div class="p-6">
				{
					occupancyError ? (
						<p class="text-error text-sm">{occupancyError}</p>
					) : (
						<div class="space-y-3">
							{occupancyProperties.map((prop) => (
								<div>
									<p class="text-base-content/70 mb-1 text-xs font-medium">{prop.label}</p>
									<div class="flex flex-wrap gap-1">
										{Array.from({ length: daysInMonth }, (_, i) => i + 1).map((day) => {
											const booked = isDayBooked(prop.key, day);
											const isToday = day === todayDay;
											return (
												<div
													title={`${prop.label} · Day ${day}${booked ? ' · Booked' : ''}`}
													class:list={[
														'h-6 w-6 rounded text-center text-[10px] leading-6',
														booked
															? 'bg-primary text-primary-content'
															: 'bg-base-200 text-base-content/60',
														isToday && 'ring-primary ring-2',
													]}
												>
													{day}
												</div>
											);
										})}
									</div>
								</div>
							))}
							<div class="text-base-content/60 flex items-center gap-4 pt-2 text-xs">
								<span class="flex items-center gap-1">
									<span class="bg-primary inline-block h-3 w-3 rounded" /> Booked
								</span>
								<span class="flex items-center gap-1">
									<span class="bg-base-200 border-base-300 inline-block h-3 w-3 rounded border" />
									Free
								</span>
								<span class="flex items-center gap-1">
									<span class="ring-primary inline-block h-3 w-3 rounded ring-2" /> Today
								</span>
							</div>
						</div>
					)
				}
			</div>
		</Card>

		<Card
			padding={false}
			class="overflow-hidden"
		>
			<div
				class="border-base-300 flex flex-wrap items-center justify-between gap-2 border-b px-6 py-4"
			>
				<h3 class="text-base-content text-lg font-semibold">Property Breakdown (this year)</h3>
			</div>
			{
				propertyBreakdownError ? (
					<p class="text-error px-6 py-4 text-sm">{propertyBreakdownError}</p>
				) : propertyBreakdown.length === 0 ? (
					<p class="text-base-content/60 px-6 py-8 text-center text-sm">
						No reservations this year.
					</p>
				) : (
					<table
						class="stacked-table divide-base-300 min-w-full divide-y"
						role="table"
					>
						<thead class="bg-base-200">
							<tr role="row">
								<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
									Property
								</th>
								<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
									Reservations
								</th>
								<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
									Nights
								</th>
							</tr>
						</thead>
						<tbody class="divide-base-300 divide-y">
							{propertyBreakdown.map((row) => (
								<tr
									class="hover:bg-base-200 transition-colors"
									role="row"
								>
									<td
										role="cell"
										data-label="Property"
										class="text-base-content px-6 py-4 text-sm font-medium whitespace-nowrap"
									>
										{propertyLabel(row.property)}
									</td>
									<td
										role="cell"
										data-label="Reservations"
										class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
									>
										{row.reservation_count}
									</td>
									<td
										role="cell"
										data-label="Nights"
										class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
									>
										{row.nights}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				)
			}
		</Card>
	</div>

	<!-- Recent Activity -->
	<Card
		padding={false}
		class="mb-6 overflow-hidden"
	>
		<div
			class="border-base-300 flex flex-wrap items-center justify-between gap-2 border-b px-6 py-4"
		>
			<h3 class="text-base-content text-lg font-semibold">Recent Activity</h3>
		</div>
		{
			recentActivityError ? (
				<p class="text-error px-6 py-4 text-sm">{recentActivityError}</p>
			) : recentActivity.length === 0 ? (
				<p class="text-base-content/60 px-6 py-8 text-center text-sm">No activity yet.</p>
			) : (
				<table
					class="stacked-table divide-base-300 min-w-full divide-y"
					role="table"
				>
					<thead class="bg-base-200">
						<tr role="row">
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Action
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Name
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Property
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								Dates
							</th>
							<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
								When
							</th>
						</tr>
					</thead>
					<tbody class="divide-base-300 divide-y">
						{recentActivity.map((row) => (
							<tr
								class="hover:bg-base-200 transition-colors"
								role="row"
							>
								<td
									role="cell"
									data-label="Action"
									class="px-6 py-4 whitespace-nowrap"
								>
									<span
										class:list={[
											'badge badge-sm',
											row.was_updated ? 'badge-warning' : 'badge-success',
										]}
									>
										{row.was_updated ? 'Updated' : 'Created'}
									</span>
								</td>
								<td
									role="cell"
									data-label="Name"
									class="text-base-content selectable px-6 py-4 text-sm font-medium whitespace-nowrap"
								>
									{row.name}
								</td>
								<td
									role="cell"
									data-label="Property"
									class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
								>
									{propertyLabel(row.property)}
								</td>
								<td
									role="cell"
									data-label="Dates"
									class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
								>
									{formatReservationDate(row.check_in)} → {formatReservationDate(row.check_out)}
								</td>
								<td
									role="cell"
									data-label="When"
									class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
								>
									{relativeTime(row.last_change)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			)
		}
	</Card>

	{
		isSuperAdmin && (
			<div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
				<Card
					padding={false}
					class="overflow-hidden"
				>
					<div class="border-base-300 flex flex-wrap items-center justify-between gap-2 border-b px-6 py-4">
						<h3 class="text-base-content text-lg font-semibold">Admin Team</h3>
						<a
							href="/admin/users"
							class="text-primary hover:text-primary/80 text-sm font-medium"
						>
							Manage →
						</a>
					</div>
					<div class="p-6">
						{teamError ? (
							<p class="text-error text-sm">{teamError}</p>
						) : (
							<>
								<div class="mb-4 flex gap-6">
									{['super_admin', 'admin'].map((role) => {
										const found = teamCounts.find((t) => t.role === role);
										return (
											<div>
												<p class="text-base-content/60 text-xs tracking-wider uppercase">
													{role.replace('_', ' ')}
												</p>
												<p class="text-base-content text-2xl font-bold">{found?.n ?? 0}</p>
											</div>
										);
									})}
								</div>
								{recentAdmins.length > 0 && (
									<div>
										<p class="text-base-content/70 mb-2 text-xs font-medium">Recently added</p>
										<ul class="space-y-1">
											{recentAdmins.map((a) => (
												<li class="text-base-content/80 flex justify-between text-sm">
													<span>
														{a.email}
														<span class="text-base-content/60 ml-2 text-xs">
															({a.role.replace('_', ' ')})
														</span>
													</span>
													<span class="text-base-content/60 text-xs">
														{relativeTime(a.created_at)}
													</span>
												</li>
											))}
										</ul>
									</div>
								)}
							</>
						)}
					</div>
				</Card>

				<Card
					padding={false}
					class="overflow-hidden"
				>
					<div class="border-base-300 flex flex-wrap items-center justify-between gap-2 border-b px-6 py-4">
						<h3 class="text-base-content text-lg font-semibold">Active Sessions</h3>
						<span class="text-base-content/60 text-sm">{activeSessionCount} active</span>
					</div>
					{sessionError ? (
						<p class="text-error px-6 py-4 text-sm">{sessionError}</p>
					) : recentSessions.length === 0 ? (
						<p class="text-base-content/60 px-6 py-8 text-center text-sm">No active sessions.</p>
					) : (
						<table
							class="stacked-table divide-base-300 min-w-full divide-y"
							role="table"
						>
							<thead class="bg-base-200">
								<tr role="row">
									<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
										Email
									</th>
									<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
										Role
									</th>
									<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
										Signed in
									</th>
									<th class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase">
										Expires
									</th>
								</tr>
							</thead>
							<tbody class="divide-base-300 divide-y">
								{recentSessions.map((s) => (
									<tr
										class="hover:bg-base-200 transition-colors"
										role="row"
									>
										<td
											role="cell"
											data-label="Email"
											class="text-base-content selectable px-6 py-4 text-sm font-medium break-all"
										>
											{s.email}
										</td>
										<td
											role="cell"
											data-label="Role"
											class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
										>
											{s.role.replace('_', ' ')}
										</td>
										<td
											role="cell"
											data-label="Signed in"
											class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
										>
											{relativeTime(s.created_at)}
										</td>
										<td
											role="cell"
											data-label="Expires"
											class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
										>
											{relativeTime(s.expires_at)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					)}
				</Card>
			</div>
		)
	}

	<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
		<a
			href="/admin/reservations"
			class="bg-base-100 border-base-300 block rounded-xl border p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
		>
			<h3 class="text-base-content mb-2 text-xl font-semibold">Reservations</h3>
			<p class="text-base-content/70">View, create, and edit property reservations.</p>
		</a>
		{
			isSuperAdmin && (
				<a
					href="/admin/users"
					class="bg-base-100 border-base-300 block rounded-xl border p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
				>
					<h3 class="text-base-content mb-2 text-xl font-semibold">Admin Users</h3>
					<p class="text-base-content/70">Manage administrator access to this system.</p>
				</a>
			)
		}
	</div>
</AdminLayout>

---
import AdminLayout from '../../components/AdminLayout.astro';
import Card from '../../components/admin/Card.astro';
import FormAlert from '../../components/admin/FormAlert.astro';
import SubmitButton from '../../components/admin/SubmitButton.astro';
import {
	deleteOtherSessions,
	sessionCookieName,
	updateUserEmail,
	updateUserPassword,
	verifyUserPassword,
} from '../../lib/auth';
import { getDb } from '../../lib/db';
import { PASSWORD_MIN_LENGTH, PASSWORD_RULES, validatePassword } from '../../lib/password-policy';

export const prerender = false;

const user = Astro.locals.user!;
const forced = Astro.url.searchParams.get('force') === '1' || user.mustChangePassword;

let emailError = '';
let emailSuccess = '';
let passwordError = '';
let passwordSuccess = '';

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const action = formData.get('action')?.toString();

	if (action === 'change_email') {
		if (user.mustChangePassword) {
			emailError = 'You must change your password before changing your email.';
		} else {
			const newEmail = formData.get('email')?.toString().trim() ?? '';
			const currentPassword = formData.get('current_password')?.toString() ?? '';

			if (!newEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) {
				emailError = 'Please enter a valid email address.';
			} else if (!currentPassword) {
				emailError = 'Please enter your current password to confirm.';
			} else if (!(await verifyUserPassword(user.id, currentPassword))) {
				emailError = 'Current password is incorrect.';
			} else if (newEmail === user.email) {
				emailError = 'That is already your email.';
			} else {
				try {
					await updateUserEmail(user.id, newEmail);
					return Astro.redirect('/admin/account?updated=email');
				} catch (e) {
					const msg = e instanceof Error ? e.message : 'Failed to update email';
					if (msg.includes('unique') || msg.includes('duplicate')) {
						emailError = 'Another admin already uses that email.';
					} else {
						emailError = msg;
						throw e;
					}
				}
			}
		}
	} else if (action === 'change_password') {
		const currentPassword = formData.get('current_password')?.toString() ?? '';
		const newPassword = formData.get('new_password')?.toString() ?? '';
		const confirmPassword = formData.get('confirm_password')?.toString() ?? '';

		if (!currentPassword) {
			passwordError = 'Please enter your current password.';
		} else if (!(await verifyUserPassword(user.id, currentPassword))) {
			passwordError = 'Current password is incorrect.';
		} else if (newPassword !== confirmPassword) {
			passwordError = 'New passwords do not match.';
		} else if (newPassword === currentPassword) {
			passwordError = 'New password must be different from the current password.';
		} else {
			const validation = validatePassword(newPassword, user.email);
			if (!validation.valid) {
				passwordError = validation.errors.join(' ');
			} else {
				await updateUserPassword(user.id, newPassword, { clearMustChange: true });
				const token = Astro.cookies.get(sessionCookieName())?.value;
				if (token) {
					await deleteOtherSessions(user.id, token);
				}
				return Astro.redirect('/admin/account?updated=password');
			}
		}
	}
}

const updated = Astro.url.searchParams.get('updated');
if (updated === 'email') emailSuccess = 'Email updated.';
if (updated === 'password') passwordSuccess = 'Password updated. Other sessions have been signed out.';

const sql = getDb();
const rows = await sql`
	SELECT email, role, created_at FROM admin_users WHERE id = ${user.id} LIMIT 1
`;
const account = rows[0];
---

<AdminLayout>
	<div class="max-w-2xl">
		<h2 class="text-3xl font-bold text-base-content">Account</h2>
		<p class="text-base-content/70 mt-2">Manage your admin email and password.</p>

		{
			forced && (
				<div class="mt-6 rounded-lg border border-warning/40 bg-warning/10 p-4 text-warning">
					<p class="font-semibold">Password change required</p>
					<p class="text-sm mt-1">
						For security, you must set a new password before you can continue using the admin
						panel.
					</p>
				</div>
			)
		}

		<Card class="mt-8">
			<h3 class="text-lg font-semibold text-base-content mb-4">Profile</h3>
			<dl class="grid grid-cols-3 gap-y-2 text-sm">
				<dt class="text-base-content/60">Email</dt>
				<dd class="col-span-2 text-base-content">{account?.email ?? user.email}</dd>
				<dt class="text-base-content/60">Role</dt>
				<dd class="col-span-2 text-base-content capitalize">
					{(account?.role ?? user.role).replace('_', ' ')}
				</dd>
				<dt class="text-base-content/60">Created</dt>
				<dd class="col-span-2 text-base-content">
					{account?.created_at ? new Date(account.created_at).toLocaleString() : '—'}
				</dd>
			</dl>
		</Card>

		<Card class="mt-8">
			<h3 class="text-lg font-semibold text-base-content mb-4">Change password</h3>
			<FormAlert tone="error" message={passwordError} />
			<FormAlert tone="success" message={passwordSuccess} />

			<form method="POST" class="flex flex-col gap-4" id="password-form" novalidate>
				<input type="hidden" name="action" value="change_password" />
				<div>
					<label for="current-password" class="block text-sm font-medium text-base-content mb-1">
						Current password
					</label>
					<input
						id="current-password"
						type="password"
						name="current_password"
						autocomplete="current-password"
						class="input input-bordered w-full bg-base-100"
						required
					/>
				</div>
				<div>
					<label for="new-password" class="block text-sm font-medium text-base-content mb-1">
						New password
					</label>
					<input
						id="new-password"
						type="password"
						name="new_password"
						autocomplete="new-password"
						minlength={PASSWORD_MIN_LENGTH}
						class="input input-bordered w-full bg-base-100"
						required
					/>

					<div class="mt-3" data-strength-meter aria-live="polite">
						<div class="flex gap-1">
							<span class="strength-bar h-1.5 flex-1 rounded bg-base-300"></span>
							<span class="strength-bar h-1.5 flex-1 rounded bg-base-300"></span>
							<span class="strength-bar h-1.5 flex-1 rounded bg-base-300"></span>
							<span class="strength-bar h-1.5 flex-1 rounded bg-base-300"></span>
						</div>
						<p class="text-xs mt-2 text-base-content/70">
							Strength: <span class="font-semibold" data-strength-label>—</span>
						</p>
						<ul
							class="mt-3 text-xs text-base-content/70 space-y-1"
							data-strength-rules
							data-rules={JSON.stringify(PASSWORD_RULES)}
						>
							{
								PASSWORD_RULES.map((rule, i) => (
									<li class="flex items-center gap-2" data-rule-index={i}>
										<span
											class="inline-flex w-4 h-4 items-center justify-center rounded-full bg-base-300 text-base-content/60 text-[10px] leading-none"
											data-rule-icon
										>
											·
										</span>
										<span>{rule}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
				<div>
					<label for="confirm-password" class="block text-sm font-medium text-base-content mb-1">
						Confirm new password
					</label>
					<input
						id="confirm-password"
						type="password"
						name="confirm_password"
						autocomplete="new-password"
						minlength={PASSWORD_MIN_LENGTH}
						class="input input-bordered w-full bg-base-100"
						required
					/>
					<p class="text-xs mt-2 text-error hidden" data-confirm-error>
						Passwords do not match.
					</p>
				</div>
				<SubmitButton label="Update password" labelSubmitting="Updating…" class="self-start" disabled />
			</form>
		</Card>

		<Card
			class:list={['mt-8', user.mustChangePassword && 'opacity-60 pointer-events-none']}
		>
			<h3 class="text-lg font-semibold text-base-content mb-4">Change email</h3>
			{user.mustChangePassword && (
				<p class="text-xs text-base-content/60 mb-3">
					Available once you have changed your password.
				</p>
			)}
			<FormAlert tone="error" message={emailError} />
			<FormAlert tone="success" message={emailSuccess} />
			<form method="POST" class="flex flex-col gap-4" novalidate>
				<input type="hidden" name="action" value="change_email" />
				<div>
					<label for="new-email" class="block text-sm font-medium text-base-content mb-1">
						New email
					</label>
					<input
						id="new-email"
						type="email"
						name="email"
						value={account?.email ?? user.email}
						autocomplete="email"
						class="input input-bordered w-full bg-base-100"
						required
					/>
				</div>
				<div>
					<label for="email-current-password" class="block text-sm font-medium text-base-content mb-1">
						Current password
					</label>
					<input
						id="email-current-password"
						type="password"
						name="current_password"
						autocomplete="current-password"
						class="input input-bordered w-full bg-base-100"
						required
					/>
				</div>
				<SubmitButton label="Update email" labelSubmitting="Updating…" class="self-start" />
			</form>
		</Card>
	</div>
</AdminLayout>

<script>
	import { validatePassword } from '../../lib/password-policy';

	const form = document.getElementById('password-form') as HTMLFormElement | null;
	if (form) {
		const newPw = form.querySelector<HTMLInputElement>('#new-password')!;
		const confirmPw = form.querySelector<HTMLInputElement>('#confirm-password')!;
		const submit = form.querySelector<HTMLButtonElement>('[data-submit-once]')!;
		const meter = form.querySelector<HTMLElement>('[data-strength-meter]')!;
		const bars = meter.querySelectorAll<HTMLElement>('.strength-bar');
		const label = meter.querySelector<HTMLElement>('[data-strength-label]')!;
		const rulesList = meter.querySelector<HTMLElement>('[data-strength-rules]')!;
		const confirmError = form.querySelector<HTMLElement>('[data-confirm-error]')!;

		const barColors = ['bg-error', 'bg-warning', 'bg-warning', 'bg-info', 'bg-success'];

		function checkRule(index: number, password: string): boolean {
			switch (index) {
				case 0:
					return password.length >= 12;
				case 1:
					return /[A-Z]/.test(password);
				case 2:
					return /[a-z]/.test(password);
				case 3:
					return /\d/.test(password);
				case 4:
					return /[^A-Za-z0-9]/.test(password);
				case 5: {
					const v = validatePassword(password);
					return !v.errors.some((e) => e.toLowerCase().includes('common'));
				}
				default:
					return false;
			}
		}

		function update(): void {
			const pw = newPw.value;
			const result = validatePassword(pw);

			bars.forEach((bar, i) => {
				bar.classList.remove(...barColors, 'bg-base-300');
				if (pw.length === 0) {
					bar.classList.add('bg-base-300');
				} else if (i <= result.score) {
					bar.classList.add(barColors[result.score]);
				} else {
					bar.classList.add('bg-base-300');
				}
			});

			label.textContent = pw.length === 0 ? '—' : result.label;

			rulesList.querySelectorAll<HTMLElement>('[data-rule-index]').forEach((li) => {
				const idx = Number(li.getAttribute('data-rule-index'));
				const passed = pw.length > 0 && checkRule(idx, pw);
				const icon = li.querySelector<HTMLElement>('[data-rule-icon]')!;
				icon.textContent = passed ? '✓' : '·';
				icon.classList.toggle('bg-success/20', passed);
				icon.classList.toggle('text-success', passed);
				icon.classList.toggle('bg-base-300', !passed);
				icon.classList.toggle('text-base-content/60', !passed);
			});

			const matches = confirmPw.value.length === 0 || confirmPw.value === pw;
			confirmError.classList.toggle('hidden', matches);

			submit.disabled = !result.valid || !matches || confirmPw.value.length === 0;
		}

		newPw.addEventListener('input', update);
		confirmPw.addEventListener('input', update);
		update();
	}
</script>

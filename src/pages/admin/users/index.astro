---
import AdminLayout from '../../../components/AdminLayout.astro';
import { hashPassword } from '../../../lib/auth';
import { getDb } from '../../../lib/db';
import { PASSWORD_MIN_LENGTH, validatePassword } from '../../../lib/password-policy';

export const prerender = false;

const sql = getDb();
let error = '';
let success = '';

const currentUserId = Astro.locals.user?.id;

async function countSuperAdmins(): Promise<number> {
	const rows = await sql`SELECT COUNT(*)::int AS n FROM admin_users WHERE role = 'super_admin'`;
	return rows[0]?.n ?? 0;
}

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const action = formData.get('action')?.toString();

	if (action === 'add') {
		const email = formData.get('email')?.toString() ?? '';
		const password = formData.get('password')?.toString() ?? '';
		const role = formData.get('role')?.toString() === 'super_admin' ? 'super_admin' : 'admin';

		const validation = validatePassword(password, email);
		if (!email || !password) {
			error = 'Email and password are required.';
		} else if (!validation.valid) {
			error = validation.errors.join(' ');
		} else {
			try {
				const { hash, salt } = await hashPassword(password);
				await sql`
					INSERT INTO admin_users (email, password_hash, salt, role, must_change_password)
					VALUES (${email}, ${hash}, ${salt}, ${role}, true)
				`;
				success = `Admin user ${email} added. They will be required to change their password on first login.`;
			} catch (e) {
				const msg = e instanceof Error ? e.message : 'Failed to add user';
				if (msg.includes('unique') || msg.includes('duplicate')) {
					error = 'A user with that email already exists.';
				} else {
					error = msg;
					throw e;
				}
			}
		}
	} else if (action === 'update_role') {
		const id = formData.get('id')?.toString();
		const newRole = formData.get('role')?.toString() === 'super_admin' ? 'super_admin' : 'admin';
		if (id) {
			const target = await sql`SELECT role FROM admin_users WHERE id = ${id} LIMIT 1`;
			const currentRole = target[0]?.role;
			if (currentRole === 'super_admin' && newRole === 'admin') {
				const count = await countSuperAdmins();
				if (count <= 1) {
					error = 'Cannot demote the last super admin.';
				}
			}
			if (!error) {
				await sql`UPDATE admin_users SET role = ${newRole} WHERE id = ${id}`;
				return Astro.redirect('/admin/users');
			}
		}
	} else if (action === 'delete') {
		const id = formData.get('id')?.toString();
		if (id) {
			if (id === currentUserId) {
				error = 'You cannot remove your own account.';
			} else {
				const target = await sql`SELECT role FROM admin_users WHERE id = ${id} LIMIT 1`;
				const targetRole = target[0]?.role;
				if (targetRole === 'super_admin') {
					const count = await countSuperAdmins();
					if (count <= 1) {
						error = 'Cannot remove the last super admin.';
					}
				}
				if (!error) {
					await sql`DELETE FROM admin_users WHERE id = ${id}`;
					return Astro.redirect('/admin/users');
				}
			}
		}
	}
}

const users = await sql`
	SELECT id, email, role, created_at
	FROM admin_users
	ORDER BY email ASC
	LIMIT 100
`;
---

<AdminLayout>
	<div class="flex justify-between items-center mb-8">
		<div>
			<h2 class="text-3xl font-bold text-gray-800">Admin Users</h2>
			<p class="text-gray-600 mt-2">Manage administrators for the property.</p>
		</div>
	</div>

	{error && <p class="text-red-500 text-sm mb-4">{error}</p>}
	{success && <p class="text-green-600 text-sm mb-4">{success}</p>}

	<!-- Add User Form -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8 max-w-xl">
		<h3 class="text-lg font-semibold text-gray-800 mb-4">Add Admin User</h3>
		<form method="POST" class="flex flex-col gap-4">
			<input type="hidden" name="action" value="add" />
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
				<input
					type="email"
					name="email"
					class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
					required
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Temporary password</label>
				<input
					type="password"
					name="password"
					minlength={PASSWORD_MIN_LENGTH}
					class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
					required
				/>
				<p class="text-xs text-gray-500 mt-1">
					Min {PASSWORD_MIN_LENGTH} chars with upper, lower, digit, and symbol. The user will be
					required to change this on first login.
				</p>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
				<select
					name="role"
					class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
				>
					<option value="admin" selected>Admin (standard)</option>
					<option value="super_admin">Super Admin (can manage users)</option>
				</select>
			</div>
			<button
				type="submit"
				class="self-start bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors shadow-sm cursor-pointer"
				>Add Admin</button
			>
		</form>
	</div>

	<!-- Users Table -->
	<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th
						scope="col"
						class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
						>Email</th
					>
					<th
						scope="col"
						class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
						>Role</th
					>
					<th
						scope="col"
						class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
						>Actions</th
					>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				{
					users.length === 0 ? (
						<tr>
							<td colspan="3" class="px-6 py-4 text-center text-sm text-gray-500">
								No admin users found
							</td>
						</tr>
					) : (
						users.map((user) => (
							<tr class="hover:bg-gray-50 transition-colors">
								<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
									{user.email}
									{user.id === currentUserId && (
										<span class="ml-2 text-xs text-gray-500">(you)</span>
									)}
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
									<form method="POST" class="flex items-center gap-2">
										<input type="hidden" name="action" value="update_role" />
										<input type="hidden" name="id" value={user.id} />
										<select
											name="role"
											class="px-2 py-1 border border-gray-300 rounded text-sm"
										>
											<option value="admin" selected={user.role === 'admin'}>
												Admin
											</option>
											<option
												value="super_admin"
												selected={user.role === 'super_admin'}
											>
												Super Admin
											</option>
										</select>
										<button
											type="submit"
											class="text-blue-600 hover:text-blue-900 text-sm cursor-pointer"
										>
											Save
										</button>
									</form>
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
									{user.id !== currentUserId && (
										<form method="POST" class="inline">
											<input type="hidden" name="action" value="delete" />
											<input type="hidden" name="id" value={user.id} />
											<button
												type="submit"
												class="text-red-600 hover:text-red-900 cursor-pointer"
												onclick="return confirm('Are you sure you want to remove this admin?')"
											>
												Remove
											</button>
										</form>
									)}
								</td>
							</tr>
						))
					)
				}
			</tbody>
		</table>
	</div>
</AdminLayout>

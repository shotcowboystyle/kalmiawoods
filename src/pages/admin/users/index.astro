---
import { HOME } from '@/app/constants';
import Layout from '@/app/LayoutPage.astro';
import SvgSprite from '@/components/SvgSprite.astro';
import AddUserButton from '@/modules/Users/AddUserButton.astro';
import UserList from '@/modules/Users/UserList.vue';
---

<Layout>
	<header
		class="bg-users text-users-content navbar"
		transition:name="Users background"
	>
		<div
			class="flex-none"
			transition:name="Users icon"
		>
			<a
				href={HOME}
				class="btn btn-square btn-ghost"
			>
				<SvgSprite
					name="arrow-left"
					class="stroke-users h-6 w-6"
				/>
			</a>
		</div>
		<div class="flex-1">
			<span
				class="animate-in m-0 text-xl"
				transition:name="Users title"
				>Users</span
			>
		</div>
		<div class="flex-none">
			<AddUserButton />
		</div>
	</header>

	<div class="px-0 sm:pt-8">
		<UserList client:only="vue" />
	</div>
</Layout>

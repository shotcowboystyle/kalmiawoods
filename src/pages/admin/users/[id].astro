---
import type { InferGetStaticParamsType } from 'astro';

import LayoutSidebar from '@/app/LayoutSidebar.astro';
import { checkAuth } from '@/app/check-auth';
import UserSettings from '@/modules/Profile/UserSettings.vue';

const redirect = await checkAuth(Astro);
if (redirect) {
  return Astro.redirect(redirect);
}

type Params = InferGetStaticParamsType<{ id: string; }>;

const { id } = Astro.params as Params;
---

<LayoutSidebar>
  <div class="px-4 pt-8">
    <UserSettings client:only="vue" mode={id} />
  </div>
</LayoutSidebar>

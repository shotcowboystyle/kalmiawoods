---
import Card from '../../../components/admin/Card.astro';
import FormAlert from '../../../components/admin/FormAlert.astro';
import AdminLayout from '../../../components/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import { formatReservationDateTime, propertyLabel } from '../../../lib/reservations';

export const prerender = false;

const sql = getDb();
let error = '';

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const action = formData.get('action')?.toString();
	const id = formData.get('id')?.toString();

	if (action === 'delete' && id) {
		await sql`DELETE FROM reservations WHERE id = ${id}`;
		return Astro.redirect(Astro.url.pathname + Astro.url.search);
	}
}

const validFilters = ['upcoming', 'current', 'past', 'all'] as const;
type Filter = (typeof validFilters)[number];
const rawFilter = Astro.url.searchParams.get('filter') ?? 'upcoming';
const filter: Filter = (validFilters as readonly string[]).includes(rawFilter)
	? (rawFilter as Filter)
	: 'upcoming';

const rawPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isFinite(rawPage) && rawPage >= 1 ? Math.min(Math.floor(rawPage), 10000) : 1;
const PAGE_SIZE = 25;
const offset = (page - 1) * PAGE_SIZE;

type Row = {
	id: string;
	name: string;
	check_in: string;
	check_out: string;
	property: string;
};

let reservations: Row[] = [];
let hasNext = false;

try {
	const rows = (await (async () => {
		if (filter === 'upcoming') {
			return sql`
				SELECT id, name, check_in, check_out, property
				FROM reservations
				WHERE check_in >= now()
				ORDER BY check_in ASC
				LIMIT ${PAGE_SIZE + 1} OFFSET ${offset}
			`;
		}
		if (filter === 'current') {
			return sql`
				SELECT id, name, check_in, check_out, property
				FROM reservations
				WHERE check_in <= now() AND check_out >= now()
				ORDER BY check_in ASC
				LIMIT ${PAGE_SIZE + 1} OFFSET ${offset}
			`;
		}
		if (filter === 'past') {
			return sql`
				SELECT id, name, check_in, check_out, property
				FROM reservations
				WHERE check_out < now()
				ORDER BY check_in DESC
				LIMIT ${PAGE_SIZE + 1} OFFSET ${offset}
			`;
		}
		return sql`
			SELECT id, name, check_in, check_out, property
			FROM reservations
			ORDER BY check_in DESC
			LIMIT ${PAGE_SIZE + 1} OFFSET ${offset}
		`;
	})()) as Row[];
	hasNext = rows.length > PAGE_SIZE;
	reservations = rows.slice(0, PAGE_SIZE);
} catch (e) {
	error = e instanceof Error ? e.message : 'Failed to load reservations';
	throw e;
}

const buildLink = (params: Record<string, string | number | undefined>) => {
	const url = new URL(Astro.url.pathname, Astro.url.origin);
	if (filter !== 'upcoming') url.searchParams.set('filter', filter);
	for (const [k, v] of Object.entries(params)) {
		if (v === undefined || v === null || v === '') url.searchParams.delete(k);
		else url.searchParams.set(k, String(v));
	}
	if (params.filter === 'upcoming') url.searchParams.delete('filter');
	return url.pathname + (url.search ? url.search : '');
};

const filterTabs: { key: Filter; label: string }[] = [
	{ key: 'upcoming', label: 'Upcoming' },
	{ key: 'current', label: 'Current' },
	{ key: 'past', label: 'Past' },
	{ key: 'all', label: 'All' },
];
---

<AdminLayout>
	<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<h2 class="text-base-content text-3xl font-bold">Reservations</h2>
			<p class="text-base-content/70 mt-2">Manage property bookings.</p>
		</div>
		<a
			href="/admin/reservations/create"
			class="btn btn-primary shrink-0"
			>+ New Reservation</a
		>
	</div>

	<FormAlert
		tone="error"
		message={error}
	/>

	<div class="mb-4 flex flex-wrap gap-2">
		{
			filterTabs.map((tab) => {
				const active = filter === tab.key;
				return (
					<a
						href={buildLink({ filter: tab.key, page: undefined })}
						class:list={[
							'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
							active
								? 'bg-primary text-primary-content'
								: 'bg-base-100 text-base-content/70 border-base-300 hover:text-primary border',
						]}
					>
						{tab.label}
					</a>
				);
			})
		}
	</div>

	<Card
		padding={false}
		class="overflow-hidden"
	>
		<table
			class="stacked-table divide-base-300 min-w-full divide-y"
			role="table"
		>
			<thead class="bg-base-200">
				<tr role="row">
					<th
						scope="col"
						class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase"
					>
						Name
					</th>
					<th
						scope="col"
						class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase"
					>
						Check In
					</th>
					<th
						scope="col"
						class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase"
					>
						Check Out
					</th>
					<th
						scope="col"
						class="text-base-content/70 px-6 py-3 text-left text-xs font-medium tracking-wider uppercase"
					>
						Property
					</th>
					<th
						scope="col"
						class="text-base-content/70 px-6 py-3 text-right text-xs font-medium tracking-wider uppercase"
					>
						Actions
					</th>
				</tr>
			</thead>
			<tbody class="divide-base-300 divide-y">
				{
					reservations.length === 0 ? (
						<tr role="row">
							<td
								colspan="5"
								class="text-base-content/60 px-6 py-8 text-center text-sm"
								role="cell"
							>
								No reservations found.
							</td>
						</tr>
					) : (
						reservations.map((r) => (
							<tr
								class="hover:bg-base-200 transition-colors"
								role="row"
							>
								<td
									role="cell"
									data-label="Name"
									class="text-base-content selectable px-6 py-4 text-sm font-medium whitespace-nowrap"
								>
									{r.name}
								</td>
								<td
									role="cell"
									data-label="Check in"
									class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
								>
									{formatReservationDateTime(r.check_in)}
								</td>
								<td
									role="cell"
									data-label="Check out"
									class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
								>
									{formatReservationDateTime(r.check_out)}
								</td>
								<td
									role="cell"
									data-label="Property"
									class="text-base-content/70 px-6 py-4 text-sm whitespace-nowrap"
								>
									{propertyLabel(r.property)}
								</td>
								<td
									role="cell"
									class="px-6 py-4 text-right text-sm font-medium whitespace-nowrap max-lg:justify-end"
								>
									<a
										href={`/admin/reservations/edit?id=${r.id}`}
										class="text-primary hover:text-primary/80 mr-3"
									>
										Edit
									</a>
									<form
										method="POST"
										class="inline"
										data-confirm-delete
									>
										<input
											type="hidden"
											name="action"
											value="delete"
										/>
										<input
											type="hidden"
											name="id"
											value={r.id}
										/>
										<input
											type="hidden"
											name="guest_name"
											value={r.name}
										/>
										<button
											type="submit"
											class="text-error hover:text-error/80 cursor-pointer"
										>
											Delete
										</button>
									</form>
								</td>
							</tr>
						))
					)
				}
			</tbody>
		</table>
	</Card>

	{
		(page > 1 || hasNext) && (
			<div class="mt-4 flex items-center justify-between text-sm">
				<span class="text-base-content/60">Page {page}</span>
				<div class="flex gap-2">
					{page > 1 ? (
						<a
							href={buildLink({ page: page - 1 })}
							class="btn btn-ghost btn-sm"
						>
							← Previous
						</a>
					) : (
						<span class="btn btn-ghost btn-sm btn-disabled">← Previous</span>
					)}
					{hasNext ? (
						<a
							href={buildLink({ page: page + 1 })}
							class="btn btn-ghost btn-sm"
						>
							Next →
						</a>
					) : (
						<span class="btn btn-ghost btn-sm btn-disabled">Next →</span>
					)}
				</div>
			</div>
		)
	}
</AdminLayout>

<script>
	document.addEventListener('submit', (event) => {
		const form = event.target as HTMLFormElement | null;
		if (!form || !form.hasAttribute('data-confirm-delete')) return;
		const name = form.querySelector<HTMLInputElement>('input[name="guest_name"]')?.value ?? '';
		const label = name ? `Delete reservation for ${name}?` : 'Delete this reservation?';
		if (!confirm(label)) event.preventDefault();
	});
</script>

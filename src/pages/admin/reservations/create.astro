---
import Card from '../../../components/admin/Card.astro';
import FieldError from '../../../components/admin/FieldError.astro';
import FormAlert from '../../../components/admin/FormAlert.astro';
import SubmitButton from '../../../components/admin/SubmitButton.astro';
import AdminLayout from '../../../components/AdminLayout.astro';
import { getDb } from '../../../lib/db';
import {
	CHECK_IN_HOUR,
	CHECK_OUT_HOUR,
	combineDateAndTime,
	findConflictingReservation,
	formatReservationDate,
	isProperty,
	PROPERTIES,
	propertyLabel,
	validateReservationInput,
	type Property,
	type ReservationFieldErrors,
} from '../../../lib/reservations';

export const prerender = false;

const sql = getDb();

let errors: ReservationFieldErrors = {};
let values = { name: '', check_in: '', check_out: '', property: '' };

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	values = {
		name: formData.get('name')?.toString() ?? '',
		check_in: formData.get('check_in')?.toString() ?? '',
		check_out: formData.get('check_out')?.toString() ?? '',
		property: formData.get('property')?.toString() ?? '',
	};

	errors = validateReservationInput({
		name: values.name,
		checkInDate: values.check_in,
		checkOutDate: values.check_out,
		property: values.property,
	});

	if (Object.keys(errors).length === 0 && isProperty(values.property)) {
		const checkInAt = combineDateAndTime(values.check_in, CHECK_IN_HOUR);
		const checkOutAt = combineDateAndTime(values.check_out, CHECK_OUT_HOUR);

		const conflict = await findConflictingReservation(sql, {
			property: values.property,
			checkIn: checkInAt,
			checkOut: checkOutAt,
		});

		if (conflict) {
			errors._form = `Conflicts with existing booking for ${conflict.name} (${propertyLabel(conflict.property)}, ${formatReservationDate(conflict.check_in)} → ${formatReservationDate(conflict.check_out)}).`;
		} else {
			try {
				await sql`
					INSERT INTO reservations (name, check_in, check_out, property)
					VALUES (${values.name.trim()}, ${checkInAt.toISOString()}, ${checkOutAt.toISOString()}, ${values.property})
				`;
				return Astro.redirect('/admin/reservations');
			} catch (e) {
				errors._form = e instanceof Error ? e.message : 'Failed to create reservation';
				throw e;
			}
		}
	}
}

const existingRows = await sql`
	SELECT id, property, check_in, check_out
	FROM reservations
	WHERE check_out >= now()
	ORDER BY check_in ASC
	LIMIT 500
`;
const existingReservations = existingRows.map((r) => ({
	id: r.id as string,
	property: r.property as Property,
	checkIn: new Date(r.check_in).toISOString(),
	checkOut: new Date(r.check_out).toISOString(),
}));
---

<AdminLayout>
	<div class="mb-8">
		<div class="flex items-center gap-4">
			<a
				href="/admin/reservations"
				class="text-base-content/60 hover:text-primary transition-colors"
				aria-label="Back to reservations"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M10 19l-7-7m0 0l7-7m-7 7h18"
					></path></svg
				>
			</a>
			<h2 class="text-base-content text-3xl font-bold">New Reservation</h2>
		</div>
		<p class="text-base-content/70 mt-2 ml-10">Add a new property booking.</p>
	</div>

	<Card
		class="max-w-2xl"
		padding={false}
	>
		<div class="p-8">
			<FormAlert
				tone="error"
				message={errors._form}
			/>
			<form
				method="POST"
				id="reservation-form"
				class="flex flex-col gap-6"
				novalidate
			>
				<div>
					<label
						for="name"
						class="text-base-content mb-1 block text-sm font-medium"
					>
						Guest Name
					</label>
					<input
						id="name"
						type="text"
						name="name"
						value={values.name}
						maxlength="200"
						aria-invalid={errors.name ? 'true' : undefined}
						aria-describedby={errors.name ? 'name-error' : undefined}
						class:list={['input input-bordered bg-base-100 w-full', errors.name && 'input-error']}
						required
					/>
					<FieldError
						id="name-error"
						message={errors.name}
					/>
				</div>

				<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
					<div>
						<label
							for="check_in"
							class="text-base-content mb-1 block text-sm font-medium"
						>
							Check In
						</label>
						<input
							id="check_in"
							type="date"
							name="check_in"
							value={values.check_in}
							aria-invalid={errors.checkInDate ? 'true' : undefined}
							aria-describedby={errors.checkInDate ? 'check-in-error' : 'check-in-helper'}
							class:list={[
								'input input-bordered bg-base-100 w-full',
								errors.checkInDate && 'input-error',
							]}
							required
						/>
						<FieldError
							id="check-in-error"
							message={errors.checkInDate}
						/>
						{
							!errors.checkInDate && (
								<p
									id="check-in-helper"
									class="text-base-content/60 mt-1 text-xs"
								>
									Check-in 3:00 PM (Eastern)
								</p>
							)
						}
					</div>
					<div>
						<label
							for="check_out"
							class="text-base-content mb-1 block text-sm font-medium"
						>
							Check Out
						</label>
						<input
							id="check_out"
							type="date"
							name="check_out"
							value={values.check_out}
							aria-invalid={errors.checkOutDate ? 'true' : undefined}
							aria-describedby={errors.checkOutDate ? 'check-out-error' : 'check-out-helper'}
							class:list={[
								'input input-bordered bg-base-100 w-full',
								errors.checkOutDate && 'input-error',
							]}
							required
						/>
						<FieldError
							id="check-out-error"
							message={errors.checkOutDate}
						/>
						{
							!errors.checkOutDate && (
								<p
									id="check-out-helper"
									class="text-base-content/60 mt-1 text-xs"
								>
									Check-out 11:00 AM (Eastern)
								</p>
							)
						}
					</div>
				</div>

				<div>
					<label
						for="property"
						class="text-base-content mb-1 block text-sm font-medium"
					>
						Property
					</label>
					<select
						id="property"
						name="property"
						aria-invalid={errors.property ? 'true' : undefined}
						aria-describedby={errors.property ? 'property-error' : undefined}
						class:list={[
							'select select-bordered bg-base-100 w-full',
							errors.property && 'select-error',
						]}
						required
					>
						<option
							value=""
							disabled
							selected={!values.property}
							>Select property...</option
						>
						{
							PROPERTIES.map((p) => (
								<option
									value={p.value}
									data-base-label={p.label}
									selected={values.property === p.value}
								>
									{p.label}
								</option>
							))
						}
					</select>
					<FieldError
						id="property-error"
						message={errors.property}
					/>
					<p
						data-availability-status
						class="text-warning mt-2 hidden text-xs"
						role="status"
						aria-live="polite"
					>
					</p>
				</div>

				<div class="flex justify-end gap-3 pt-4">
					<a
						href="/admin/reservations"
						class="btn btn-ghost"
					>
						Cancel
					</a>
					<SubmitButton
						label="Save Reservation"
						labelSubmitting="Saving…"
					/>
				</div>
			</form>
		</div>
	</Card>
	<p class="text-base-content/50 mt-4 text-xs">
		Times are fixed policy: check-in 3:00 PM, check-out 11:00 AM ({CHECK_IN_HOUR}:00 / {
			CHECK_OUT_HOUR
		}:00 Eastern).
	</p>

	<script
		id="existing-reservations"
		type="application/json"
		set:html={JSON.stringify(existingReservations)}
	/>
</AdminLayout>

<script>
	import {
		CHECK_IN_HOUR,
		CHECK_OUT_HOUR,
		combineDateAndTime,
		getBlockedProperties,
		type ExistingReservationLite,
		type Property,
	} from '../../../lib/reservations';

	const form = document.getElementById('reservation-form') as HTMLFormElement | null;
	const jsonEl = document.getElementById('existing-reservations');
	if (form && jsonEl?.textContent) {
		const reservations: ExistingReservationLite[] = JSON.parse(jsonEl.textContent);
		const excludeId = form.dataset.excludeId || null;
		const ci = form.querySelector<HTMLInputElement>('#check_in')!;
		const co = form.querySelector<HTMLInputElement>('#check_out')!;
		const sel = form.querySelector<HTMLSelectElement>('#property')!;
		const status = form.querySelector<HTMLElement>('[data-availability-status]')!;

		function update(): void {
			for (const opt of Array.from(sel.options)) {
				if (!opt.value) continue;
				opt.disabled = false;
				opt.textContent = opt.dataset.baseLabel ?? opt.textContent;
			}
			status.textContent = '';
			status.classList.add('hidden');

			if (!ci.value || !co.value || co.value <= ci.value) return;

			const candStart = combineDateAndTime(ci.value, CHECK_IN_HOUR);
			const candEnd = combineDateAndTime(co.value, CHECK_OUT_HOUR);
			const blocked = getBlockedProperties(candStart, candEnd, reservations, excludeId);
			if (blocked.size === 0) return;

			const blockedLabels: string[] = [];
			for (const opt of Array.from(sel.options)) {
				if (!opt.value) continue;
				if (blocked.has(opt.value as Property)) {
					opt.disabled = true;
					const base = opt.dataset.baseLabel ?? opt.value;
					opt.textContent = `${base} — unavailable`;
					blockedLabels.push(base);
				}
			}

			status.classList.remove('hidden');
			status.textContent =
				blockedLabels.length === 3
					? 'No property is available for these dates. Please choose different dates.'
					: `Unavailable for these dates: ${blockedLabels.join(', ')}.`;
		}

		ci.addEventListener('change', update);
		co.addEventListener('change', update);
		update();
	}
</script>

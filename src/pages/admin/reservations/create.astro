---
import AdminLayout from '../../../components/AdminLayout.astro';
import { getDb } from '../../../lib/db';

export const prerender = false;

let error = '';
let values = { name: '', check_in: '', check_out: '', property: '' };

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	values = {
		name: formData.get('name')?.toString() ?? '',
		check_in: formData.get('check_in')?.toString() ?? '',
		check_out: formData.get('check_out')?.toString() ?? '',
		property: formData.get('property')?.toString() ?? '',
	};

	if (!values.name || !values.check_in || !values.check_out || !values.property) {
		error = 'All fields are required.';
	} else {
		try {
			const sql = getDb();
			await sql`
				INSERT INTO reservations (name, check_in, check_out, property)
				VALUES (${values.name}, ${values.check_in}, ${values.check_out}, ${values.property})
			`;
			return Astro.redirect('/admin/reservations');
		} catch (e) {
			error = e instanceof Error ? e.message : 'Failed to create reservation';
			throw e;
		}
	}
}
---

<AdminLayout>
	<div class="mb-8">
		<div class="flex items-center gap-4">
			<a href="/admin/reservations" class="text-gray-500 hover:text-blue-600 transition-colors">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
				>
			</a>
			<h2 class="text-3xl font-bold text-gray-800">New Reservation</h2>
		</div>
		<p class="text-gray-600 mt-2 ml-10">Add a new property booking.</p>
	</div>

	<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 max-w-2xl">
		<form method="POST" class="flex flex-col gap-6">
			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Guest Name</label>
				<input
					type="text"
					name="name"
					value={values.name}
					class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
					required
				/>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Check In</label>
					<input
						type="date"
						name="check_in"
						value={values.check_in}
						class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
						required
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Check Out</label>
					<input
						type="date"
						name="check_out"
						value={values.check_out}
						class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
						required
					/>
				</div>
			</div>

			<div>
				<label class="block text-sm font-medium text-gray-700 mb-1">Property</label>
				<select
					name="property"
					class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
					required
				>
					<option value="" disabled selected={!values.property}>Select property...</option>
					<option value="main_house" selected={values.property === 'main_house'}
						>Main House</option
					>
					<option value="workshop" selected={values.property === 'workshop'}>Workshop</option>
					<option value="both" selected={values.property === 'both'}>Both</option>
				</select>
			</div>

			<div class="pt-4 flex justify-end gap-3">
				<a
					href="/admin/reservations"
					class="px-5 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition-colors"
					>Cancel</a
				>
				<button
					type="submit"
					class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors shadow-sm cursor-pointer"
					>Save Reservation</button
				>
			</div>
			{error && <p class="text-red-500 text-sm">{error}</p>}
		</form>
	</div>
</AdminLayout>

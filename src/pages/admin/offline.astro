---
import '../../styles/admin.css';

// Prerendered on purpose: this page is the service worker's fallback, so it
// must not need a session, a database round trip, or a serverless function.
// It is also the shell the worker reuses to report a failed offline write.
export const prerender = true;
---

<!doctype html>
<html
	lang="en"
	data-theme="dark"
>
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta
			name="robots"
			content="noindex, nofollow"
		/>
		<meta
			name="x-build-id"
			content={__BUILD_ID__}
		/>
		<meta
			name="theme-color"
			content="#172c33"
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.svg"
		/>
		<link
			rel="manifest"
			href="/manifest-admin.webmanifest"
		/>
		<title>Offline - KW Admin</title>
		<script is:inline>
			document.documentElement.style.colorScheme = 'dark';
		</script>
	</head>
	<body class="bg-base-200 text-base-content font-sans antialiased">
		<div class="app-shell safe-top safe-x safe-bottom items-center justify-center">
			<main class="flex w-full max-w-md flex-col gap-4 text-center">
				<h1
					class="text-2xl font-bold"
					id="offline-title"
				>
					You're offline
				</h1>

				<p
					class="text-base-content/70"
					id="offline-message"
				>
					This page hasn't been saved for offline use yet. Pages you've already visited while online
					will still open.
				</p>

				<p class="text-base-content/50 text-sm">
					Signing in needs a connection. If you were already signed in on this device, your cached
					pages are still available from the menu.
				</p>

				<div class="mt-2 flex flex-col gap-2">
					<button
						type="button"
						class="btn btn-primary"
						data-no-callout
						id="retry"
					>
						Try again
					</button>
					<a
						href="/admin"
						class="btn btn-ghost"
						>Back to dashboard</a
					>
				</div>
			</main>
		</div>

		<script>
			// pointerdown, not click: the touchstart handler that suppresses iOS's
			// selection callout also swallows the subsequent click on these controls.
			document.getElementById('retry')?.addEventListener('pointerdown', () => {
				location.reload();
			});

			document.addEventListener(
				'touchstart',
				(event) => {
					const target = event.target as HTMLElement | null;
					if (target?.closest('[data-no-callout]')) event.preventDefault();
				},
				{ passive: false },
			);
		</script>
	</body>
</html>

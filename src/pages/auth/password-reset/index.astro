---
import LayoutFrameless from '@/app/LayoutFrameless.astro';
import { checkAuth } from '@/app/check-auth';
import FormPasswordRecovery from '@/modules/Auth/FormPasswordRecovery.vue';

const redirect = await checkAuth(Astro);
if (redirect) {
  return Astro.redirect(redirect);
}
---

<LayoutFrameless>
  <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
    Password recovery
  </h2>
  <FormPasswordRecovery client:only="vue" />
</LayoutFrameless>

---
import LayoutFrameless from '@/app/LayoutFrameless.astro';
import FormCompleteRegistration from '@/modules/Auth/FormCompleteRegistration.vue';
import type { InferGetStaticParamsType } from 'astro';

type Params = InferGetStaticParamsType<{ token: string }>;

const { token } = Astro.params as Params;
---

<LayoutFrameless>
	<h2 class="text-2xl font-bold text-gray-900 dark:text-white">Complete registration</h2>
	<FormCompleteRegistration
		client:only="vue"
		token={token}
	/>
</LayoutFrameless>

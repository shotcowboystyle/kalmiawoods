---
import { HOME } from '@/app/constants';
import Layout from '@/app/LayoutPage.astro';
import GuidebookNavigationMobile from '@/components/GuidebookNavigationMobile.astro';
import SvgSprite from '@/components/SvgSprite.astro';
import type { Guidebook } from '@/types/Guidebook';
import { getCollection } from 'astro:content';

const guidebookContent = (await getCollection('guidebook'))
	.sort((a, b) => a.data.order - b.data.order)
	.reduce((acc, cur) => {
		const idParts: string[] = cur.id.split('/');
		const categoryId: string = idParts[0];
		const subcategoryId: string = idParts[1];

		let sections = acc;
		if (!sections[categoryId]) {
			sections = {
				...sections,
				[categoryId]: {
					categoryTitle: cur.data.category,
					icon: cur.data.categoryIcon,
					order: cur.data.order,
					subcategories: {
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [cur],
						},
					},
				},
			};
		} else if (!sections[categoryId].subcategories[subcategoryId]) {
			sections = {
				...sections,
				[categoryId]: {
					...sections[categoryId],
					subcategories: {
						...sections[categoryId].subcategories,
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [cur],
						},
					},
				},
			};
		} else {
			sections = {
				...sections,
				[categoryId]: {
					...sections[categoryId],
					subcategories: {
						...sections[categoryId].subcategories,
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [...(sections[categoryId]?.subcategories?.[subcategoryId]?.items ?? []), cur],
						},
					},
				},
			};
		}

		return sections;
	}, {} as Guidebook);


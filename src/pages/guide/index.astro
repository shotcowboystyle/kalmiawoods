---

<Layout>
	<header
		class="bg-guidebook text-guidebook-content navbar"
		transition:name="Guidebook background"
	>
		<div
			class="flex-none"
			transition:name="Guidebook icon"
		>
			<a
				href={HOME}
				class="btn btn-square btn-ghost"
			>
				<SvgSprite
					name="arrow-left-icon"
					class="stroke-guidebook h-6 w-6"
				/>
			</a>
		</div>

		<div class="flex-1">
			<span
				class="animate-in m-0 text-xl"
				transition:name="Guidebook title"
				>Guidebook</span
			>
		</div>
	</header>

	<div class="px-0 sm:pt-8">
		<GuidebookNavigationMobile pages={guidebookContent} />
	</div>
</Layout>

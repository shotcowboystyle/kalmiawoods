---
// import { Link } from 'astro-link';
import Layout from '@/app/LayoutStacked.astro';
import GuidebookPage from '@/modules/Guidebook/GuidebookPage.astro';
import { getCollection } from 'astro:content';

const guidebookContent = (await getCollection('guidebook'))
	.sort((a, b) => a.data.order - b.data.order)
	.reduce((acc, cur) => {
		let sections = acc;
		const idParts = cur.id.split('/');
		const categoryId = idParts[0];
		const subcategoryId = idParts[1];
		if (!sections[categoryId]) {
			sections = {
				...sections,
				[categoryId]: {
					categoryTitle: cur.data.category,
					icon: cur.data.categoryIcon,
					order: cur.data.order,
					subcategories: {
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [cur],
						},
					},
				},
			};
		} else if (!sections[categoryId].subcategories[subcategoryId]) {
			sections = {
				...sections,
				[categoryId]: {
					...sections[categoryId],
					subcategories: {
						...sections[categoryId].subcategories,
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [cur],
						},
					},
				},
			};
		} else {
			sections = {
				...sections,
				[categoryId]: {
					...sections[categoryId],
					subcategories: {
						...sections[categoryId].subcategories,
						[subcategoryId]: {
							subcategoryTitle: cur.data.subcategory,
							icon: cur.data.subcategoryIcon,
							order: cur.data.categoryOrder,
							items: [...(sections[categoryId]?.subcategories?.[subcategoryId]?.items ?? []), cur],
						},
					},
				},
			};
		}

		return sections;
	}, {});

// console.log('guidebookContent', guidebookContent["Where's The Nearest...?"].subcategories['Gas Station'].items[0]);
// console.log('guidebookContent', guidebookContent);
---

<Layout>
	<GuidebookPage guides={guidebookContent} />
</Layout>

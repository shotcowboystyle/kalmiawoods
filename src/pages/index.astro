---
import Layout from '@/app/LayoutLanding.astro';
import BeyondProperty from '@/modules/Landing/BeyondProperty.astro';
import DiningOptions from '@/modules/Landing/DiningOptions.astro';
import Forest from '@/modules/Landing/Forest.astro';
import Hero from '@/modules/Landing/Hero.astro';
import Nearby from '@/modules/Landing/Nearby.astro';
import Rooms from '@/modules/Landing/Rooms.astro';
import RoomsGallery from '@/modules/Landing/RoomsGallery.astro';
import RoomsList from '@/modules/Landing/RoomsList.astro';
import Welcome from '@/modules/Landing/Welcome.astro';
import Wellness from '@/modules/Landing/Wellness.astro';
---

<Layout
	isHomepage
	useLightNavigation
	description="A mountain retreat near Lake Jocassee and Lake Keowee in Salem, SC. Private trails, game room, hot tub, and more for up to 15 guests."
>
	<Hero />

	<div class="o-page__inner">
		<Welcome />
		<Rooms />
		<RoomsList />
		<RoomsGallery />
		<DiningOptions />
		<Nearby />
		<Wellness />
		<Forest />
		<BeyondProperty />
	</div>
</Layout>

<script>
	import HeaderAnimation from '@/lib/modules/header.animation';

	const headerAnimation = new HeaderAnimation();

	function initializeApp() {
		headerAnimation.init();
	}

	document.addEventListener('astro:page-load', initializeApp);
</script>

---
export const prerender = false;

import type { InferGetStaticParamsType } from 'astro';

import LayoutEmail from '@/app/LayoutEmail.astro';
import { prisma } from '@/lib/db.js';
import { getEmail } from '@/services/email';
import { isValidFormSubmission } from '@/utils/forms/submission';

type Params = InferGetStaticParamsType<{ email_id: string }>;

const { email_id } = Astro.params as Params;

if (Astro.request.method === 'POST') {
  const validSubmission = isValidFormSubmission(Astro.request);
  if (!validSubmission) {
    return null;
  }
  await prisma.email.delete({
    where: {
      id: email_id,
    },
  });
  return Astro.redirect('/email', 302);
}

const email = await getEmail(email_id);
if (!email) {
  return Astro.redirect('/404', 302);
}
---

<LayoutEmail>
  <div class="flex text-sm place-content-between">
    <p class="">To: {email.toAddress}</p>
    <p class="text-zinc-400">{email.dateSent.toLocaleString()}</p>
  </div>
  <h1 class="py-2 text-lg font-semibold border-b">
    {email.subject}
  </h1>
  <p set:html={email.content} class="mt-4 break-words" id="email-content" />
  <form method="post" class="mt-6">
    <input type="submit" value="Delete email" class="text-sm text-red-400 cursor-pointer hover:underline" />
  </form>
</LayoutEmail>

<style>
  :global(#email-content a) {
    @apply text-indigo-500 hover:underline;
  }
</style>

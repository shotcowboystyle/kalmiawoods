---
// import { pwaInfo } from 'virtual:pwa-info';
import 'vue-toastification/dist/index.css';
import { SITE_TITLE } from '@/app/constants';
import SeoLanding from '@/app/SeoLanding.astro';
import { ViewTransitions } from 'astro:transitions';
// import ReloadPrompt from '@/components/ReloadPrompt.astro';
import '@fontsource-variable/dm-sans';
import '@/styles/base.css';

export interface Props {
	title?: string;
}

const { title } = Astro.props as Props;
---

<!doctype html>
<html
	lang="en"
	class="bg-[#f7f7ee]"
>
	<head>
		<SeoLanding />

		<title>{SITE_TITLE}</title>
		<meta
			name="description"
			content={title}
		/>

		<!-- <script>
			import { getPreferredColorScheme, setColorScheme } from '@/stores/color-scheme';

			// document.addEventListener('astro:page-load', () => {
			const colorScheme = getPreferredColorScheme();
			setColorScheme(colorScheme);
			// });
		</script> -->

		<script>
			import { LOCAL_STORAGE_COLOR_SCHEME_KEY } from '@/app/constants';
			import { applyColorScheme } from '@/stores/color-scheme';
			import type { ColorScheme } from '@/types/ColorScheme';

			document.addEventListener('astro:after-swap', () => {
				const colorScheme = localStorage.getItem(LOCAL_STORAGE_COLOR_SCHEME_KEY);
				if (colorScheme != null) {
					applyColorScheme(colorScheme as ColorScheme);
				}
			});
		</script>

		<script is:inline>
			/* Alternative to 100 vh on mobile devices */
			/* https://chanind.github.io/javascript/2019/09/28/avoid-100vh-on-mobile-web.html */
			const vh100 = window.innerHeight;
			document.documentElement.style.setProperty('--100vh', `${vh100}px`);
		</script>

		<!-- {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />} -->

		<ViewTransitions />
	</head>

	<body id="top">
		<slot />

		<!-- <ReloadPrompt /> -->

		<style is:global>
			@import url('https://fonts.cdnfonts.com/css/inter');

			.animate-in {
				animation: animate-in 0.5s ease-in-out;
			}

			@keyframes animate-in {
				0% {
					opacity: 0;
					transform: translateY(1rem);
				}
				100% {
					opacity: 1;
					transform: translateY(0);
				}
			}

			/* html {
				min-height: calc(100% + env(safe-area-inset-top));
				padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
					env(safe-area-inset-left);
			} */

			img {
				content-visibility: auto;
			}
		</style>
	</body>
</html>

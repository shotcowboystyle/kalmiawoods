---
import '@/assets/styles/base.css';
import { pwaInfo } from 'virtual:pwa-info';
import 'vue-toastification/dist/index.css';
// import pkg from '../../package.json' assert { type: 'json' };

// import VercelWebVitals from '@/components/VercelWebVitals.astro';
import { SITE_TITLE } from './constants.js';

export interface Props {
  class?: string;
  title: string;
}

const { class: clazz, title } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/pwa-192x192.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#bbea69" />
    <meta name="msapplication-TileColor" content="#bbea69" />
    <meta name="theme-color" content="#bbea69" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={title} />

    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>

    <script>
      /* Alternative to 100 vh on mobile devices */
      /* https://chanind.github.io/javascript/2019/09/28/avoid-100vh-on-mobile-web.html */
      const vh100 = window.innerHeight;
      document.documentElement.style.setProperty('--100vh', `${vh100}px`);
    </script>

    <!-- <VercelWebVitals />
    <script is:inline defer src="/_vercel/insights/script.js"></script> -->

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script src="/src/pwa.ts"></script>
  </head>
  <body
    class:list={[
      //
      clazz,
      'tracking-tight antialiased',
      'bg-base-100',
      'scrollbar scrollbar-w-3 scrollbar-thumb-rounded-[0.25rem]',
      'scrollbar-track-slate-200  scrollbar-thumb-gray-400',
      'dark:scrollbar-track-gray-900 dark:scrollbar-thumb-gray-700',
    ]}>
    <slot />

    <!-- <footer>
      Built at: {buildDate}
    </footer> -->
  </body>
</html>

<style is:global>
  @import url('https://fonts.cdnfonts.com/css/inter');
  img {
    content-visibility: auto;
  }
</style>

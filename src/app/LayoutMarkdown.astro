---
import LayoutStacked from '@/app/LayoutStacked.astro';

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}
const { frontmatter } = Astro.props;
---

<LayoutStacked>
  <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
  <slot />
</LayoutStacked>

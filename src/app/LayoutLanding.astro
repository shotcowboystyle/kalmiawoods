---
import { FOOTER_DATA } from '@/app/constants';
import Loader from '@/app/Loader.astro';
import BookNow from '@/modules/Landing/BookNow.astro';
import Footer from '@/modules/Landing/Footer.astro';
import Menu from '@/modules/Landing/Menu.astro';
import Nav from '@/modules/Landing/Nav.astro';
import LayoutCommon from './LayoutCommon.astro';

export interface Props {
	isHomepage?: boolean;
}

const { isHomepage } = Astro.props as Props;
---

<LayoutCommon>
	<Loader />

	<Nav isHomepage={isHomepage} />
	<Menu />

	<main
		id="smooth-wrapper"
		class="o-page js-smooth-wrapper"
	>
		<div class="js-smooth-content">
			<slot />
		</div>
	</main>

	<BookNow />
	<Footer {...FOOTER_DATA} />

	<style>
		html.lenis {
			height: auto;
		}

		.lenis.lenis-smooth {
			scroll-behavior: auto;
		}

		.lenis.lenis-smooth [data-lenis-prevent] {
			overscroll-behavior: contain;
		}

		.lenis.lenis-stopped {
			overflow: hidden;
		}

		.lenis.lenis-scrolling iframe {
			pointer-events: none;
		}
	</style>
</LayoutCommon>

<script>
	import BackgroundShapeAnimation from '@/lib/background-shape.animation';
	import BrushTextAnimation from '@/lib/brush-text.animation';
	import ContentAnimation from '@/lib/content.animation';
	// import HeaderAnimation from '@/lib/header.animation';
	import LoaderAnimation from '@/lib/loader.animation';
	import NavigationController from '@/lib/navigation-controller';
	import ParallaxBackgroundAnimation from '@/lib/parallax-bg.animation';
	import SectionSeparatorsAnimation from '@/lib/section-separators.animation';
	import SmoothScroll from '@/lib/smooth-scroll';

	const backgroundShapeAnimation = new BackgroundShapeAnimation();
	const brushTextAnimation = new BrushTextAnimation();
	const contentAnimation = new ContentAnimation();
	const navigationController = new NavigationController();
	const parallaxBackgroundAnimation = new ParallaxBackgroundAnimation();
	const sectionSeparatorsAnimation = new SectionSeparatorsAnimation();
	const smoothScroll = new SmoothScroll();
	const loaderAnimation = new LoaderAnimation();

	function initializeApp() {
		smoothScroll.init();
		navigationController.init();
		backgroundShapeAnimation.init();
		brushTextAnimation.init();
		parallaxBackgroundAnimation.init();
		sectionSeparatorsAnimation.init();
		contentAnimation.init();
	}

	document.addEventListener('astro:before-preparation', () => {
		document.body.classList.add('is-transitioning');
		loaderAnimation.showLoader();
	});

	document.addEventListener('astro:after-preparation', () => {
		smoothScroll.kill();
		// headerAnimation.kill();
	});

	document.addEventListener('astro:after-swap', () => {
		loaderAnimation.hideLoader();
	});

	document.addEventListener('astro:page-load', initializeApp);
</script>

---
import { FOOTER_DATA } from '@/app/constants';
import Loader from '@/app/Loader.astro';
import BookNow from '@/modules/Landing/BookNow.astro';
import Footer from '@/modules/Landing/Footer.astro';
import Menu from '@/modules/Landing/Menu.astro';
import Nav from '@/modules/Landing/Nav.astro';
import LayoutCommon from './LayoutCommon.astro';

export interface Props {
	isHomepage?: boolean;
	useLightNavigation?: boolean;
	title?: string;
	description?: string;
}

const { isHomepage, useLightNavigation, title, description } = Astro.props as Props;
---

<LayoutCommon
	title={title}
	description={description}
>
	<Loader />

	<Nav
		isHomepage={isHomepage}
		useLightNavigation={useLightNavigation}
	/>
	<Menu />

	<main
		id="smooth-wrapper"
		class="o-page js-smooth-wrapper"
		transition:animate="initial"
		transition:name="main"
	>
		<div class="js-smooth-content">
			<slot />
		</div>
	</main>

	<BookNow />
	<Footer {...FOOTER_DATA} />

	<style is:global>
		html.lenis {
			height: auto;
		}

		.lenis.lenis-smooth {
			scroll-behavior: auto;
		}

		.lenis.lenis-smooth [data-lenis-prevent] {
			overscroll-behavior: contain;
		}

		.lenis.lenis-stopped {
			overflow: hidden;
		}

		.lenis.lenis-scrolling iframe {
			pointer-events: none;
		}

		.is-transitioning #smooth-wrapper > * {
			display: none;
		}

		::view-transition-image-pair(root) {
			isolation: auto;
		}

		::view-transition-old(root),
		::view-transition-new(root) {
			animation: none;
			mix-blend-mode: normal;
		}

		::view-transition-old(main),
		::view-transition-new(main) {
			visibility: hidden;
		}
	</style>
</LayoutCommon>

<script>
	import App from '@/lib/modules/app';

	document.addEventListener('astro:page-load', () => {
		new App();
	});
</script>

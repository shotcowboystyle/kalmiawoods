---
import CopyrightNotice from '../components/CopyrightNotice.astro';
---

<footer
  class="mx-4 my-6 rounded-lg bg-white p-4 shadow dark:bg-gray-800 md:flex md:items-center md:justify-between md:p-6 xl:p-8">
  <ul class="mb-6 flex flex-wrap items-center space-y-1 md:mb-0">
    <li>
      <a
        href="/terms"
        class="mr-4 text-sm font-normal text-gray-500 hover:underline dark:text-gray-400 md:mr-6"
        >Terms and conditions</a
      >
    </li>
    <li>
      <a
        href="/privacy"
        class="mr-4 text-sm font-normal text-gray-500 hover:underline dark:text-gray-400 md:mr-6"
        >Privacy Policy</a
      >
    </li>
    <li>
      <a
        href="/contact"
        class="text-sm font-normal text-gray-500 hover:underline dark:text-gray-400">Contact</a
      >
    </li>
  </ul>
</footer>

<CopyrightNotice />

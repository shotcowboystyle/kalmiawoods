---
import logo from '@/assets/svg/logo-3.svg';
import { url } from '@/utils/site';
---

<nav
  class="fixed z-50 w-full border-b border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 sm:py-2">
  <div class="container mx-auto px-3 py-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center justify-start">
        <a href={url()} class="mr-4 flex">
          <img
            src={logo}
            aria-label={import.meta.env.APP_NAME}
            class="kw-logo mr-3 h-8 fill-white"
          />
          <span class="self-center whitespace-nowrap text-2xl font-semibold dark:text-white"
            >Kalmia Woods</span
          >
        </a>
      </div>
    </div>
  </div>
</nav>

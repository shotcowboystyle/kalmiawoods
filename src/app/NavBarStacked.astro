---
import Logo from '@/components/Logo.astro';
import { url } from '@/utils/site';
---

<nav
  class="fixed z-50 w-full bg-white border-b border-gray-200 dark:border-gray-700 dark:bg-gray-800 sm:py-2">
  <div class="container px-3 py-3 mx-auto">
    <div class="flex items-center justify-between">
      <div class="flex items-center justify-start">
        <a href={url()} class="flex mr-4">
          <Logo />
          <span class="self-center ml-3 text-2xl font-semibold whitespace-nowrap dark:text-white"
            >Kalmia Woods</span
          >
        </a>
      </div>
    </div>
  </div>
</nav>

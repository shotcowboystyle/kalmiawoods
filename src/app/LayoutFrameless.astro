---
import Logo from '@/components/Logo.astro';
import LayoutCommon from './LayoutCommon.astro';
---

<LayoutCommon>
	<div class="flex overflow-hidden bg-gray-50 dark:bg-gray-900">
		<div
			id="main-content"
			class="relative w-full h-full min-h-screen mx-auto overflow-y-auto max-w-screen-2xl bg-gray-50 dark:bg-gray-900"
		>
			<div class="px-4">
        <div class="flex min-h-screen pb-[12vh] align-middle">
          <div class="pt:mt-0 mx-auto flex w-full flex-col items-center justify-center pt-8 dark:bg-gray-900">
            <div class="mb-8 flex items-center justify-center text-2xl font-semibold dark:text-white">
              <span class="shrink">
                <Logo />
              </span>
              <span class="ml-3">Kalmia Woods</span>
            </div>
            <div class="w-full max-w-xl space-y-8 rounded-lg bg-white p-6 shadow dark:bg-gray-800 sm:p-8">
              <slot />
            </div>
          </div>
        </div>
      </div>
		</div>
	</div>
</LayoutCommon>

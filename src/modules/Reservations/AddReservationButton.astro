---
import SvgSprite from '@/components/SvgSprite.astro';
---

<button
	id="add-reservation-button"
	class="btn btn-square btn-ghost"
>
	<SvgSprite
		name="calendar-plus"
		class="stroke-reservations h-6 w-6"
	/>
</button>

<script>
	import { setActiveReservationId, toggleReservationModal } from '@/stores/reservation';

	const addReservationButton = document.getElementById('add-reservation-button');
	if (addReservationButton) {
		addReservationButton.addEventListener('click', () => {
			setActiveReservationId(null);
			toggleReservationModal();
		});
	}
</script>

---
import gameRoomImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import gameRoomImage2 from '@/assets/images/photos/house-living-area-2.jpeg';
import gameRoomImage3 from '@/assets/images/photos/house-living-area-3.jpeg';
import scenicViewsImage1 from '@/assets/images/photos/house-scenic-views-1.jpeg';
import scenicViewsImage2 from '@/assets/images/photos/house-scenic-views-2.jpeg';
import scenicViewsImage3 from '@/assets/images/photos/house-scenic-views-3.jpeg';
import { Picture } from 'astro:assets';
---

<section class="section o-section--room">
	<div class="section-inner section-inner-pt-l section-inner-pb-xs">
		<div class="container">
			<div class="c-content-images-cta">
				<div class="c-content-images-cta__list">
					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3 c-content-image-card--reverse"
						id="game_room"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={gameRoomImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, gameRoomImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={gameRoomImage2}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, gameRoomImage2.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={gameRoomImage3}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, gameRoomImage3.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> Games</span>
								<span class="c-content-image-card__tag js-animated-stagger-element"> Puzzles</span>
								<span class="c-content-image-card__tag js-animated-stagger-element"> Toys</span>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Game Room
							</h3>
							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Let the kids be kids in our game room, equipped with toys and puzzles, video
									games, or watch movies on a 100" projector screen.
								</p>
							</div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3"
						id="gardens"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={scenicViewsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, scenicViewsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={scenicViewsImage2}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, scenicViewsImage2.width]}
									/>
								</figure>
							</div>
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={scenicViewsImage3}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, scenicViewsImage3.width]}
									/>
								</figure>
							</div>
						</div>
						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element">
									Flower Terrace</span
								>
								<span class="c-content-image-card__tag js-animated-stagger-element">
									Bonsai Garden</span
								>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">Gardens</h3>
							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Enjoy the serinity of nature in one of our many gardens. Beautiful bonsais adorn
									our zen garden, while comfortable benches are spread out along the many property
									trails. Try identifying one of our many local birds and butterflies.
								</p>
							</div>
						</div>
					</article>
				</div>
			</div>
		</div>
	</div>
</section>

---
import roomsImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import { Picture } from 'astro:assets';
---

<section class="section o-section--room">
	<div class="section-inner section-inner-pt-l section-inner-pb-xs">
		<div class="container">
			<div class="c-content-images-cta">
				<div class="c-content-images-cta__list">
					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3 c-content-image-card--reverse"
						id="family-room"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> Balcony</span>
								<span class="c-content-image-card__tag js-animated-stagger-element">
									Park view
								</span>
								<span class="c-content-image-card__tag js-animated-stagger-element"> Sea View</span>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Family Room
							</h3>
							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									A balcony facing the lush parkland surrounding the hotel creates a calming
									connection with nature in a Family room. Some of the rooms also enjoy the
									wonderful sea views of a paradise island from the private balcony. Space and light
									are plentiful inside too, which comfortably sleeps four.
								</p>
							</div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3"
						id="executive-suite"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>
						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> Balcony</span>
								<span class="c-content-image-card__tag js-animated-stagger-element"> Sea View</span>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Executive Suite
							</h3>
							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									A glorious, sweeping view of the Adriatic is yours in one of Hotel Odisej Mljet
									two Executive suites with glossy wood floor, two light filled, ensuite bedrooms,
									and satellite TV. Take a seat on your white walled private balcony and soak up the
									sun over an al fresco meal.
								</p>
							</div>
						</div>
					</article>
				</div>
			</div>
		</div>
	</div>
</section>

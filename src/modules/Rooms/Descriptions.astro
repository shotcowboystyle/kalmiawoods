---
import forestEscapeImage from '@/assets/images/photos/forest-escape.jpeg';
import houseImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import houseImage2 from '@/assets/images/photos/house-living-area-2.jpeg';
import houseImage3 from '@/assets/images/photos/house-living-area-3.jpeg';
import workshopImage from '@/assets/images/photos/workshop-front.jpeg';
import SectionSeparator from '@/components/SectionSeparator.astro';
import { Picture } from 'astro:assets';
---

<section class="section o-section--room section--bg-blue">
	<SectionSeparator
		position="top"
		color="blue"
	/>

	<div class="section-inner section-inner-pt-l section-inner-pb-xl">
		<div class="container">
			<div class="c-content-images-cta">
				<div class="c-content-images-cta__list">
					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3 c-content-image-card--reverse"
						id="cozy_cabin"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={houseImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, houseImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={houseImage2}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, houseImage2.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={houseImage3}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, houseImage3.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element">
									With porch hot tub
								</span>
							</div>

							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Cozy Cabin
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									A peaceful bonsai garden view from your porch entryway is one of the best features
									of our Cozy cabin rooms. Yellow pine walls are complemented by dark wood
									furniture, muted colours and rustic decor for a that mountain home feel.
								</p>
								<p>
									Alternatively, a loft area exists for the kids as well as a separate detached
									garage room that comes equipped with bunk beds and full bathroom.
								</p>
							</div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3"
						id="natures_haven"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<!--        max broj slika: 3-->
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={workshopImage}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, workshopImage.width]}
									/>
								</figure>
							</div>
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={workshopImage}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, workshopImage.width]}
									/>
								</figure>
							</div>
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={workshopImage}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, workshopImage.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"
									>Trail Entrance</span
								>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Nature's Haven
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									A smaller, more economical option for two. Secluded with it's own driveway and
									parking. Here you can relax and listen to the sounds of nature, or take a walk on
									one of our trails for a possible black bear siting.
								</p>
							</div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-2 c-content-image-card--reverse"
						id="forest_escape"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={forestEscapeImage}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, forestEscapeImage.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={forestEscapeImage}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, forestEscapeImage.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> Secluded</span>
								<span class="c-content-image-card__tag js-animated-stagger-element">
									Forest View</span
								>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Forest Escape
							</h3>
							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Tucked away deep in the forest. Get that camping feel with GLAMPING comfort. Our
									one-of-a-kind wilderness tiny houses are a stay filled with life long memories.
								</p>
							</div>
						</div>
					</article>
				</div>
			</div>
		</div>
	</div>
</section>

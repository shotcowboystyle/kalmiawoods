---
import roomsImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import { Picture } from 'astro:assets';
---

<section class="section o-section--room section--bg-blue">
	<div
		class="c-section-separator js-section-separator c-section-separator--top c-section-separator--blue"
	>
		<svg
			class="u-icon u-icon--separator-main js-section-separator-main"
			viewBox="0 0 3876 160"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M-174.61 -157V-116.765C-174.61 15.4344 -112.186 139 -3.49988 139C111 139 138.787 62.2189 249.697 62.2189C360.606 62.2189 356 156.175 533.698 156.175C683 156.175 698.557 75.6322 817.699 62.2189C930.436 49.5265 988.565 138.856 1101.7 138.856C1214.83 138.856 1274.79 62.2189 1385.7 62.2189C1496.61 62.2189 1556.57 138.856 1669.7 138.856C1782.84 138.856 1842.79 62.2189 1953.7 62.2189C2064.61 62.2189 2124.57 138.856 2237.7 138.856C2350.84 138.856 2408.57 62.2188 2521.7 62.2189C2634.84 62.2189 2694.8 138.856 2805.71 138.856C2916.61 138.856 2976.57 62.2189 3089.71 62.2189C3202.84 62.2188 3260.57 138.856 3373.71 138.856C3486.84 138.856 3546.8 62.2189 3657.71 62.2189C3768.62 62.2189 3867.02 222.761 3941.71 108.856C3998.61 22.0779 3941.71 -157 3941.71 -157H-174.61Z"
			></path>
		</svg>

		<svg
			class="u-icon u-icon--separator-secondary js-section-separator-secondary"
			viewBox="0 0 3876 160"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M-196.61 0V21.1232C-196.61 90.5281 -148.913 67.6768 -101.5 115.09C-14.9999 201.59 116.787 115.09 227.697 115.09C338.606 115.09 400.788 152.442 511.698 152.442C622.607 152.442 676.557 122.132 795.699 115.09C908.436 108.426 966.566 155.325 1079.7 155.325C1192.83 155.325 1252.79 115.09 1363.7 115.09C1474.61 115.09 1534.57 155.325 1647.7 155.325C1760.84 155.325 1820.79 115.09 1931.7 115.09C2042.61 115.09 2102.57 155.325 2215.7 155.325C2328.84 155.325 2386.57 115.09 2499.7 115.09C2612.84 115.09 2672.8 155.325 2783.71 155.325C2894.61 155.325 2954.57 115.09 3067.71 115.09C3180.84 115.09 3238.57 155.325 3351.71 155.325C3464.84 155.325 3524.8 115.09 3635.71 115.09C3746.62 115.09 3845.02 185.125 3919.71 125.325C3976.61 79.7659 3919.71 0 3919.71 0H-196.61Z"
			></path>
		</svg>
	</div>

	<div class="section-inner section-inner-pt-l section-inner-pb-xl">
		<div class="container">
			<div class="c-content-images-cta">
				<div class="c-content-images-cta__list">
					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3 c-content-image-card--reverse"
						id="classic-room"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element">
									With or without balcony
								</span>
							</div>

							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Classic Room
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									A peaceful National Park garden view from your white balcony table is one of the
									best features of our Classic rooms. Interior white walls are complemented by dark
									wood furniture, muted colours and contemporary clean lines for a fresh look and
									feel.
								</p>
								<p>
									Alternatively, for those seeking a cozy haven indoors, our classic room without a
									balcony features large windows that invite ample natural light, offering glimpses
									of the tranquil views of the surrounding area.
								</p>
							</div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-3"
						id="superior-room"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<!--        max broj slika: 3-->
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element">Sea View</span>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Superior Room
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Beautiful blue sea views are the centrepiece of every Superior room with interior
									white walls, tiled floor, and cool hued furnishings and air-conditioning making
									the space very comfortable.
								</p>
							</div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--room c-content-image-card--image-count-2 c-content-image-card--reverse"
						id="deluxe-room"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> Balcony</span>
								<span class="c-content-image-card__tag js-animated-stagger-element"> Sea View</span>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Deluxe Room
							</h3>
							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Beyond the trees, a mesmerising view of the Adriatic, draws the eye in a Deluxe
									room. A whitewashed balcony furnished with a table and chairs means you can make
									the most of the wonderful Mediterranean holiday vista.
								</p>
							</div>
						</div>
					</article>
				</div>
			</div>
		</div>
	</div>
</section>

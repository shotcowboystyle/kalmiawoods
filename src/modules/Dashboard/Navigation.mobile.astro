---
// import LogoutButton from '@/components/LogoutButton.vue';
import ColorSchemeSwitcher from '@/components/ColorSchemeSwitcher.astro';
import SvgSprite from '@/components/SvgSprite.astro';
import NavigationLink from './NavigationLink.mobile.astro';
---

<div class="grid h-full min-h-screen w-full auto-cols-fr auto-rows-fr grid-cols-2 gap-6 p-4">
	<NavigationLink
		buttonClass="bg-guidebook text-guidebook-content hover:bg-guidebook-focus"
		class="col-span-2 row-span-1"
		text="Guidebook"
		to="/guide"
	>
		<SvgSprite
			name="guidebook"
			class="flex-grow-1 stroke-guidebook h-16 w-16"
		/>
	</NavigationLink>

	<NavigationLink
		buttonClass="bg-reservations text-reservations-content hover:bg-reservations-focus"
		class="row-span-1"
		text="Reservations"
		to="/reservations"
	>
		<SvgSprite
			class="flex-grow-1 stroke-reservations h-16 w-16"
			name="calendar"
		/>
	</NavigationLink>

	<NavigationLink
		buttonClass="hover:bg-users-focus bg-users text-users-content"
		class="row-span-1"
		text="Users"
		to="/admin/users"
	>
		<SvgSprite
			class="flex-grow-1 fill-users h-16 w-16"
			name="users"
		/>
	</NavigationLink>

	<!-- Activity Card -->
	<div class="col-span-2 row-span-2 rounded-xl bg-purple-600 p-4 text-base-content">
		<div class="mb-4 flex items-center justify-between">
			<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Latest Activity</h3>
		</div>
	</div>

	<NavigationLink
		buttonClass="bg-profile text-profile-content hover:bg-profile-focus"
		class="col-span-1 row-span-1"
		text="Profile"
		to="/profile"
	>
		<div class="avatar">
			<div class="w-20 rounded-full">
				<img
					src="https://flowbite.com/docs/images/people/profile-picture-5.jpg"
					alt="user avatar"
				/>
			</div>
		</div>
	</NavigationLink>

	<div class="col-span-1 row-span-1">
		<ColorSchemeSwitcher />
	</div>

	<!-- <LogoutButton /> -->
</div>

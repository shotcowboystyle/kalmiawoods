---
import { HIGHLIGHTS_DATA } from '@/app/constants';
import SvgSprite from '@/components/SvgSprite.astro';
---

<section class="my-10">
	<div class="w-full sm:container max-xl:overflow-hidden max-xl:px-6">
		<h3 class="mb-4 text-2xl">Highlights</h3>
		<div class="flex flex-row gap-4 py-0">
			{
				HIGHLIGHTS_DATA.map((highlight) => (
					<div
						role="listitem"
						class="item rounded-full border border-gray-300 px-2 py-2 sm:px-4"
					>
						<i class="flex flex-row items-center gap-x-2">
							<SvgSprite
								name={highlight.icon}
								class="h-4 w-4 stroke-black dark:stroke-white"
							/>
							<span class="whitespace-nowrap text-sm leading-6">{highlight.text}</span>
						</i>
					</div>
				))
			}
		</div>
	</div>
</section>

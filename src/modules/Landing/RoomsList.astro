---
import forestEscapeImage from '@/assets/images/photos/forest-escape.jpeg';
import mainHouseImage from '@/assets/images/photos/house-back.jpeg';
import workshopImage from '@/assets/images/photos/workshop-front.jpeg';
import ArrowIcon from '@/components/ArrowIcon.astro';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export interface Rooms {
	link: string;
	title: string;
	description: string;
	roomImage: ImageMetadata;
}

const ROOMS: Rooms[] = [
	{
		link: '/rooms#cozy_cabin',
		title: 'Cozy Cabin',
		description: '$200/Night',
		roomImage: mainHouseImage,
	},
	{
		link: '/rooms#natures_haven',
		title: "Nature's Haven",
		description: '$100/Night',
		roomImage: workshopImage,
	},
	{
		link: '/rooms#forest_escape',
		title: 'Forest Escape',
		description: 'Coming Soon',
		roomImage: forestEscapeImage,
	},
];
---

<section class="relative overflow-hidden">
	<div class="section-inner">
		<div class="container">
			<div class="c-link-list-big">
				<ul class="c-link-list-big__list">
					{
						ROOMS.map(({ link, title, description, roomImage }, idx) => (
							<li class="c-link-list-big__item js-animated-stagger-element">
								<a
									href={link}
									class="c-link-list-big__link"
								>
									<div class="c-link-list-big__image">
										<figure class="c-responsive-image c-responsive-image--background">
											<Picture
												pictureAttributes={{
													class: 'c-responsive-image__inner c-responsive-image__inner--adopt',
												}}
												class="c-responsive-image__img"
												src={roomImage}
												formats={['avif', 'webp']}
												alt={`${title} room at Kalmia Woods`}
												widths={[480, 640, 1140, roomImage.width]}
												sizes="(max-width: 640px) 100vw, 50vw"
												loading="lazy"
											/>
										</figure>
									</div>

									<div class="c-link-list-big__info">
										<div class="c-link-list-big__info-col">
											<h3 class="c-link-list-big__title u-a3">{title}</h3>
											<p class="c-link-list-big__description u-b0">{description}</p>
										</div>

										<div class="c-link-list-big__info-col">
											<span class="c-link-list-big__circle c-button c-button--small u-b0">
												<span>0{idx + 1}</span>
												<ArrowIcon />
											</span>
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

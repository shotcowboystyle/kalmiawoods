---
// import SvgSprite from '@/components/SvgSprite.astro';
import roomsImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import roomsImage2 from '@/assets/images/photos/house-living-area-2.jpeg';
import roomsImage3 from '@/assets/images/photos/house-living-area-3.jpeg';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export interface Rooms {
	link: string;
	title: string;
	description: string;
	roomImage: ImageMetadata;
}

const ROOMS: Rooms[] = [
	{
		link: '#',
		title: 'Cozy Cabin',
		description: '$200/Night',
		roomImage: roomsImage1,
	},
	{
		link: '#',
		title: "Nature's Haven",
		description: '$100/Night',
		roomImage: roomsImage2,
	},
	{
		link: '#',
		title: 'Forest Escape',
		description: 'Coming Soon',
		roomImage: roomsImage3,
	},
];
---

<section class="relative overflow-hidden">
	<div class="section-inner">
		<div class="container">
			<div class="c-link-list-big">
				<ul class="c-link-list-big__list">
					{
						ROOMS.map(({ link, title, description, roomImage }, idx) => (
							<li class="c-link-list-big__item js-animated-stagger-element">
								<a
									href={link}
									class="c-link-list-big__link"
								>
									<div class="c-link-list-big__image">
										<figure class="c-responsive-image c-responsive-image--background">
											<Picture
												pictureAttributes={{
													class: 'c-responsive-image__inner c-responsive-image__inner--adopt',
												}}
												class="c-responsive-image__img"
												src={roomImage}
												formats={['avif', 'webp']}
												alt="A description of my image."
												widths={[640, 1140, 2000, roomImage.width]}
											/>
										</figure>
									</div>

									<div class="c-link-list-big__info">
										<div class="c-link-list-big__info-col">
											<h3 class="c-link-list-big__title u-a3">{title}</h3>
											<p class="c-link-list-big__description u-b0">{description}</p>
										</div>

										<div class="c-link-list-big__info-col">
											<span class="c-link-list-big__circle c-button c-button--small u-b0">
												<span>0{idx + 1}</span>
												<svg
													class="u-icon u-icon--arrow-right"
													viewBox="0 0 12 12"
													xmlns="http://www.w3.org/2000/svg"
												>
													<path d="M6.15464 0L4.91753 1.39175C5.87629 2.90722 7.17526 4.14433 9.68041 5.38144C8.65979 5.38144 8.38144 5.07216 6.89691 5.07216H0V6.92783H6.89691C8.38144 6.92783 8.65979 6.61856 9.68041 6.61856C7.17526 7.85567 5.87629 9.09278 4.91753 10.6082L6.15464 12C7.48453 10.1134 9.12371 8.53608 12 6.92783V5.07216C9.12371 3.46392 7.48453 1.8866 6.15464 0Z" />
												</svg>
											</span>
										</div>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

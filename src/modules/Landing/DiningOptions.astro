---
import ArrowIcon from '@/components/ArrowIcon.astro';
import SectionSeparator from '@/components/SectionSeparator.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

const restaurantsCollection = (await getCollection('restaurants')).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section class="section section--bg-blue relative">
	<SectionSeparator position="top" color="blue" animated />

	<div class="section-inner section-inner-py-xl">
		<div class="container">
			<div class="c-cta-section-a">
				<header class="c-cta-section-a__header">
					<div class="c-animated-big-text u-a5 js-brush-text-scroll">
						<div class="c-animated-big-text__text relative">
							<h2 class="c-animated-big-text__text-line js-text-line">
								Dining options with regional specialities
							</h2>

							<p
								class="c-animated-big-text__text-line c-animated-big-text__text-line--clone js-text-line-clone"
								aria-hidden="true"
								tabindex="-1"
							>
								Dining options with regional specialities
							</p>
						</div>
					</div>

					<p class="c-cta-section-a__description u-b0 js-animated-stagger-element text-center">
						A romantic sunset dinner, a quick afternoon snack, a relaxed family meal – our
						contemporary restaurants suit most occasions - and all with spectacular sea views.
					</p>
				</header>

				<div class="c-cta-section-a__list">
					{
						restaurantsCollection.map((restaurant) => (
							<article class="c-cta-section-a__item js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--3-2',
										}}
										class="c-responsive-image__img"
										src={restaurant.data.image}
										formats={['avif', 'webp']}
										alt={`${restaurant.data.name} teaser`}
										widths={[480, 640, 1140, restaurant.data.image.width]}
										sizes="(max-width: 640px) 100vw, (max-width: 800px) 33vw, 25vw"
										loading="lazy"
									/>
								</figure>

								<h3 class="u-a3 u-fw-400">{restaurant.data.name}</h3>
								<p class="u-b0">{restaurant.data.description}</p>
							</article>
						))
					}
				</div>

				<div class="c-cta-section-a__footer js-animated-stagger-element">
					<a
						href="/dining"
						class="c-cta c-cta--white u-a2"
					>
						<span>Dining locations</span>
						<i class="c-cta__icon">
							<ArrowIcon />
						</i>
					</a>
				</div>
			</div>
		</div>
	</div>

	<SectionSeparator position="bottom" color="blue" animated />
</section>

<style>
	.c-cta-section-a__header {
		--pb: 72px;

		@media (min-width: 480px) {
			--pb: calc(5vw + 48px);
		}

		@media (min-width: 1440px) {
			--pb: 120px;
		}

		@media (min-width: 1920px) {
			--pb: 6.25vw;
		}

		padding-bottom: var(--pb);
	}

	.c-cta-section-a .c-animated-big-text {
		--max-width: 687px;
		--pb: 12px;

		@media (min-width: 480px) {
			--pb: calc(0.8333333333vw + 8px);
		}

		@media (min-width: 1440px) {
			--pb: 20px;
		}

		@media (min-width: 1920px) {
			--pb: 1.0416666667vw;
			--max-width: 35.78125vw;
		}

		max-width: var(--max-width);
		padding-bottom: var(--pb);
		margin-left: auto;
		margin-right: auto;
		color: #043f5d;
	}

	.c-cta-section-a__description {
		--max-width: 480px;

		@media (min-width: 1920px) {
			--max-width: 25vw;
		}

		max-width: var(--max-width);
		margin-left: auto;
		margin-right: auto;
		color: #f7f7ee;
	}

	.c-cta-section-a__list {
		display: grid;
		grid-template-columns: repeat(22, 1fr);
	}

	@media (max-width: 800px) {
		.c-cta-section-a__list {
			gap: 20px;
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 640px) {
		.c-cta-section-a__list {
			grid-template-columns: 1fr;
		}
	}

	.c-cta-section-a__item {
		&:nth-child(1) {
			grid-column: span 5;
		}

		&:nth-child(2) {
			--margin-top: 80px;

			@media (min-width: 480px) {
				--margin-top: calc(8.3333333333vw + 40px);
			}

			@media (min-width: 1440px) {
				--margin-top: 160px;
			}

			@media (min-width: 1920px) {
				--margin-top: 8.3333333333vw;
			}

			margin-top: var(--margin-top);
			grid-column: 12/17;
		}

		&:nth-child(3) {
			--margin-top: -10px;

			@media (min-width: 1920px) {
				--margin-top: -0.5208333333vw;
			}

			margin-top: var(--margin-top);
			grid-column: 18/23;
		}
	}

	@media (max-width: 1140px) {
		.c-cta-section-a__item:nth-child(1) {
			grid-column: span 6;
		}
	}

	@media (max-width: 800px) {
		.c-cta-section-a__item:nth-child(1) {
			grid-column: span 1;
		}
	}

	@media (max-width: 1140px) {
		.c-cta-section-a__item:nth-child(2) {
			grid-column: 10/16;
		}
	}

	@media (max-width: 800px) {
		.c-cta-section-a__item:nth-child(2) {
			margin-top: 0;
			grid-column: span 1;
		}
	}

	@media (max-width: 1140px) {
		.c-cta-section-a__item:nth-child(3) {
			grid-column: 17/23;
		}
	}

	@media (max-width: 800px) {
		.c-cta-section-a__item:nth-child(3) {
			margin-top: 0;
			grid-column: span 1;
		}
	}

	.c-cta-section-a__item figure {
		--border-radius: 20px;
		--margin-bottom: 20px;

		@media (min-width: 480px) {
			--margin-bottom: calc(1.25vw + 14px);
		}

		@media (min-width: 1440px) {
			--margin-bottom: 32px;
		}

		@media (min-width: 1920px) {
			--margin-bottom: 1.6666666667vw;
			--border-radius: 1.0416666667vw;
		}

		border-radius: var(--border-radius);
		margin-bottom: var(--margin-bottom);
		overflow: hidden;
	}

	.c-cta-section-a__item h3 {
		--padding-bottom: 8px;

		@media (min-width: 480px) {
			--padding-bottom: 8px;
		}

		@media (min-width: 1440px) {
			--padding-bottom: 8px;
		}

		@media (min-width: 1920px) {
			--padding-bottom: 0.4166666667vw;
		}

		padding-bottom: var(--padding-bottom);
		color: #e3e3c4;
	}

	.u-fw-400,
	.u-fw-normal,
	.u-fw-regular {
		font-weight: 400;
	}

	.c-content-editor h2,
	.u-a3 {
		--font-size: 30px;

		@media (min-width: 480px) {
			--font-size: calc(1.0416666667vw + 25px);
		}

		@media (min-width: 1440px) {
			--font-size: 40px;
		}

		@media (min-width: 1920px) {
			--font-size: 2.0833333333vw;
		}

		font-size: var(--font-size);
		font-family: 'PP Woodland', serif;
		line-height: 120%;
		letter-spacing: -0.03em;
	}

	.c-cta-section-a__item p {
		color: #f7f7ee;
	}

	.c-cta-section-a__footer {
		--margin-top: 72px;

		@media (min-width: 480px) {
			--margin-top: calc(5vw + 48px);
		}

		@media (min-width: 1440px) {
			--margin-top: 120px;
		}

		@media (min-width: 1920px) {
			--margin-top: 6.25vw;
		}

		margin-top: var(--margin-top);
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.c-cta {
		--gap: 20px;

		@media (min-width: 1920px) {
			--gap: 1.0416666667vw;
		}

		gap: var(--gap);
		display: inline-flex;
		align-items: center;
		color: #5b6647;
	}

	.section--bg-blue .c-cta {
		color: #f7f7ee;
	}

	.section--bg-blue .c-cta .c-cta__icon {
		background-color: #f7f7ee;
	}

	.c-cta__icon {
		height: 1em;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		width: 1.9230769231em;
		border-radius: 2em;
		overflow: hidden;
		background-color: #5b6647;
		transition: all 0.2s cubic-bezier(0.55, 0.085, 0.68, 0.53);
	}
</style>

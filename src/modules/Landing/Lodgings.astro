---
import houseBgImage from '@/assets/images/photos/house-living-area-1.jpeg';
import treehouseBgImage from '@/assets/images/photos/house-living-area-2.jpeg';
import workshopBgImage from '@/assets/images/photos/house-living-area-3.jpeg';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Rooms {
	link: string;
	title: string;
	description: string;
	backgroundImg: ImageMetadata;
}

const ROOMS: Rooms[] = [
	{
		link: '#',
		title: 'Cozy Cabin',
		description: '$200/Night',
		backgroundImg: houseBgImage,
	},
	{
		link: '#',
		title: "Nature's Haven",
		description: '$100/Night',
		backgroundImg: workshopBgImage,
	},
	{
		link: '#',
		title: 'Forest Escape',
		description: 'Coming Soon',
		backgroundImg: treehouseBgImage,
	},
];

// const optimizedhouseBgImage = await getImage({src: houseBgImage, format: 'avif'});
---

<section class="section bg-base-100 relative h-screen">
	<div class="mx-16 flex h-full flex-col justify-center">
		<div class="section-text container mb-32">
			<h3 class="text-xs">Rooms</h3>
			<p class="h3 text-white">Our unique rooms within the retreat</p>
		</div>

		<div class="flex h-[600px] max-h-min w-full gap-x-4 px-0">
			{
				ROOMS.map(({ link, title, description, backgroundImg }) => (
					<a
						href={link}
						class="h-full max-h-min w-full"
					>
						<div class="relative h-full w-full transform overflow-hidden rounded-3xl shadow-lg transition duration-200 hover:-translate-y-2 hover:shadow-2xl">
							<Image
								class="h-full w-full object-cover"
								src={backgroundImg}
								alt=""
								widths={[640, 828, 2400, houseBgImage.width]}
							/>
							<div class="absolute inset-0 flex max-w-[20ch] flex-col justify-end px-6">
								<h3 class="h3 mb-1 font-bold text-white">{title}</h3>
								<p class="mb-4 text-sm tracking-wide text-white">{description}</p>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.section-bg-image {
		mask-position: top;
	}
</style>

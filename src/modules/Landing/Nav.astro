---
import { BASE_APP_URL } from '@/app/constants';
import SvgSprite from '@/components/SvgSprite.astro';

export interface Props {
	isHomepage?: boolean;
	useLightNavigation?: boolean;
}

const { isHomepage, useLightNavigation } = Astro.props as Props;
---

<nav
	id="nav"
	class:list={['o-navigation js-navigation', { 'is-homepage': isHomepage }]}
>
	<div class="container">
		<div
			class:list={['c-navigation flex items-center', { 'c-navigation--light': useLightNavigation }]}
		>
			<div class="c-navigation__hamburger c-navigation__fade-in c-navigation__fade-in--1">
				<button
					id="nav-hamburger"
					class="c-hamburger c-hamburger--slider js-hamburger"
					type="button"
					aria-label="Menu"
				>
					<span class="c-hamburger__box">
						<span class="c-hamburger__inner"></span>
					</span>
				</button>
			</div>

			<div class="c-navigation__logo-wrapper">
				<div class="c-navigation__logo">
					<a
						href={BASE_APP_URL}
						aria-label="logo"
					>
						<SvgSprite
							name="logo-dark-center"
							class="u-icon u-icon--logo js-navigation-logo"
						/>
					</a>
				</div>
			</div>

			<div class="c-navigation__items">
				<div class="c-navigation__fade-in c-navigation__fade-in--2">
					<a
						href="#coming_soon"
						target="_blank"
						class="c-button c-button--secondary"
					>
						<span>Online Check-in</span>
					</a>
				</div>

				<div class="c-navigation__fade-in c-navigation__fade-in--3">
					<a
						href="/book_now"
						target="_blank"
						class="c-button"
					>
						<span>Book now</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</nav>

<style>
	.o-navigation {
		position: fixed;
		left: 0;
		top: 0;
		width: 100%;
		z-index: 10;
		transition: all 0.3s cubic-bezier(0.39, 0.575, 0.565, 1);

		&:before {
			content: '';
			display: block;
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			border-bottom: 1px solid #d4d4b9;
			opacity: 0;
			transition: all 0.3s cubic-bezier(0.39, 0.575, 0.565, 1);
		}

		&.is-homepage {
			opacity: 0;
		}

		&.has-loaded {
			opacity: 1;
		}

		&.has-scrolled {
			background-color: #f7f7ee;
			transition:
				all 0.3s cubic-bezier(0.39, 0.575, 0.565, 1),
				background 0.3s 0.3s cubic-bezier(0.39, 0.575, 0.565, 1);

			&:before {
				opacity: 1;
				transition-delay: 0.3;
			}
		}

		&.slide-up {
			transform: translateY(-100%);
		}
	}

	.c-navigation {
		--py: 12px;
		--height: 80px;

		@media screen(sm) {
			--py: calc(0.8333333333vw + 8px);
		}

		@media screen(lg) {
			--py: 20px;
		}

		@media screen(xl) {
			--height: 4.6875vw;
			--py: 1.0416666667vw;
		}

		padding-top: var(--py);
		padding-bottom: var(--py);
		height: var(--height);
		display: grid;
		align-items: center;
		grid-template-columns: 1fr 1fr;
		position: relative;
	}

	.c-navigation__hamburger {
		transition-delay: 0.2s;
	}

	.is-homepage .c-navigation__fade-in {
		opacity: 0;
		visibility: hidden;
		transform: translateY(-10px);
	}

	.is-homepage.has-loaded .c-navigation__fade-in {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.c-navigation__fade-in--1 {
		transition: 0.6s 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.c-navigation__fade-in--2 {
		transition: 0.6s 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.c-navigation__fade-in--3 {
		transition: 0.6s 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.c-navigation__logo-wrapper {
		--py: 12px;

		@media screen(sm) {
			--py: calc(0.8333333333vw + 8px);
		}

		padding-top: var(--py);
		padding-bottom: var(--py);
		position: absolute;
		top: 0;
		left: 50%;
		height: 100%;
		width: auto;
		display: flex;
		justify-content: center;
		align-items: center;
		transform: translateX(-50%);
	}

	.c-navigation__logo {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.c-navigation__logo .u-icon {
		--height: 32px;

		@media screen(sm) {
			--height: 40px;
		}

		@media screen(lg) {
			--height: 50px;
		}

		height: var(--height);
		width: auto;
	}

	.c-navigation__items {
		--gap: 8px;

		@media screen(sm) {
			--gap: calc(0.4166666667vw + 6px);
		}

		gap: var(--gap);
		margin-left: auto;
		display: flex;
		align-items: center;
	}

	@media (max-width: 800px) {
		.c-navigation__items .c-button--secondary {
			display: none;
		}
	}
</style>

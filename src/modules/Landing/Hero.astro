---
import heroBg from '@/assets/images/hero/background.png';
import heroForest from '@/assets/images/hero/home-header-forest.png';
import heroLandscape from '@/assets/images/hero/home-header-landscape.png';
import heroMountains from '@/assets/images/hero/home-header-mountains.png';
import heroSky from '@/assets/images/hero/home-header-sky.png';
import { Image } from 'astro:assets';
---

<header
	id="hero-section"
	class="c-home-header js-home-header"
>
	<div class="c-home-header__image-wrapper c-parallax-header__wrapper js-home-header-image-wrapper">
		<Image
			src={heroBg}
			alt=""
			widths={[640, 828, 2400, heroBg.width]}
			class="parallax-layer absolute inset-0 h-full w-full object-cover"
		/>

		<Image
			src={heroSky}
			alt=""
			widths={[640, 828, 2400, heroSky.width]}
			class="parallax-layer parallax__sky__layer absolute inset-0 h-full w-full object-cover"
		/>

		<Image
			src={heroMountains}
			alt=""
			widths={[640, 828, 2400, heroMountains.width]}
			class="parallax-layer parallax__mountain__layer absolute inset-0 h-full w-full object-cover"
		/>

		<Image
			src={heroLandscape}
			alt=""
			widths={[640, 828, 2400, heroLandscape.width]}
			class="parallax-layer parallax__landscape__layer absolute inset-0 h-full w-full object-cover"
		/>

		<Image
			src={heroForest}
			alt=""
			widths={[640, 828, 2400, heroForest.width]}
			class="parallax-layer parallax__forest__layer absolute inset-0 h-full w-full object-cover"
		/>
	</div>
</header>

<script>
	import { parallaxScroll } from '@/utils/parallax';
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const parallaxOffset = (index: number) => (3.45 * 50) / (index >= 2 ? index : 1.75);

	const initHeaderTilt = () => {
		const parallaxContainer = document.getElementById('hero-section');
		if (parallaxContainer) {
			const parallaxImages = gsap.utils.toArray('.parallax-layer');
			parallaxImages.forEach((image, index) => {
				parallaxScroll(image as HTMLElement, parallaxContainer, parallaxOffset(index));
			});
		}
	};

	const init = () => {
		initHeaderTilt();
	};

	init();
</script>

<style>
	@reference "tailwindcss";

	#hero-section {
		position: relative;
		height: 100vh;
		width: 100%;
		perspective: 1px;
		perspective-origin: center;
		overflow-x: hidden;
	}

	.c-parallax-header__wrapper {
		@apply absolute inset-0 h-full w-full;
	}

	.parallax-layer {
		transform-style: preserve-3d;
		will-change: transform;
	}
</style>

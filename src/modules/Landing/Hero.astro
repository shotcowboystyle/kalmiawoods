---
import heroBgImage from '@/assets/images/landing-cover-photo.jpeg';
import GradientText from '@/components/typography/GradientText.astro';
import { Picture } from 'astro:assets';
---

<section class="relative h-screen">
	<div class="absolute z-10 h-4/6 w-full bg-gradient-to-b from-black"></div>
	<div class="absolute bottom-0 left-0 right-0 top-0 m-0 block overflow-hidden">
		<Picture
			src={heroBgImage}
			alt="Kalmia Woods scenic view"
			class="h-screen w-screen object-cover object-top xl:h-full"
			formats={['avif', 'webp']}
			widths={[640, 750, 828, 1080, 1200, heroBgImage.width]}
		/>
	</div>
	<div class="max-w-2xl">
		<div class="absolute left-0 right-0 top-[35%] z-10">
			<div class="text-center text-white">
				<div>
					<h1 class="mx-auto max-w-lg px-4 text-2xl font-bold xl:text-4xl">
						<div>Welcome to</div>
						<span class="text-6xl font-extrabold xl:text-8xl">
							<GradientText>{import.meta.env.APP_NAME}</GradientText>
						</span>
					</h1>
					<p class="mx-auto max-w-lg py-2">
						Our cabin is located in the heart of the Keowee-Toxaway wilderness of Oconee County.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

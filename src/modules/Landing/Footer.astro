<style>
	.c-footer {
		--pb: 24px;
		--pt: 56px;

		@media (min-width: 1920px) {
			--pb: 2.0833333333vw;
			--pt: 4.1666666667vw;
		}

		@media (min-width: 1440px) {
			--pb: 40px;
			--pt: 80px;
		}
		@media (min-width: 480px) {
			--pb: calc(1.6666666667vw + 16px);
			--pt: calc(2.5vw + 44px);
		}

		padding-bottom: var(--pb);
		padding-top: var(--pt);
		background-color: #03364f;
		position: relative;
		overflow: hidden;
	}

	.c-footer__header {
		--pb: 72px;

		@media screen(xl) {
			--pb: 6.25vw;
		}
		@media screen(lg) {
			--pb: 120px;
		}
		@media screen(sm) {
			--pb: calc(5vw + 48px);
		}

		padding-bottom: var(--pb);
		display: grid;
		grid-template-columns: 1fr 2fr 1fr;
		place-items: center;
	}

	.c-footer__logo {
		grid-column: 2/3;
	}

	.c-footer__logo .u-icon {
		display: block;
		width: 100%;
	}

	.c-footer__alh-logo {
		grid-column: 3/4;
		margin-left: auto;
	}

	.c-footer__alh-logo a {
		--width: 60px;

		@media screen(xl) {
			--width: 3.125vw;
		}

		width: var(--width);
		display: block;
	}

	.u-a1 {
		--font-size: 18px;

		@media screen(xl) .u-a1 {
			--font-size: 0.9375vw;
		}
		@media screen(lg) .u-a1 {
			--font-size: 18px;
		}
		@media screen(sm) .u-a1 {
			--font-size: 18px;
		}

		font-size: var(--font-size);
		font-family: 'DM Sans', sans-serif;
		line-height: 110%;
		letter-spacing: -0.02em;
	}
	.c-footer__info-list {
		--pb: 12px;
		--mb: 96px;

		@media screen(xl) {
			--pb: 1.0416666667vw;
			--mb: 9.5833333333vw;
		}
		@media screen(lg) {
			--pb: 20px;
			--mb: 184px;
		}
		@media screen(sm) {
			--pb: calc(0.8333333333vw + 8px);
			--mb: calc(9.1666666667vw + 52px);
		}

		padding-bottom: var(--pb);
		margin-bottom: var(--mb);
		color: #f7f7ee;
		display: grid;
		gap: 4.1666666667vw;
		grid-template-columns: 31.8181818182% 27.2727272727% 31.8181818182%;
		border-bottom: 1px solid #05496b;
	}

	.c-footer__info-item {
		display: flex;
		align-items: center;
		transition: opacity 0.2s ease-out;

		&:nth-child(3) {
			justify-content: flex-end;
		}
	}

	.c-footer__nav {
		--row-gap: 16px;
		--pb: 72px;

		@media screen(xl) {
			--pb: 6.25vw;
			--row-gap: 0.8333333333vw;
		}
		@media screen(lg) {
			--pb: 120px;
		}

		@media screen(sm) {
			--pb: calc(5vw + 48px);
		}

		row-gap: var(--row-gap);
		padding-bottom: var(--pb);
		color: #f7f7ee;
		column-gap: 4.1666666667vw;
		display: grid;
		align-items: center;
		grid-template-columns: 31.8181818182% 27.2727272727% 31.8181818182%;
	}

	.c-footer__nav-item {
		display: flex;
		align-items: center;

		&:nth-of-type(3n + 2) {
			justify-content: center;
		}

		&:nth-of-type(3n + 3) {
			justify-content: flex-end;
		}
	}

	.c-footer__nav-item a {
		transition: opacity 0.2s ease-out;
	}

	.c-footer__nav-separator {
		grid-column: 1/-1;
		display: block;
		height: 1px;
		width: 100%;
		background-color: #05496b;
	}

	.u-b1 {
		--font-size: 13px;

		@media screen(xl) {
			--font-size: 0.6770833333vw;
		}

		font-size: var(--font-size);
		font-family: 'DM Sans', sans-serif;
		line-height: 130%;
		letter-spacing: -0.02em;
	}

	.c-footer__bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: rgba(247, 247, 238, 0.6);
	}
</style>

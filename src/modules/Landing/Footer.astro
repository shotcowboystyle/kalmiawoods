---
import { BASE_APP_URL, CONTACT_INFO } from '@/app/constants';
import SvgSprite from '@/components/SvgSprite.astro';
---

<footer
	id="footer"
	class="c-footer js-animated-content"
	data-swap="footer"
>
	<div class="c-bg-shape c-bg-shape--top">
		<svg
			class="u-icon u-icon--shape-blue-1"
			viewBox="0 0 1440 780"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				fill-rule="evenodd"
				clip-rule="evenodd"
				d="M391.76 206.372C398.561 257.577 422.989 333.816 564.264 307.142C623.961 295.87 672.971 246.349 725.851 192.917C798.112 119.9 877.602 39.5799 1001.47 39.5799C1020.03 39.5799 1045.16 44.9126 1072.57 50.73C1117.77 60.2253 1171.78 75.3692 1217.1 58.8446C1235.02 52.3131 1251.54 29.2773 1269.26 0H1440V757.5C1409.35 752.861 1330.28 742.392 1297.5 780H962.5C1253.14 611 992 438 927 557.5C901.437 604.497 858 780 629.5 780H0V0H234.397C255.086 12.6598 283.808 20.9856 336.62 15.677C379.328 15.677 422.989 38.5147 422.989 81.0731C422.989 99.9999 415.468 116.747 407.713 134.014C398.519 158.147 388.212 179.658 391.76 206.372Z"
				fill="url(#liner-grad-654)"
			></path>
			<defs>
				<linearGradient
					id="liner-grad-654"
					x1="1374.09"
					y1="454.721"
					x2="24.9217"
					y2="461.887"
					gradientUnits="userSpaceOnUse"
				>
					<stop stop-color="#043F5D"></stop>
					<stop
						offset="1"
						stop-color="#022B40"
					></stop>
				</linearGradient>
			</defs>
		</svg>
	</div>

	<div class="relative container">
		<div class="c-footer__header js-animated-content-element">
			<div class="c-footer__logo">
				<a href={BASE_APP_URL}>
					<SvgSprite
						name="logo-light-center"
						class="u-icon u-icon--logo-footer"
					/>
				</a>
			</div>
		</div>

		<div class="c-footer__info-list u-a1 js-animated-content-element js-focus-shifting uppercase">
			<!-- <div class="c-footer__info-item js-focus-shifting-item">
				<p>Pomena 16, 20226, Pomena, Croatia</p>
			</div> -->

			<div class="c-footer__info-item js-focus-shifting-item">
				<a
					href={`mailto:${CONTACT_INFO.reservations.email}`}
					target="_blank"
				>
					{CONTACT_INFO.reservations.email}
				</a>
			</div>

			<div class="c-footer__info-item js-focus-shifting-item is-focused">
				<a
					href={`tel:${CONTACT_INFO.reservations.phone}`}
					target="_blank"
				>
					{CONTACT_INFO.reservations.phone}
				</a>
			</div>
		</div>

		<ul class="c-footer__nav u-a1 js-animated-content-element js-focus-shifting uppercase">
			<li class="c-footer__nav-item">
				<a
					href="#hello"
					target=""
					class="js-focus-shifting-item"
				>
					Facebook
				</a>
			</li>
			<li class="c-footer__nav-item">
				<a
					href="#hello"
					target=""
					class="js-focus-shifting-item"
				>
					Instagram
				</a>
			</li>
			<li class="c-footer__nav-item">
				<a
					href="#hello"
					target=""
					class="js-focus-shifting-item"
				>
					Pinterest
				</a>
			</li>
			<i class="c-footer__nav-separator"></i>
			<li class="c-footer__nav-item">
				<a
					href="/contact"
					class="js-focus-shifting-item"
				>
					Contact Us
				</a>
			</li>
			<li class="c-footer__nav-item">
				<a
					href="/privacy"
					target=""
					class="js-focus-shifting-item"
				>
					Privacy Policy and Cookies
				</a>
			</li>
			<!-- {
				secondaryLinks.map(({ text, href }) => (
					<a
						class="text-muted mr-2 transition duration-150 ease-in-out hover:text-gray-700 hover:underline rtl:ml-2 rtl:mr-0 dark:text-gray-400"
						href={href}
						set:html={text}
					/>
				))
			} -->
		</ul>

		<div class="c-footer__bottom u-b1 js-animated-content-element">
			<p>Kalmia Woods, LLC All Rights Reserved</p>
			<p>
				Design &amp; Developement by <a
					href="https://shotcowboystyle.github.io"
					target="_blank"
					>SHOTCOWBOYSTYLE</a
				>
			</p>
		</div>
	</div>
</footer>

<style>
	.c-footer {
		--pb: 24px;
		--pt: 56px;

		@media (min-width: 1920px) {
			--pb: 2.0833333333vw;
			--pt: 4.1666666667vw;
		}

		@media (min-width: 1440px) {
			--pb: 40px;
			--pt: 80px;
		}
		@media (min-width: 480px) {
			--pb: calc(1.6666666667vw + 16px);
			--pt: calc(2.5vw + 44px);
		}

		padding-bottom: var(--pb);
		padding-top: var(--pt);
		background-color: #03364f;
		position: relative;
		overflow: hidden;
	}

	@media (max-width: 800px) {
		.c-footer .c-bg-shape {
			min-height: 100%;
		}
	}

	@media (max-width: 800px) {
		.c-footer .c-bg-shape .u-icon {
			height: 100%;
			width: auto;
			position: absolute;
		}
	}

	.c-footer__header {
		--pb: 72px;

		@media (min-width: 480px) {
			--pb: calc(5vw + 48px);
		}

		@media (min-width: 1440px) {
			--pb: 120px;
		}

		@media (min-width: 1920px) {
			--pb: 6.25vw;
		}

		padding-bottom: var(--pb);
		display: grid;
		grid-template-columns: 1fr 2fr 1fr;
		place-items: center;
	}

	@media (max-width: 800px) {
		.c-footer__header {
			gap: 24px;
		}
	}

	.c-footer__logo {
		grid-column: 2/3;
	}

	.c-footer__logo .u-icon {
		display: block;
		width: 100%;
		max-height: 44px;
	}

	.c-footer__alh-logo {
		grid-column: 3/4;
		margin-left: auto;
	}

	.c-footer__alh-logo a {
		--width: 60px;

		@media (min-width: 1920px) {
			--width: 3.125vw;
		}

		width: var(--width);
		display: block;
	}

	.u-a1 {
		--font-size: 18px;

		@media (min-width: 480px) .u-a1 {
			--font-size: 18px;
		}

		@media (min-width: 1440px) .u-a1 {
			--font-size: 18px;
		}

		@media (min-width: 1920px) .u-a1 {
			--font-size: 0.9375vw;
		}

		font-size: var(--font-size);
		font-family: 'DM Sans', sans-serif;
		line-height: 110%;
		letter-spacing: -0.02em;
	}
	.c-footer__info-list {
		--pb: 12px;
		--mb: 96px;

		@media (min-width: 1920px) {
			--pb: 1.0416666667vw;
			--mb: 9.5833333333vw;
		}
		@media (min-width: 1440px) {
			--pb: 20px;
			--mb: 184px;
		}
		@media (min-width: 480px) {
			--pb: calc(0.8333333333vw + 8px);
			--mb: calc(9.1666666667vw + 52px);
		}

		padding-bottom: var(--pb);
		margin-bottom: var(--mb);
		color: #f7f7ee;
		display: grid;
		gap: 4.1666666667vw;
		grid-template-columns: 31.8181818182% 27.2727272727% 31.8181818182%;
		border-bottom: 1px solid #05496b;
	}

	@media (max-width: 640px) {
		.c-footer__info-list {
			gap: 16px;
			grid-template-columns: 1fr;
		}
	}

	.c-footer__info-item {
		display: flex;
		align-items: center;
		transition: opacity 0.2s ease-out;

		&:nth-child(2) {
			justify-content: center;
		}

		&:nth-child(3) {
			justify-content: flex-end;
		}
	}

	.c-footer__nav {
		--row-gap: 16px;
		--pb: 72px;

		@media (min-width: 480px) {
			--pb: calc(5vw + 48px);
		}

		@media (min-width: 1440px) {
			--pb: 120px;
		}

		@media (min-width: 1920px) {
			--pb: 6.25vw;
			--row-gap: 0.8333333333vw;
		}

		row-gap: var(--row-gap);
		padding-bottom: var(--pb);
		color: #f7f7ee;
		column-gap: 4.1666666667vw;
		display: grid;
		align-items: center;
		grid-template-columns: 31.8181818182% 27.2727272727% 31.8181818182%;
	}

	@media (max-width: 640px) {
		.c-footer__nav {
			grid-template-columns: 1fr 1fr;
		}
	}

	.c-footer__nav-item {
		display: flex;
		align-items: center;

		&:nth-of-type(3n + 2) {
			justify-content: center;
		}

		&:nth-of-type(3n + 3) {
			justify-content: flex-end;
		}
	}

	@media (max-width: 640px) {
		.c-footer__nav-item:nth-of-type(3n + 2) {
			justify-content: flex-start;
		}

		.c-footer__nav-item:nth-of-type(3n + 3) {
			justify-content: flex-start;
		}
	}

	.c-footer__nav-item a {
		transition: opacity 0.2s ease-out;
	}

	.c-footer__nav-separator {
		grid-column: 1/-1;
		display: block;
		height: 1px;
		width: 100%;
		background-color: #05496b;
	}

	@media (max-width: 640px) {
		.c-footer__nav-separator {
			display: none;
		}
	}

	.u-b1 {
		--font-size: 13px;

		@media (min-width: 1920px) {
			--font-size: 0.6770833333vw;
		}

		font-size: var(--font-size);
		font-family: 'DM Sans', sans-serif;
		line-height: 130%;
		letter-spacing: -0.02em;
	}

	.c-footer__bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: rgba(247, 247, 238, 0.6);
	}

	@media (max-width: 640px) {
		.c-footer__bottom {
			flex-direction: column;
			gap: 1em;
		}
	}
</style>

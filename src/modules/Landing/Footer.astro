import SvgSprite from '@/components/SvgSprite.astro';

// import { Picture } from 'astro:assets';

interface Link {
	text?: string;
	href?: string;
	ariaLabel?: string;
	icon?: string;
}

export interface Props {
	secondaryLinks: Array<Link>;
	footNote?: string;
}

const { secondaryLinks = [] } = Astro.props;

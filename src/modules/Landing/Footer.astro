				fill="url(#liner-grad-654)"
			></path>
			<defs>
				<linearGradient
					id="liner-grad-654"
					x1="1374.09"
					y1="454.721"
					x2="24.9217"
					y2="461.887"
					gradientUnits="userSpaceOnUse"
				>
					<stop stop-color="#043F5D"></stop>
					<stop
						offset="1"
						stop-color="#022B40"
					></stop>
				</linearGradient>
			</defs>
		</svg>
	</div>

	<div class="container relative">
		<div class="c-footer__header js-animated-content-element">
			<div class="c-footer__logo">
				<a href="https://kalmiawoods.com">
					<SvgSprite
						name="logo-light-center"
						class="u-icon u-icon--logo-footer"
					/>
				</a>
			</div>

			<!-- <div class="c-footer__alh-logo">
				<a href="https://www.adriaticluxuryhotels.com/">
					<figure class="c-responsive-image">
						<Picture
							pictureAttributes={{
								class: 'c-responsive-image__inner c-responsive-image__inner--3-2',
							}}
							class="c-responsive-image__img object-contain"
							src={roomsImage1}
							formats={['avif', 'webp']}
							alt="A description of my image."
							widths={[640, 1140, 2000, roomsImage1.width]}
						/>
					</figure>
				</a>
			</div> -->
		</div>

		<div class="c-footer__info-list u-a1 js-animated-content-element js-focus-shifting uppercase">
			<!-- <div class="c-footer__info-item js-focus-shifting-item">
				<p>Pomena 16, 20226, Pomena, Croatia</p>
			</div> -->

			<div class="c-footer__info-item js-focus-shifting-item">
				<a
					href="mailto:RESERVATIONS@KALMIAWOODS.COM"
					target="_blank"
				>
					RESERVATIONS@KALMIAWOODS.COM
				</a>
			</div>

			<div class="c-footer__info-item js-focus-shifting-item is-focused">
				<a
					href="tel:+8437611111"
					target=""
				>
					+1 843 761 1111
				</a>
			</div>
		</div>

		<ul class="c-footer__nav u-a1 js-animated-content-element js-focus-shifting uppercase">
			<li class="c-footer__nav-item">
				<a
					href="#hello"
					target=""
					class="js-focus-shifting-item"
				>
					Facebook
				</a>
			</li>
			<li class="c-footer__nav-item">
				<a
					href="#hello"
					target=""
					class="js-focus-shifting-item"
				>
					Instagram
				</a>
			</li>
			<li class="c-footer__nav-item">
				<a
					href="#hello"
					target=""
					class="js-focus-shifting-item"
				>
					Pinterest
				</a>
			</li>
			<i class="c-footer__nav-separator"></i>
			<li class="c-footer__nav-item">
				<a
					href="#hello"
					target=""
					class="js-focus-shifting-item"
				>
					Contact Us
				</a>
			</li>
			<li class="c-footer__nav-item">
				<a
					href="/privacy"
					target=""
					class="js-focus-shifting-item"
				>
					Privacy Policy and Cookies
				</a>
			</li>
			{
				secondaryLinks.map(({ text, href }) => (
					<a
						class="text-muted mr-2 transition duration-150 ease-in-out hover:text-gray-700 hover:underline rtl:ml-2 rtl:mr-0 dark:text-gray-400"
						href={href}
						set:html={text}
					/>
				))
			}
		</ul>

		<div class="c-footer__bottom u-b1 js-animated-content-element">
			<p>Kalmia Woods, LLC All Rights Reserved</p>
			<p>
				Design &amp; Developement by <a
					href="https://shotcowboystyle.github.io"
					target="_blank"
					>Shotcowboystyle</a
				>
			</p>
			<!-- <Fragment set:html={footNote} /> -->
		</div>
	</div>
</footer>


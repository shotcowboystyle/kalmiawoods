---
import destinationOconeeImage from '@/assets/images/destination-oconee.jpeg';
import devilsForkStateParkBeachImage from '@/assets/images/devils-fork-state-park-beach.jpg';
import lakeJocasseeImage from '@/assets/images/lake-jocassee-2.png';
import whitewaterFallsImage from '@/assets/images/upper-whitewater-falls.jpg';
import { Picture } from 'astro:assets';
---

<section class="section section--bg-green js-bg-shape-animation-module">
	<div class="c-section-background js-parallax-wrapper">
		<figure class="c-responsive-image">
			<Picture
				pictureAttributes={{
					class: 'c-responsive-image__inner c-responsive-image__inner--16-9-mobile-1-1',
				}}
				class="c-responsive-image__img js-parallax-item"
				src={lakeJocasseeImage}
				formats={['avif', 'webp']}
				alt="Lake Jocassee"
				widths={[640, 1140, 2000, lakeJocasseeImage.width]}
			/>
		</figure>

		<div
			class="c-section-separator js-section-separator c-section-separator--top c-section-separator--green"
		>
			<svg
				class="u-icon u-icon--separator-main js-section-separator-main js-section-separator-svg"
				viewBox="0 0 3876 160"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M-174.61 -157V-116.765C-174.61 15.4344 -112.186 139 -3.49988 139C111 139 138.787 62.2189 249.697 62.2189C360.606 62.2189 356 156.175 533.698 156.175C683 156.175 698.557 75.6322 817.699 62.2189C930.436 49.5265 988.565 138.856 1101.7 138.856C1214.83 138.856 1274.79 62.2189 1385.7 62.2189C1496.61 62.2189 1556.57 138.856 1669.7 138.856C1782.84 138.856 1842.79 62.2189 1953.7 62.2189C2064.61 62.2189 2124.57 138.856 2237.7 138.856C2350.84 138.856 2408.57 62.2188 2521.7 62.2189C2634.84 62.2189 2694.8 138.856 2805.71 138.856C2916.61 138.856 2976.57 62.2189 3089.71 62.2189C3202.84 62.2188 3260.57 138.856 3373.71 138.856C3486.84 138.856 3546.8 62.2189 3657.71 62.2189C3768.62 62.2189 3867.02 222.761 3941.71 108.856C3998.61 22.0779 3941.71 -157 3941.71 -157H-174.61Z"
				></path>
			</svg>

			<svg
				class="u-icon u-icon--separator-secondary js-section-separator-secondary js-section-separator-svg"
				viewBox="0 0 3876 160"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M-196.61 0V21.1232C-196.61 90.5281 -148.913 67.6768 -101.5 115.09C-14.9999 201.59 116.787 115.09 227.697 115.09C338.606 115.09 400.788 152.442 511.698 152.442C622.607 152.442 676.557 122.132 795.699 115.09C908.436 108.426 966.566 155.325 1079.7 155.325C1192.83 155.325 1252.79 115.09 1363.7 115.09C1474.61 115.09 1534.57 155.325 1647.7 155.325C1760.84 155.325 1820.79 115.09 1931.7 115.09C2042.61 115.09 2102.57 155.325 2215.7 155.325C2328.84 155.325 2386.57 115.09 2499.7 115.09C2612.84 115.09 2672.8 155.325 2783.71 155.325C2894.61 155.325 2954.57 115.09 3067.71 115.09C3180.84 115.09 3238.57 155.325 3351.71 155.325C3464.84 155.325 3524.8 115.09 3635.71 115.09C3746.62 115.09 3845.02 185.125 3919.71 125.325C3976.61 79.7659 3919.71 0 3919.71 0H-196.61Z"
				></path>
			</svg>
		</div>
	</div>

	<div class="section-inner section-inner-py-xl">
		<div class="c-bg-shape c-bg-shape--bottom">
			<svg
				class="u-icon u-icon--shape-1 js-bg-shape-animation-svg"
				viewBox="0 0 1440 1017"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<defs>
					<linearGradient
						id="liner-grad-261"
						x1="208.5"
						y1="731.5"
						x2="405.776901"
						y2="432.937"
						gradientUnits="userSpaceOnUse"
					>
						<stop stop-color="#667250"></stop>
						<stop
							offset="1"
							stop-color="#535D41"
						></stop>
					</linearGradient>
				</defs>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M963.477 409.39C968.721 451.82 942.495 506.547 847.842 512.901C797.88 516.256 757.023 498.349 703.714 466.514C630.866 423.012 550.729 375.158 451.932 400.854C437.132 404.703 418.474 414.595 397.552 424.534C325 459 209.262 496.995 106.5 456C72.5459 442.454 26.5 424.534 0 414.5V1017H511.194C427.112 927.187 431.418 790.477 540.144 857.784C569.211 875.778 599.322 908.147 631.579 942.824C654.869 967.86 679.277 994.099 705.22 1017H1440V16.8289C1384.06 0.493652 1314.38 -6.89862 1264.86 12.6029C1245.21 20.343 1228.38 28.9263 1211.62 37.4705C1160.22 63.6842 1109.55 89.5302 980.262 89.5303C860.432 89.5303 883.726 244.685 913.586 317.069C919.152 330.562 927.713 342.307 936.211 353.965C948.57 370.921 960.795 387.693 963.477 409.39Z"
					fill="url(#liner-grad-261)"
				></path>
			</svg>
		</div>

		<div class="container sm:container-narrow">
			<div class="c-cta-section-c">
				<header class="c-cta-section-c__header">
					<div class="c-animated-big-text u-a5 js-brush-text-scroll">
						<div class="c-animated-big-text__text">
							<h2 class="c-animated-big-text__text-line js-text-line">
								Lakes and Waterfalls of Oconee County
							</h2>
							<p
								class="c-animated-big-text__text-line c-animated-big-text__text-line--clone js-text-line-clone"
								aria-hidden="true"
								tabindex="-1"
							>
								Lakes and Waterfalls of Oconee County
							</p>
						</div>
					</div>

					<p class="c-cta-section-c__description u-b0 js-animated-stagger-element text-center">
						Surrounded by the tranquil blue-green waters of Lake Jocassee, discover one of the
						greenest and most gloriously untamed watering holes, with much magic to explore and
						enjoy.
					</p>
				</header>

				<div class="c-cta-section-c__list">
					<div class="c-cta-section-c__item js-animated-stagger-element">
						<figure class="c-responsive-image">
							<Picture
								pictureAttributes={{
									class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
								}}
								class="c-responsive-image__img"
								src={destinationOconeeImage}
								formats={['avif', 'webp']}
								alt="Destination Oconee"
								widths={[640, 1140, 2000, destinationOconeeImage.width]}
							/>
						</figure>
					</div>

					<div class="c-cta-section-c__item js-animated-stagger-element">
						<figure class="c-responsive-image">
							<Picture
								pictureAttributes={{
									class: 'c-responsive-image__inner c-responsive-image__inner--3-4',
								}}
								class="c-responsive-image__img"
								src={whitewaterFallsImage}
								formats={['avif', 'webp']}
								alt="Upper Whitewater Falls"
								widths={[640, 1140, 2000, whitewaterFallsImage.width]}
							/>
						</figure>
					</div>

					<div class="c-cta-section-c__item js-animated-stagger-element">
						<figure class="c-responsive-image">
							<Picture
								pictureAttributes={{
									class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
								}}
								class="c-responsive-image__img"
								src={devilsForkStateParkBeachImage}
								formats={['avif', 'webp']}
								alt="Devils Fork State Park Beach"
								widths={[640, 1140, 2000, devilsForkStateParkBeachImage.width]}
							/>
						</figure>
					</div>
				</div>

				<div class="c-cta-section-c__footer js-animated-stagger-element relative">
					<a
						href="/discover-oconee"
						class="c-cta c-cta--white u-a2"
					>
						<span>Discover Oconee County</span>
						<i class="c-cta__icon">
							<svg
								class="u-icon u-icon--arrow-right"
								viewBox="0 0 12 12"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M6.15464 0L4.91753 1.39175C5.87629 2.90722 7.17526 4.14433 9.68041 5.38144C8.65979 5.38144 8.38144 5.07216 6.89691 5.07216H0V6.92783H6.89691C8.38144 6.92783 8.65979 6.61856 9.68041 6.61856C7.17526 7.85567 5.87629 9.09278 4.91753 10.6082L6.15464 12C7.48453 10.1134 9.12371 8.53608 12 6.92783V5.07216C9.12371 3.46392 7.48453 1.8866 6.15464 0Z"
								></path>
							</svg>
						</i>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.c-section-background {
		position: relative;
		bottom: -1px;
		overflow: hidden;
	}

	.c-section-background .c-section-separator {
		z-index: 0;
	}

	.c-section-background .c-section-separator {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
	}

	.c-bg-shape--bottom {
		bottom: 0;
	}

	.c-bg-shape {
		position: absolute;
		left: 0;
		width: 100%;
		pointer-events: none;
	}

	.c-bg-shape .u-icon {
		display: block;
		width: 100%;
		height: auto;
	}

	.c-cta-section-c__header {
		--pb: 64px;

		@media (min-width: 480px) {
			--pb: calc(3.3333333333vw + 48px);
		}

		@media (min-width: 1440px) {
			--pb: 96px;
		}

		@media (min-width: 1920px) {
			--pb: 5vw;
		}

		padding-bottom: var(--pb);
	}

	.c-cta-section-c__description {
		--max-width: 480px;

		@media (min-width: 1920px) {
			--max-width: 25vw;
		}

		max-width: var(--max-width);
		margin-left: auto;
		margin-right: auto;
		color: #f7f7ee;
	}

	.c-cta-section-c__list {
		--gap: 20px;

		@media (min-width: 1920px) {
			--gap: 1.0416666667vw;
		}

		gap: var(--gap);
		display: grid;
		grid-template-columns: 1fr 33.3333333333vw 1fr;
	}

	@media (max-width: 640px) {
		.c-cta-section-c__list {
			grid-template-columns: 1fr 2fr;
		}
	}

	.c-cta-section-c__item:first-child {
		margin-top: auto;
	}

	@media (max-width: 640px) {
		.c-cta-section-c__item:last-child {
			display: none;
		}
	}

	.c-cta-section-c__item .c-responsive-image {
		--br: 20px;

		@media (min-width: 1920px) {
			--br: 1.0416666667vw;
		}

		border-radius: var(--br);
		overflow: hidden;
	}

	.c-cta-section-c__footer {
		--mt: 72px;

		@media (min-width: 480px) {
			--mt: calc(5vw + 48px);
		}

		@media (min-width: 1440px) {
			--mt: 120px;
		}

		@media (min-width: 1920px) {
			--mt: 6.25vw;
		}

		margin-top: var(--mt);
		display: flex;
		justify-content: center;
		align-items: center;
	}
</style>

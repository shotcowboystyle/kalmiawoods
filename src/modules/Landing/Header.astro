---
import Logo from '@/components/Logo.astro';
---

<header
	class="fixed top-0 z-50 w-full p-5 text-white duration-300 md:transition-none"
	id="header"
>
	<div class="flex items-center justify-between sm:container">
		<div class="flex flex-1 items-center justify-start">
			<a
				href="/"
				rel="prefetch"
				class="flex items-center justify-start"
			>
				<Logo class="h-12 w-12" />
				<span class="ml-2 block">Kalmia Woods</span>
			</a>
		</div>

		<div class="flex-none">
			<a
				id="login-button"
				class="btn btn-outline"
				href="/dashboard"
			>
				Login
			</a>
		</div>
	</div>
</header>

<script>
	document.addEventListener('astro:page-load', () => {
		let lastKnownScrollPosition = window.scrollY;
		let ticking = true;

		function appyHeaderStylesOnScroll() {
			const header = document.getElementById('header');
			if (lastKnownScrollPosition > 60 && header && !header?.classList.contains('scroll')) {
				header.classList.add('scroll');
			} else if (lastKnownScrollPosition <= 60 && header?.classList.contains('scroll')) {
				header.classList.remove('scroll');
			}
			ticking = false;
		}
		appyHeaderStylesOnScroll();

		document.addEventListener('scroll', () => {
			lastKnownScrollPosition = window.scrollY;

			if (!ticking) {
				window.requestAnimationFrame(() => {
					appyHeaderStylesOnScroll();
				});
				ticking = true;
			}
		});
	});
</script>

<style>
	#header.scroll {
		@apply bg-base-100 text-base-content shadow-md dark:bg-white dark:text-black md:shadow-lg;
	}

	#header #login-button {
		@apply border-white text-white;
	}

	#header.scroll #login-button {
		@apply border-black text-black dark:border-white dark:text-white;
	}
</style>

---
import bgImage from '@/assets/images/photos/house-living-area-1.jpeg';
import { Image, Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const nearbyAttractions = (await getCollection('attractions')).sort(
	(a: CollectionEntry<'attractions'>, b: CollectionEntry<'attractions'>) =>
		b.data.order < a.data.order ? 1 : b.data.order > a.data.order ? -1 : 0,
);

// const optimizedBgImage = await getImage({src: bgImage, format: 'avif'});
---

<section class="section relative h-screen bg-[#e3dcc9]">
	<div class="container flex h-full flex-col justify-center">
		<div class="section-text">
			<h2 class="h2 text-base-content">Explore Nearby</h2>
		</div>

		<div class="carousel w-full space-x-4 px-0">
			{
				nearbyAttractions.map((attraction) => (
					<a
						href={attraction.data.href}
						target="_blank"
						class="carousel-item"
					>
						<div class="flex flex-col items-start gap-y-8 py-2">
							<div class="avatar h-[600px]">
								<div class="h-full w-full rounded-xl drop-shadow-lg">
									<Picture
										src={attraction.data.image}
										alt={attraction.data.name}
										formats={['avif', 'webp']}
										widths={[64, 128, attraction.data.image.width]}
									/>
								</div>
							</div>

							<div class="mt-0">
								<span class="text-base-content block font-semibold">{attraction.data.name}</span>
								<span class="text-base-content text-sm">{attraction.data.description}</span>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>

	<div class="section-bg absolute inset-0 -z-[1]">
		<Image
			src={bgImage}
			alt=""
			widths={[640, 828, 2400, bgImage.width]}
			class="section-bg-image mask mask-hexagon-2 absolute top-0 left-1/2 p-0 brightness-200"
		/>
	</div>
</section>

<style>
	.section-bg-image {
		mask-position: top;
	}
</style>

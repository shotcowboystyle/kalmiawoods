---
import salemBg from '@/assets/images/salem-sc.jpeg';
import senecaBg from '@/assets/images/seneca-sc-mural.jpeg';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { Picture } from 'astro:assets';
---

<section class="section relative">
	<div class="section-inner section-inner-py-xl">
		<div class="container">
			<div class="c-content-images-cta">
				<header class="c-content-images-cta__header">
					<h2 class="c-content-images-cta__title u-a5 js-animated-stagger-element">
						Beyond the retreat
					</h2>

					<div class="c-content-images-cta__description u-b0 js-animated-stagger-element">
						<p>
							Explore & enjoy the many outdoor opportunities with places for all ages and interests.
						</p>
					</div>
				</header>

				<div class="c-content-images-cta__list">
					<article class="c-content-image-card c-content-image-card--image-count-1">
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img"
										src={salemBg}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, salemBg.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Salem, SC
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									The gateway to the Blue Ridge Mountains, Lake Jocassee and Lake Keowee, an area
									well known for outdoor activities and mountain adventures
								</p>
							</div>

							<div class="js-animated-stagger-element">
								<a
									href="https://visitoconeesc.com/visit/salem/"
									class="c-cta u-a2"
									target="_blank"
								>
									<span>Read More</span>
									<i class="c-cta__icon">
										<ArrowIcon />
									</i>
								</a>
							</div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--image-count-1 c-content-image-card--reverse"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img"
										src={senecaBg}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, senecaBg.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Seneca’s Historic Downtown
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									There’s a charming part of town, a short drive from Highway 123, which is worth a
									stop if you appreciate the past. Seneca’s historic district is a collection of
									commercial buildings which reflect the development of the downtown area as the
									center of commerce from around 1887 to 1930.
								</p>
							</div>

							<div class="js-animated-stagger-element">
								<a
									href="https://visitoconeesc.com/visit/seneca-historic-district/"
									class="c-cta u-a2"
									target="_blank"
								>
									<span>Read More</span>
									<i class="c-cta__icon">
										<ArrowIcon />
									</i>
								</a>
							</div>
						</div>
					</article>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.c-content-images-cta__header {
		--pb: 72px;

		@media (min-width: 480px) {
			--pb: calc(5vw + 48px);
		}

		@media (min-width: 1440px) {
			--pb: 120px;
		}

		@media (min-width: 1920px) {
			--pb: 6.25vw;
		}

		padding-bottom: var(--pb);
	}

	.c-content-images-cta__title {
		--mw: 680px;
		--pb: 24px;

		@media (min-width: 480px) {
			--pb: calc(1.6666666667vw + 16px);
		}

		@media (min-width: 1440px) {
			--pb: 40px;
		}

		@media (min-width: 1920px) {
			--pb: 2.0833333333vw;
			--mw: 35.4166666667vw;
		}

		max-width: var(--mw);
		padding-bottom: var(--pb);
		text-align: center;
		margin-left: auto;
		margin-right: auto;
		color: #434b34;
	}

	.c-content-images-cta__description {
		--mw: 360px;

		@media (min-width: 1920px) {
			--mw: 18.75vw;
		}

		max-width: var(--mw);
		text-align: center;
		margin-left: auto;
		margin-right: auto;
		color: #2e3323;
	}

	.c-content-editor h2,
	.u-a3 {
		--font-size: 30px;

		@media (min-width: 480px) {
			--font-size: calc(1.0416666667vw + 25px);
		}

		@media (min-width: 1440px) {
			--font-size: 40px;
		}

		@media (min-width: 1920px) {
			--font-size: 2.0833333333vw;
		}

		font-size: var(--font-size);
		font-family: 'PP Woodland', serif;
		line-height: 120%;
		letter-spacing: -0.03em;
	}

	.c-content-image-card__title {
		--pb: 12px;
		--mw: 360px;

		@media (min-width: 480px) {
			--pb: 20px;
		}

		@media (min-width: 1440px) {
			--pb: 1.0416666667vw;
		}

		@media (min-width: 1920px) {
			--pb: calc(0.8333333333vw + 8px);
			--mw: 18.75vw;
		}

		padding-bottom: var(--pb);
		max-width: var(--mw);
		color: #434b34;
	}
</style>

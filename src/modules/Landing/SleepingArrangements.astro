---
import { SLEEPING_ARRANGEMENTS_DATA } from '@/app/constants';
import SvgSprite from '@/components/SvgSprite.astro';
import type { SleepingArrangements } from '@/types/Landing';
---

<section class="section">
	<div class="w-full max-xl:overflow-hidden max-xl:px-6 sm:container">
		<h3 class="mb-4 text-2xl">Sleeping Arrangements</h3>
		<div class="flex flex-nowrap gap-4 lg:grid-cols-4 lg:gap-x-4">
			{
				SLEEPING_ARRANGEMENTS_DATA.map(({ icons, text, title }: SleepingArrangements) => (
					<div class="flex-[0 0 auto] flex w-[12rem] flex-col gap-y-2 rounded-md border border-gray-300 px-4 py-6">
						<div class="mb-4 flex gap-x-2">
							{icons.map((icon) => (
								<SvgSprite
									name={icon}
									class="h-6 w-6 dark:fill-white dark:text-white"
								/>
							))}
						</div>
						<div class="my-0 leading-5 font-semibold">{title}</div>
						<div class="text-muted my-0 text-sm leading-5">{text}</div>
					</div>
				))
			}
		</div>
	</div>
</section>

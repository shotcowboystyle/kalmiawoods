---
import lakeJocasseeBgImage from '@/assets/images/lake-jocassee-full.jpeg';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { Picture } from 'astro:assets';
---

<section
	class="section"
	data-swap="bookNow"
>
	<div class="c-pre-footer js-parallax-wrapper relative overflow-hidden">
		<figure class="c-responsive-image">
			<Picture
				pictureAttributes={{
					class: 'c-responsive-image__inner c-responsive-image__inner--16-9',
				}}
				class="c-responsive-image__img js-parallax-item"
				src={lakeJocasseeBgImage}
				formats={['avif', 'webp']}
				alt="Lake Jocassee panoramic view"
				widths={[640, 1140, 2000, lakeJocasseeBgImage.width]}
				sizes="100vw"
				loading="lazy"
			/>
		</figure>

		<div class="c-pre-footer__content js-animated-stagger-element">
			<h2 class="u-a4 c-pre-footer__title">Get back to nature</h2>
			<a
				href="/book-now"
				class="c-cta c-cta--white u-a2"
			>
				<span>Book your stay</span>
				<i class="c-cta__icon">
					<ArrowIcon />
				</i>
			</a>
		</div>
	</div>
</section>

<style>
	.c-pre-footer__content {
		--pt: 56px;
		--pb: 56px;
		--px: 9.0909090909%;
		--br: 20px;
		--gap: 40px;
		--inset-x: 4.1666666667%;

		@media (min-width: 480px) {
			--pt: calc(2.5vw + 44px);
			--pb: calc(2.5vw + 44px);
			--gap: calc(2.5vw + 28px);
		}

		@media (min-width: 1440px) {
			--pt: 80px;
			--pb: 80px;
			--gap: 64px;
		}

		@media (min-width: 1920px) {
			--pt: 4.1666666667vw;
			--pb: 4.1666666667vw;
			--br: 1.0416666667vw;
			--gap: 3.3333333333vw;
		}

		padding-top: var(--pt);
		padding-bottom: var(--pb);
		border-radius: var(--br);
		gap: var(--gap);
		position: absolute;
		left: var(--inset-x);
		right: var(--inset-x);
		bottom: 4.1666666667vw;
		padding-left: var(--px);
		padding-right: var(--px);
		display: flex;
		justify-content: space-between;
		align-items: center;
		background-color: #5b6647;
		color: #e3e3c4;
	}

	@media (max-width: 800px) {
		.c-pre-footer__content {
			flex-direction: column;
			text-align: center;
			gap: 20px;
		}
	}

	.u-a4 {
		font-size: 36px;
		font-family: 'PP Woodland', serif;
		line-height: 110%;
		letter-spacing: -0.02em;

		@media (min-width: 480px) {
			font-size: calc(2.5vw + 24px);
		}

		@media (min-width: 1440px) {
			font-size: 60px;
		}

		@media (min-width: 1920px) {
			font-size: 3.125vw;
		}
	}

	.c-pre-footer .c-cta {
		color: #f7f7ee;
		white-space: nowrap;
	}

	.c-cta {
		gap: 20px;
		display: inline-flex;
		align-items: center;
		color: #5b6647;

		@media (min-width: 1920px) {
			gap: 1.0416666667vw;
		}
	}
</style>

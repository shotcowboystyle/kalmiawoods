---
import roomsImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import roomsImage3 from '@/assets/images/photos/house-living-area-3.jpeg';
import roomsImage2 from '@/assets/images/photos/house-sunroom-2.jpeg';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { Picture } from 'astro:assets';
---

<section
	id="enter"
	class="section o-section o-section--pt-xl o-section--pb-xl o-section--bg-green js-bg-shape-animation-module relative"
>
	<div class="section-inner section-inner-pt-l section-inner-pb-m">
		<div class="container sm:container-narrow">
			<div class="c-image-grid-cta">
				<div
					class="c-animated-big-text u-a5 js-brush-text-scroll c-animated-big-text--light mx-auto max-w-[930px]"
				>
					<div class="c-animated-big-text__text">
						<p class="c-animated-big-text__text-line js-text-line">
							Sweeping view of the Oconee County Forest
						</p>

						<p
							class="c-animated-big-text__text-line c-animated-big-text__text-line--clone js-text-line-clone"
							aria-hidden="true"
						>
							Sweeping view of the Oconee County Forest
						</p>
					</div>
				</div>

				<div class="c-image-grid-cta__row">
					<div class="c-image-grid-cta__column">
						<div class="c-image-grid-cta__content">
							<p class="c-image-grid-cta__text u-b0 js-animated-stagger-element">
								Many rooms have balconies that beckon you to breathe in the pure Mediterranean air
								of the island. All rooms are air conditioned and feature an elegant ensuite bathroom
								with shower.
							</p>

							<div class="js-animated-stagger-element">
								<a
									href="/rooms"
									class="c-cta u-a2"
								>
									<span>Explore Rooms</span>
									<i class="c-cta__icon">
										<ArrowIcon />
									</i>
								</a>
							</div>
						</div>

						<div
							class="c-image-grid-cta__image c-image-grid-cta__image--1 js-animated-stagger-element"
						>
							<figure class="c-responsive-image">
								<Picture
									pictureAttributes={{
										class: 'c-responsive-image__inner c-responsive-image__inner--3-2',
									}}
									class="c-responsive-image__img !object-bottom"
									src={roomsImage1}
									formats={['avif', 'webp']}
									alt="A description of my image."
									widths={[640, 1140, 2000, roomsImage1.width]}
								/>
							</figure>
						</div>
					</div>

					<div class="c-image-grid-cta__column">
						<div
							class="c-image-grid-cta__image c-image-grid-cta__image--2 js-animated-stagger-element"
						>
							<figure class="c-responsive-image">
								<Picture
									pictureAttributes={{
										class: 'c-responsive-image__inner c-responsive-image__inner--3-2',
									}}
									class="c-responsive-image__img"
									src={roomsImage2}
									formats={['avif', 'webp']}
									alt="A description of my image."
									widths={[640, 1140, 2000, roomsImage2.width]}
								/>
							</figure>
						</div>

						<div
							class="c-image-grid-cta__image c-image-grid-cta__image--3 js-animated-stagger-element"
						>
							<figure class="c-responsive-image">
								<Picture
									pictureAttributes={{
										class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
									}}
									class="c-responsive-image__img"
									src={roomsImage3}
									formats={['avif', 'webp']}
									alt="A description of my image."
									widths={[640, 1140, 2000, roomsImage3.width]}
								/>
							</figure>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@reference "tailwindcss";

	.c-image-grid-cta .c-animated-big-text {
		--max-width: 930px;
		--pb: 64px;

		@media (min-width: 480px) {
			--pb: calc(3.3333333333vw + 48px);
		}

		@media (min-width: 1440px) {
			--pb: 96px;
		}

		@media (min-width: 1920px) {
			--pb: 5vw;
			--max-width: 48.4375vw;
		}

		max-width: var(--max-width);
		padding-bottom: var(--pb);
		margin-left: auto;
		margin-right: auto;
	}

	.c-animated-big-text,
	.c-image-grid-cta__content {
		--pb: 64px;

		@media (min-width: 480px) {
			--pb: calc(3.3333333333vw + 48px);
		}

		@media (min-width: 1440px) {
			--pb: 96px;
		}

		@media (min-width: 1920px) {
			--pb: 5vw;
		}

		padding-bottom: var(--pb);
	}

	.c-image-grid-cta__row {
		@apply grid gap-5;

		grid-template-columns: 45% 1fr;

		@media (min-width: 1920px) {
			gap: 1.0416666667vw;
		}
	}

	@media (max-width: 640px) {
		.c-image-grid-cta__row {
			grid-template-columns: 1fr;
		}
	}

	.c-image-grid-cta__text {
		--max-width: 360px;
		--pb: 24px;

		@media (min-width: 480px) {
			--pb: calc(1.6666666667vw + 16px);
		}

		@media (min-width: 1440px) {
			--pb: 40px;
		}

		@media (min-width: 1920px) {
			--pb: 2.0833333333vw;
			--max-width: 18.75vw;
		}

		max-width: var(--max-width);
		padding-bottom: var(--pb);
		color: #2e3323;
	}

	.c-image-grid-cta__image {
		@apply overflow-hidden rounded-3xl;

		@media (min-width: 1920px) {
			border-radius: 1.0416666667vw;
		}
	}

	@media (max-width: 640px) {
		.c-image-grid-cta__image--1 {
			display: none;
		}
	}

	.c-image-grid-cta__column:nth-child(2) {
		gap: 20px;
		display: flex;
		flex-direction: column;

		@media (min-width: 1920px) {
			gap: 1.0416666667vw;
		}
	}

	.c-image-grid-cta__image img {
		border-radius: 20px;

		@media (min-width: 1920px) {
			border-radius: 1.0416666667vw;
		}
	}

	.c-image-grid-cta__image--3 {
		max-width: 280px;

		@media (min-width: 1920px) {
			max-width: 14.5833333333vw;
		}
	}
</style>

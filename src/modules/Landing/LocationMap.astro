---
import 'leaflet/dist/leaflet.css';

export interface Props {
	latitude: number;
	longitude: number;
	zoom: number;
}

const { latitude, longitude, zoom } = Astro.props;
---

<section class="container py-8">
	<div
		id="map-container"
		class="w-full overflow-hidden rounded-3xl bg-clip-padding shadow-inner drop-shadow-xl"
		data-latitude={latitude}
		data-longitude={longitude}
		data-zoom={zoom}
	>
		<div
			id="map"
			class="h-96"
		>
		</div>
	</div>
</section>

<script>
	import L from 'leaflet';

	const mapContainer = document.getElementById('map-container');

	if (mapContainer) {
		const latitude = parseInt(mapContainer.dataset.latitude!, 10);
		const longitude = parseInt(mapContainer.dataset.longitude!, 10);
		const coordinates: [number, number] = [latitude, longitude];
		const zoom: number = parseInt(mapContainer.dataset.zoom!, 10);
		const map = L.map('map').setView(coordinates, zoom);
		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '',
		}).addTo(map);
		L.marker(coordinates).addTo(map);
	}
</script>

---
import SvgSprite from '@/components/SvgSprite.astro';
import type { Amenity } from '@/types/Landing';
import type { CollectionEntry } from 'astro:content';

export interface Props {
	amenitiesCollection: CollectionEntry<'amenities'>[];
}

const { amenitiesCollection } = Astro.props;

const allAmenitiesItems = amenitiesCollection.reduce(
	(acc, cur) => [...acc, ...cur.data.items],
	[] as Amenity[],
);
---

<button
	class="btn btn-outline"
	onclick="amenitiesModal.showModal()"
>
	Show all {allAmenitiesItems.length} amenities
</button>

<dialog
	id="amenitiesModal"
	class="modal modal-bottom sm:modal-middle"
>
	<div class="modal-box !w-3/5 !max-w-3xl">
		<form method="dialog">
			<button class="btn btn-circle btn-ghost btn-sm absolute top-2 right-2">✕</button>
		</form>

		<div class="mb-8">
			<h2
				class="text-lg font-bold"
				tabindex="-1"
			>
				What this place offers
			</h2>
		</div>

		{
			amenitiesCollection.map((amenity) => (
				<div class="-mt-4 mb-12">
					<div class="text-base-content mb-0 py-4 text-lg font-semibold">
						<h3
							class="amenity-section-title"
							tabindex="-1"
						>
							{amenity.data.name}
						</h3>
					</div>

					{amenity.data.items.map(
						({
							title,
							icon,
							description,
						}: {
							title: string;
							icon: string;
							description?: string;
						}) => (
							<div>
								<div class="rounded-sm py-6">
									<div class="flex">
										<div class="mr-4">
											<div class="flex min-h-6 items-center">
												<SvgSprite
													name={icon}
													class="h-6 w-6 dark:fill-white"
												/>
											</div>
										</div>

										<div class="flex w-full flex-auto flex-col justify-center">
											<div class="text-base-content">{title}</div>
											{description && (
												<div class="text-muted mt-1 text-sm break-words">{description}</div>
											)}
										</div>
									</div>
								</div>
								<div class="divider my-0" />
							</div>
						),
					)}
				</div>
			))
		}
	</div>
	<form
		method="dialog"
		class="modal-backdrop"
	>
		<button>close</button>
	</form>
</dialog>

---

<section class="section">
	<div class="section-inner section-inner-pt-xs section-inner-pb-xl">
		<div class="o-container o-container--md-full">
			<!-- <div class="c-google-map js-animated-stagger-element"> -->
			<div class="c-google-map">
				<div
					id="map-container"
					class="c-google-map__container js-location-map"
					data-latitude="42.788321944718106"
					data-longitude="17.342736090062164"
					data-zoom="15"
				>
					<div id="map"></div>
				</div>
				<p>42.788321944718106, 17.342736090062164</p>
			</div>
		</div>
	</div>
</section>

<script>
	import L from 'leaflet';

	const mapContainer = document.getElementById('map-container');

	if (mapContainer) {
		const latitude = parseInt(mapContainer.dataset.latitude!, 10);
		const longitude = parseInt(mapContainer.dataset.longitude!, 10);
		const coordinates: [number, number] = [latitude, longitude];
		const zoom: number = parseInt(mapContainer.dataset.zoom!, 10);
		const map = L.map('map').setView(coordinates, zoom);
		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '',
		}).addTo(map);
		L.marker(coordinates).addTo(map);
	}
</script>

<style>
	.c-google-map__container {
		border-radius: 20px;
		overflow: hidden;
		padding-top: 43.6363636364%;
	}

	@media (min-width: 1920px) {
		.c-google-map__container {
			border-radius: 1.0416666667vw;
		}
	}

	@media (max-width: 800px) {
		.c-google-map__container {
			padding-bottom: 60%;
			border-radius: 0;
		}
	}

	@media (max-width: 640px) {
		.c-google-map__container {
			padding-bottom: 100%;
		}
	}

	.c-google-map__container a[href^="https://maps.google.com/maps"]
	{
		display: none !important;
	}

	.c-google-map__container .gm-style-cc,
	.c-google-map__container .gmnoprint a,
	.c-google-map__container .gmnoprint span {
		display: none;
	}

	.c-google-map__container .gmnoprint div {
		background: 0 0 !important;
	}

	.c-google-map p {
		padding-top: 12px;
		text-align: right;
	}

	@media (min-width: 480px) {
		.c-google-map p {
			padding-top: calc(0.8333333333vw + 8px);
		}
	}

	@media (min-width: 1440px) {
		.c-google-map p {
			padding-top: 20px;
		}
	}

	@media (min-width: 1920px) {
		.c-google-map p {
			padding-top: 1.0416666667vw;
		}
	}

	@media (max-width: 800px) {
		.c-google-map p {
			padding-right: 20px;
		}
	}
</style>

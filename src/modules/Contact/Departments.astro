---
import { CONTACT_INFO } from '@/app/constants';
---

<section class="section">
	<div class="section-inner section-inner-pt-xs section-inner-pb-l">
		<div class="container-narrow">
			<div class="c-info-cards">
				<div class="c-info-cards__list">
					<div class="c-info-cards__item js-animated-stagger-element">
						<div class="c-info-cards__top">
							<h3 class="u-a3">Retreat Address</h3>
						</div>

						<div class="c-info-cards__bottom u-a1">
							<p>{CONTACT_INFO.address.line1}</p>
							<p>{CONTACT_INFO.address.line2}</p>
						</div>
					</div>

					<div class="c-info-cards__item js-animated-stagger-element">
						<div class="c-info-cards__top">
							<h3 class="u-a3">Property Contact</h3>
						</div>
						<div class="c-info-cards__bottom u-a1">
							<p>
								<a href={`tel:${CONTACT_INFO.propertyManager.phone}`}
									>{CONTACT_INFO.propertyManager.phone}</a
								>
							</p>

							<p>
								<a href={`mailto:${CONTACT_INFO.propertyManager.email}`}
									>{CONTACT_INFO.propertyManager.email}</a
								>
							</p>
						</div>
					</div>

					<div class="c-info-cards__item js-animated-stagger-element">
						<div class="c-info-cards__top">
							<h3 class="u-a3">Reservations</h3>
						</div>

						<div class="c-info-cards__bottom u-a1">
							<p>
								<a href={`tel:${CONTACT_INFO.reservations.phone}`}
									>{CONTACT_INFO.reservations.phone}</a
								>
							</p>

							<p>
								<a href={`mailto:${CONTACT_INFO.reservations.email}`}
									>{CONTACT_INFO.reservations.email}</a
								>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

---
import FormContact from './FormContact.astro';
---

<section class="body-font relative py-12 text-gray-600 max-sm:pt-72">
	<div class="absolute inset-0">
		<iframe
			width="100%"
			height="100%"
			title="map"
			src="https://maps.google.com/maps?width=100%&height=600&hl=en&q=255+Kalmia+Ln,+Salem,+SC+29676&ie=UTF8&t=&z=14&iwloc=B&output=embed"
			loading="lazy"
			style="filter: grayscale(1) contrast(1.2) opacity(0.7);"
		></iframe>
	</div>
	<div class="container mx-auto flex py-32">
		<div
			class="relative z-10 mt-10 flex w-full flex-col rounded-lg bg-white p-8 shadow-md md:mt-0 md:ml-auto md:w-1/2 lg:w-1/3"
		>
			<FormContact />
		</div>
	</div>
</section>

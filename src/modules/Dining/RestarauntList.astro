---
import roomsImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import { Picture } from 'astro:assets';
---

<section class="section">
	<div class="section-inner section-inner-pt-m section-inner-pb-l">
		<div class="container">
			<div class="c-link-list-big">
				<ul class="c-link-list-big__list">
					<li class="c-link-list-big__item js-animated-stagger-element">
						<a
							href="https://hotelodisej.com/dining/#mare-beach-bar"
							class="c-link-list-big__link"
						>
							<div class="c-link-list-big__image">
								<figure class="c-responsive-image c-responsive-image--background">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--adopt',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-link-list-big__info">
								<div class="c-link-list-big__info-col">
									<h3 class="c-link-list-big__title u-a3">Vista Mare Beach Bar</h3>
									<p class="c-link-list-big__description u-b0">
										Enjoy a sublime stretch of gently shaded waterfront next to Pomena pier, where
										all the yachts and ships dock.
									</p>
								</div>

								<div class="c-link-list-big__info-col">
									<span class="c-link-list-big__circle c-button c-button--small u-b0">
										<span>01</span>
										<svg
											class="u-icon u-icon--arrow-right"
											viewBox="0 0 12 12"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path
												d="M6.15464 0L4.91753 1.39175C5.87629 2.90722 7.17526 4.14433 9.68041 5.38144C8.65979 5.38144 8.38144 5.07216 6.89691 5.07216H0V6.92783H6.89691C8.38144 6.92783 8.65979 6.61856 9.68041 6.61856C7.17526 7.85567 5.87629 9.09278 4.91753 10.6082L6.15464 12C7.48453 10.1134 9.12371 8.53608 12 6.92783V5.07216C9.12371 3.46392 7.48453 1.8866 6.15464 0Z"
											></path>
										</svg>
									</span>
								</div>
							</div>
						</a>
					</li>

					<li class="c-link-list-big__item js-animated-stagger-element">
						<a
							href="https://hotelodisej.com/dining/#pizzeria-levant"
							class="c-link-list-big__link"
						>
							<div class="c-link-list-big__image">
								<figure class="c-responsive-image c-responsive-image--background">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--adopt',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-link-list-big__info">
								<div class="c-link-list-big__info-col">
									<h3 class="c-link-list-big__title u-a3">Levanat Pizzeria</h3>
									<p class="c-link-list-big__description u-b0">
										Overlooking the neatly lined boats at the very pretty Pomena marina, Levanat
										Pizzeria has enchanting views over the crystal-clear Adriatic.
									</p>
								</div>

								<div class="c-link-list-big__info-col">
									<span class="c-link-list-big__circle c-button c-button--small u-b0">
										<span>02</span>
										<svg
											class="u-icon u-icon--arrow-right"
											viewBox="0 0 12 12"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path
												d="M6.15464 0L4.91753 1.39175C5.87629 2.90722 7.17526 4.14433 9.68041 5.38144C8.65979 5.38144 8.38144 5.07216 6.89691 5.07216H0V6.92783H6.89691C8.38144 6.92783 8.65979 6.61856 9.68041 6.61856C7.17526 7.85567 5.87629 9.09278 4.91753 10.6082L6.15464 12C7.48453 10.1134 9.12371 8.53608 12 6.92783V5.07216C9.12371 3.46392 7.48453 1.8866 6.15464 0Z"
											></path>
										</svg>
									</span>
								</div>
							</div>
						</a>
					</li>

					<li class="c-link-list-big__item js-animated-stagger-element">
						<a
							href="https://hotelodisej.com/dining/#restaurant-odisej"
							class="c-link-list-big__link"
						>
							<div class="c-link-list-big__image">
								<figure class="c-responsive-image c-responsive-image--background">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--adopt',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-link-list-big__info">
								<div class="c-link-list-big__info-col">
									<h3 class="c-link-list-big__title u-a3">Restaurant Odisej</h3>
									<p class="c-link-list-big__description u-b0">
										The picture perfect panorama of Pomena Bay from the terrace draws a steady crowd
										to Restaurant Odisej.
									</p>
								</div>

								<div class="c-link-list-big__info-col">
									<span class="c-link-list-big__circle c-button c-button--small u-b0">
										<span>03</span>
										<svg
											class="u-icon u-icon--arrow-right"
											viewBox="0 0 12 12"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path
												d="M6.15464 0L4.91753 1.39175C5.87629 2.90722 7.17526 4.14433 9.68041 5.38144C8.65979 5.38144 8.38144 5.07216 6.89691 5.07216H0V6.92783H6.89691C8.38144 6.92783 8.65979 6.61856 9.68041 6.61856C7.17526 7.85567 5.87629 9.09278 4.91753 10.6082L6.15464 12C7.48453 10.1134 9.12371 8.53608 12 6.92783V5.07216C9.12371 3.46392 7.48453 1.8866 6.15464 0Z"
											></path>
										</svg>
									</span>
								</div>
							</div>
						</a>
					</li>

					<li class="c-link-list-big__item js-animated-stagger-element">
						<a
							href="https://hotelodisej.com/dining/#maestral-snack-bar"
							class="c-link-list-big__link"
						>
							<div class="c-link-list-big__image">
								<figure class="c-responsive-image c-responsive-image--background">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--adopt',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>

							<div class="c-link-list-big__info">
								<div class="c-link-list-big__info-col">
									<h3 class="c-link-list-big__title u-a3">Maestral Snack Bar</h3>
									<p class="c-link-list-big__description u-b0">
										You can’t miss Maestral Snack Bar!
									</p>
								</div>

								<div class="c-link-list-big__info-col">
									<span class="c-link-list-big__circle c-button c-button--small u-b0">
										<span>04</span>
										<svg
											class="u-icon u-icon--arrow-right"
											viewBox="0 0 12 12"
											xmlns="http://www.w3.org/2000/svg"
										>
											<path
												d="M6.15464 0L4.91753 1.39175C5.87629 2.90722 7.17526 4.14433 9.68041 5.38144C8.65979 5.38144 8.38144 5.07216 6.89691 5.07216H0V6.92783H6.89691C8.38144 6.92783 8.65979 6.61856 9.68041 6.61856C7.17526 7.85567 5.87629 9.09278 4.91753 10.6082L6.15464 12C7.48453 10.1134 9.12371 8.53608 12 6.92783V5.07216C9.12371 3.46392 7.48453 1.8866 6.15464 0Z"
											></path>
										</svg>
									</span>
								</div>
							</div>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>

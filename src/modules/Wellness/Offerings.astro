---
import roomsImage1 from '@/assets/images/photos/house-living-area-1.jpeg';
import { Picture } from 'astro:assets';
---

<section class="section">
	<div class="section-inner section-inner-pt-l section-inner-pb-xl">
		<div class="container">
			<div class="c-content-images-cta">
				<div class="c-content-images-cta__list">
					<article
						class="c-content-image-card c-content-image-card--image-count-1 c-content-image-card--reverse"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> FACIAL</span>
							</div>

							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Signature Hydrating
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Facial treatment specially designed for all skin types and deep hydration. EC
									experts developed the perfect formula for preventing dehydration and restoring the
									original healthy condition of the skin.
								</p>
							</div>
							<div class="js-animated-stagger-element"></div>
						</div>
					</article>

					<article class="c-content-image-card c-content-image-card--image-count-1">
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> BODY</span>
							</div>
							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Anti-Stress Back and Leg Therapy
							</h3>
							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Relaxing treatment that includes a legs and back massage stimulating circulation
									and lymph flow. The treatment ends with alternating warm and cold compresses.
								</p>
							</div>
							<div class="js-animated-stagger-element"></div>
						</div>
					</article>

					<article
						class="c-content-image-card c-content-image-card--image-count-1 c-content-image-card--reverse"
					>
						<div class="c-content-image-card__image-wrapper js-animated-stagger-element">
							<div class="c-content-image-card__image js-animated-stagger-element">
								<figure class="c-responsive-image">
									<Picture
										pictureAttributes={{
											class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
										}}
										class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
										src={roomsImage1}
										formats={['avif', 'webp']}
										alt="A description of my image."
										widths={[640, 1140, 2000, roomsImage1.width]}
									/>
								</figure>
							</div>
						</div>

						<div class="c-content-image-card__content">
							<div class="c-content-image-card__tag-list u-a1">
								<span class="c-content-image-card__tag js-animated-stagger-element"> BODY</span>
							</div>

							<h3 class="c-content-image-card__title u-a3 js-animated-stagger-element">
								Deep Tissue Massage
							</h3>

							<div class="c-content-image-card__description u-b0 js-animated-stagger-element">
								<p>
									Recover fast after a strenuous workout or sports activities and help your body to
									eliminate metabolites, toxins and lactic acid. This intensive deep tissue massage
									will speed up the muscles recovery and restore the natural balance of the body.
								</p>
							</div>
							<div class="js-animated-stagger-element"></div>
						</div>
					</article>
				</div>
			</div>
		</div>
	</div>
</section>

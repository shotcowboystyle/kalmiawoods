---
import wellnessImage1 from '@/assets/images/wellness/wellness-1.jpeg';
import wellnessImage2 from '@/assets/images/wellness/wellness-2.jpeg';
import wellnessImage3 from '@/assets/images/wellness/wellness-3.jpeg';
import { Picture } from 'astro:assets';
---

<section class="section section--bg-blue">
	<div class="section-inner section-inner-pt-s section-inner-pb-m">
		<div class="container-narrow">
			<div class="c-image-grid c-image-grid--count-3">
				<figure class="c-responsive-image js-animated-stagger-element">
					<Picture
						pictureAttributes={{
							class: 'c-responsive-image__inner c-responsive-image__inner--4-3',
						}}
						class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
						src={wellnessImage1}
						formats={['avif', 'webp']}
						alt="A description of my image."
						widths={[640, 1140, 2000, wellnessImage1.width]}
					/>
				</figure>

				<figure class="c-responsive-image js-animated-stagger-element">
					<Picture
						pictureAttributes={{
							class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
						}}
						class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
						src={wellnessImage2}
						formats={['avif', 'webp']}
						alt="A description of my image."
						widths={[640, 1140, 2000, wellnessImage2.width]}
					/>
				</figure>

				<figure class="c-responsive-image js-animated-stagger-element">
					<Picture
						pictureAttributes={{
							class: 'c-responsive-image__inner c-responsive-image__inner--1-1',
						}}
						class="c-responsive-image__img c-responsive-image__img--cover c-responsive-image__img--center js-lazy-load entered loaded"
						src={wellnessImage3}
						formats={['avif', 'webp']}
						alt="A description of my image."
						widths={[640, 1140, 2000, wellnessImage3.width]}
					/>
				</figure>
			</div>
		</div>
	</div>
</section>

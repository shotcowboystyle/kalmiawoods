---
import { CONTACT_INFO } from '@/app/constants';
---

<section class="section">
	<div class="section-inner section-inner-pt-m section-inner-pb-xs">
		<div class="container">
			<div class="c-content-images-cta">
				<header class="c-content-images-cta__header">
					<h2 class="c-content-images-cta__title u-a5 js-animated-stagger-element">
						Contact our Wellness Department
					</h2>

					<div class="c-content-images-cta__description u-b0 js-animated-stagger-element">
						<p>+{CONTACT_INFO.wellness.phone}</p>
						<p>{CONTACT_INFO.wellness.email}</p>
					</div>
				</header>

				<div class="c-content-images-cta__list"></div>
			</div>
		</div>
	</div>
</section>

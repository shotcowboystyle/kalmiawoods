<section class="section">
	<div class="section-inner section-inner-pt-xl section-inner-pb-m">
		<div class="container">
			<div class="c-content-images-cta">
				<header class="c-content-images-cta__header">
					<h1 class="c-content-images-cta__title u-a5 js-animated-stagger-element">Coming Soon</h1>
				</header>

				<div class="c-content-images-cta__list"></div>
			</div>
		</div>
	</div>
</section>

<style>
	h1 {
		font-size: 110px;
		font-family: 'PP Woodland', serif;
		line-height: 120%;
		letter-spacing: -0.03em;
	}

	@media (min-width: 480px) {
		h1 {
			font-size: calc(5.0416666667vw + 105px);
		}
	}

	@media (min-width: 1440px) {
		h1 {
			font-size: 100px;
		}
	}

	@media (min-width: 1920px) {
		h1 {
			font-size: 10.0833333333vw;
		}
	}
</style>

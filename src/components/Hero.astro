---
import backgroundImg from '@/assets/images/house-cottage-three.jpeg';
import GradientText from '@/components/GradientText.astro';
---

<header class="relative h-[65vh] md:h-[85vh]">
  <div class="absolute z-10 h-4/6 w-full bg-gradient-to-b from-black"></div>
  <div class="absolute bottom-0 left-0 right-0 top-0 m-0 block overflow-hidden">
    <img
      alt="Kalmia Woods main house front view"
      class="h-screen w-full object-cover md:h-full"
      src={backgroundImg}
    />
  </div>
  <div class="container">
    <div class="absolute left-0 right-0 top-[35%] z-10 md:top-[50%] xl:top-[40%]">
      <div class="flex flex-col content-center items-center text-center text-white">
        <h1
          class="mx-auto flex max-w-[250px] flex-col content-center items-center px-4 text-2xl font-bold md:px-0 md:text-3xl xl:max-w-[350px] xl:text-4xl"
        >
          <div>Welcome to</div>
          <span class="text-center text-6xl font-extrabold md:text-8xl">
            <GradientText>{import.meta.env.APP_NAME}</GradientText>
          </span>
        </h1>
        <p class="py-2">
          Our cabin is located in the heart of the <br />
          Keowee-Toxaway wilderness of Oconee County.
        </p>
      </div>
    </div>
  </div>
</header>

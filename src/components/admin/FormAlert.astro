---
type Props = {
	tone: 'error' | 'success' | 'warning';
	message?: string;
};

const { tone, message } = Astro.props;

const classes = {
	error: 'border-error/40 bg-error/10 text-error',
	success: 'border-success/40 bg-success/10 text-success',
	warning: 'border-warning/40 bg-warning/40 text-warning-content',
}[tone];
---

{
	message && (
		<div
			class:list={['mb-4 rounded-lg border px-4 py-3 text-sm', classes]}
			role="alert"
		>
			{message}
		</div>
	)
}

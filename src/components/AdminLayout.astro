---
import '../styles/base.css';

const isSuperAdmin = Astro.locals.user?.role === 'super_admin';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Admin Dashboard</title>
	</head>
	<body class="bg-gray-100 min-h-screen font-sans antialiased text-gray-900 flex">
		<aside class="w-64 bg-white border-r border-gray-200 p-6 flex flex-col gap-4">
			<h1 class="text-2xl font-bold text-gray-800">Admin</h1>
			<nav class="flex flex-col gap-2 mt-4">
				<a href="/admin" class="text-gray-600 hover:text-blue-600 font-medium">Dashboard</a>
				<a href="/admin/reservations" class="text-gray-600 hover:text-blue-600 font-medium"
					>Reservations</a
				>
				{
					isSuperAdmin && (
						<a href="/admin/users" class="text-gray-600 hover:text-blue-600 font-medium">
							Users
						</a>
					)
				}
				<a href="/admin/account" class="text-gray-600 hover:text-blue-600 font-medium">Account</a>
			</nav>
			<form method="POST" action="/admin/logout" class="mt-auto">
				<button
					type="submit"
					class="w-full text-left text-red-600 hover:text-red-700 font-medium cursor-pointer"
					>Logout</button
				>
			</form>
		</aside>
		<main class="flex-1 p-8 overflow-y-auto">
			<slot />
		</main>
	</body>
</html>

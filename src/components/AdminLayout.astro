---
import '../styles/base.css';

const isSuperAdmin = Astro.locals.user?.role === 'super_admin';
const userEmail = Astro.locals.user?.email;
const pathname = Astro.url.pathname;

const navItems = [
	{ href: '/admin', label: 'Dashboard', match: (p: string) => p === '/admin' },
	{
		href: '/admin/reservations',
		label: 'Reservations',
		match: (p: string) => p.startsWith('/admin/reservations'),
	},
	...(isSuperAdmin
		? [
				{
					href: '/admin/users',
					label: 'Users',
					match: (p: string) => p.startsWith('/admin/users'),
				},
			]
		: []),
	{
		href: '/admin/account',
		label: 'Account',
		match: (p: string) => p.startsWith('/admin/account'),
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Admin Dashboard</title>
		<script is:inline>
			document.documentElement.setAttribute('data-theme', 'dark');
			document.documentElement.style.colorScheme = 'dark';
		</script>
	</head>
	<body class="bg-base-200 text-base-content min-h-screen font-sans antialiased flex">
		<aside class="w-64 bg-base-100 border-r border-base-300 p-6 flex flex-col gap-4">
			<h1 class="text-2xl font-bold text-base-content">Admin</h1>
			<nav class="flex flex-col gap-1 mt-4">
				{
					navItems.map((item) => {
						const active = item.match(pathname);
						return (
							<a
								href={item.href}
								aria-current={active ? 'page' : undefined}
								class:list={[
									'px-3 py-2 rounded-lg font-medium transition-colors',
									active
										? 'bg-primary/10 text-primary'
										: 'text-base-content/70 hover:text-primary hover:bg-base-200',
								]}
							>
								{item.label}
							</a>
						);
					})
				}
			</nav>
			<div class="mt-auto flex flex-col gap-3">
				{
					userEmail && (
						<p class="text-xs text-base-content/60 break-all" title={userEmail}>
							Signed in as
							<br />
							<span class="text-base-content/80">{userEmail}</span>
						</p>
					)
				}
				<form method="POST" action="/admin/logout">
					<button
						type="submit"
						class="w-full text-left text-error hover:text-error/80 font-medium cursor-pointer"
					>
						Logout
					</button>
				</form>
			</div>
		</aside>
		<main class="flex-1 p-8 overflow-y-auto">
			<slot />
		</main>
	</body>
</html>

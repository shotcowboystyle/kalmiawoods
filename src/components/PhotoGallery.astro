---
// import { Image } from 'astro:assets';
import { fetchLocalImages } from '@/utils/images';
import { getAssets } from '@/composables/getAssets';
import 'spotlight.js/dist/css/spotlight.min.css';

export const photoGallery = [
  {
    text: 'Cottage',
    href: 'https://google.com',
    image: 'house-cottage-two',
  },

  {
    text: 'Master Bedroom',
    href: 'https://google.com',
    image: 'house-master-bedroom-one',
  },

  {
    text: 'Garage Bedroom',
    href: 'https://google.com',
    image: 'house-garage-bedroom-one',
  },

  {
    text: 'Living Area',
    href: 'https://google.com',
    image: 'house-living-area-one',
  },

  {
    text: 'Kitchen',
    href: 'https://google.com',
    image: 'house-kitchen-one',
  },

  {
    text: 'Bathrooms',
    href: 'https://google.com',
    image: 'house-bathroom-one',
  },

  {
    text: 'Game Room',
    href: 'https://google.com',
    image: 'house-game-room-one',
  },

  {
    text: 'Porches',
    href: 'https://google.com',
    image: 'house-porch-one',
  },
];

const thumbnails = getAssets(await Astro.glob("../assets/images/*.jpeg"));
const getThumbnail = (name: string) => {
    return thumbnails.find(thumbnail => thumbnail.name === name);
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const imageFiles: Record<string, any> = await fetchLocalImages();
let images = await Promise.all(
  Object.entries(imageFiles).map(
    async ([imageKey, imageValue]) =>
      imageKey.includes('house-') && typeof imageValue === 'function' && (await imageValue()).default,
  ),
);
images = images.filter((image) => !!image);
---

<section class="my-10" data-images={JSON.stringify(images)} id="gallery-root">
  <div class="container max-sm:w-screen max-sm:overflow-hidden">
    <h2 class="mb-4 text-2xl font-bold text-base-content md:mb-4 md:text-3xl lg:mb-8 lg:text-4xl">
      Explore Inside
    </h2>
    <div
      class="max-sm:carousel-center max-sm:carousel max-sm:space-x-4 max-sm:px-4 sm:grid sm:grid-cols-2 sm:gap-x-1 sm:gap-y-2 lg:grid-cols-4 lg:gap-x-4"
    >
      {
        photoGallery.map(({ image, text }) => {
          const imageData = getThumbnail(image);
          if (!imageData?.src) {
            return null;
          }
          return (
            <div role="button" class="gallery-thumbnail max-sm:carousel-item max-sm:w-52">
              <figure
                role="button"
                class="gap-y-4 rounded-xl p-2 duration-300 active:scale-105 active:bg-gray-200 active:bg-opacity-40 max-sm:w-full lg:p-3"
              >
                <img
                  alt={text}
                  class="relative mb-2 h-40 w-full rounded-xl object-cover shadow-xl md:h-60 lg:h-72"
                  height={imageData?.height}
                  width={imageData?.width}
                  src={imageData?.src}
                />
                <figcaption class="text-md font-medium leading-5 text-base-content md:text-xl">
                  {text}
                </figcaption>
              </figure>
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<script>
  import Spotlight from 'spotlight.js/src/js/spotlight.js';

  const galleryRoot = document.getElementById('gallery-root');
  const images = galleryRoot?.dataset.images;

  const thumbnails = document.querySelectorAll('div.gallery-thumbnail');
  thumbnails.forEach((item) => {
    item.addEventListener(
      'click',
      () => {
        if (images?.length) {
          Spotlight.show(images && JSON.parse(images), {
            infinite: true,
            autofit: true,
            fit: 'cover',
          });
        }
      },
      { passive: true },
    );
  });
</script>

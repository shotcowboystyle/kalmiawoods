---
import SvgSprite from '@/components/SvgSprite.astro';
import { Link } from 'astro-link';

const { pages, headings, currentPage } = Astro.props;
---

<nav class="component-tree-navigation">
	<ul>
		<!-- {
      pages
        ? Object.entries(pages)
            ?.sort(([, prev], [, cur]) =>
              (prev?.main?.frontmatter?.order || 0) < (cur?.main?.frontmatter?.order || 1) ? -1 : 1,
            )
            .map(([key, page]) => (
              <li>
                <Link class:list={['unstyled', currentPage === key && 'current']} href={`docs/${key}`}>
                  {page?.main?.frontmatter?.title}
                </Link>
              </li>
            ))
        : headings?.map((heading) => (
            <li>
              <Link class="unstyled" href={`#${heading.slug}`}>
                {heading.text}
              </Link>
            </li>
          ))
    } -->
		{
			Object.entries(pages).map(([category, categoryData]) => (
				<div class="bg-base collapse collapse-arrow my-3 rounded-sm border border-base-300 shadow-lg">
					<input
						type="checkbox"
						checked={currentPage.startsWith(`${category}/`)}
					/>
					<div class="collapse-title flex w-full align-middle text-xl">
						<SvgSprite
							name="apple-icon"
							class="mr-2 h-8 w-8 border-x border-l-0 pr-2"
						/>
						<span class="font-bold">{categoryData.categoryTitle}</span>
					</div>
					<div class="collapse-content">
						{Object.entries(categoryData.subcategories)
							.sort(([, a], [, b]) => a.order - b.order)
							.map(([subcategory, subcategoryData]) => (
								<div>
									<Link
										class:list={[
											'link-hover link flex w-full border-y border-t-0 py-5 indent-10',
											currentPage === `${category}/${subcategory}` && 'link-primary',
										]}
										href={`/guide/${category.toLowerCase()}/${subcategory.toLowerCase()}`}
									>
										<span class="grow">{subcategoryData.subcategoryTitle}</span>
										<SvgSprite
											name="arrow-right-icon"
											class="h-6 w-6 self-end"
										/>
									</Link>
								</div>
							))}
					</div>
				</div>
			))
		}
	</ul>
</nav>

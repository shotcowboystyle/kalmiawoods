---

---

<input
	id="switch-input"
	name="switchInput"
	type="checkbox"
	class="hidden"
/>

<div
	id="color-scheme-switcher"
	class="bg-base-200 flex h-full flex-col rounded-2xl p-3.5 text-center sm:p-5"
>
	<div
		id="circle"
		class="relative m-auto h-24 w-24 rounded-full bg-gradient-to-br from-yellow-200 via-yellow-300 to-yellow-400"
	>
		<div
			id="crescent"
			class="bg-base-200 absolute right-0 h-16 w-16 rounded-full"
		>
		</div>
	</div>

	<label
		id="switch-button"
		for="switch-input"
		class="h-8 rounded-2xl"
	>
		<span class="hidden">Color scheme mode</span>
		<div
			id="color-scheme-toggle"
			class="h-8 rounded-2xl"
		>
		</div>
		<div
			id="color-schemes"
			class="h-8"
		>
			<p id="color-scheme-light-name">Light</p>
			<p id="color-scheme-dark-name">Dark</p>
		</div>
	</label>
</div>

<script>
	import { getColorScheme, setColorScheme } from '@/stores/color-scheme';

	const switchInput = document.getElementById('switch-input') as HTMLInputElement | null;

	document.addEventListener('astro:page-load', () => {
		const currentScheme = getColorScheme();
		if (switchInput && currentScheme === 'dark') {
			switchInput.checked = true;
		}
	});

	if (switchInput != null) {
		switchInput.addEventListener('change', () => {
			if (switchInput.checked) {
				setColorScheme('dark');
			} else {
				setColorScheme('light');
			}
		});
	}
</script>

<style>
	@reference "tailwindcss";

	#color-scheme-switcher {
		box-shadow:
			inset 0 0 0.5px 1px hsla(0, 0%, 100%, 0.075),
			0 0 0 1px hsla(0, 0%, 0%, 0.05),
			0 1px 1px rgba(0, 0, 0, 0.11),
			0 2px 2px rgba(0, 0, 0, 0.11),
			0 4px 4px rgba(0, 0, 0, 0.11),
			0 6px 8px rgba(0, 0, 0, 0.11),
			0 8px 16px rgba(0, 0, 0, 0.11);
	}

	#crescent {
		transform: scale(0);
		transform-origin: top right;
		transition: transform 0.6s cubic-bezier(0.645, 0.045, 0.355, 1);
	}

	#switch-button {
		@apply dark:bg-base-100/60 relative mx-auto mt-7 w-full cursor-pointer bg-black/5;
	}

	#color-scheme-toggle {
		@apply absolute w-1/2 bg-white;

		box-shadow: 0 2px 15px rgba(0, 0, 0, 0.15);
		transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	#color-schemes {
		@apply absolute mx-auto flex w-full items-center justify-around font-extrabold text-black select-none;

		#color-scheme-light-name,
		#color-scheme-dark-name {
			@apply text-center opacity-50;
		}
	}

	/* -------- Switch Styles ------------*/
	/* Toggle */
	#switch-input:checked + #color-scheme-switcher #color-scheme-toggle {
		@apply bg-neutral translate-x-full;
	}

	#switch-input:checked + #color-scheme-switcher #color-scheme-dark-name,
	#switch-input:checked + #color-scheme-switcher #color-scheme-light-name {
		@apply text-base-content opacity-100;
	}

	/* App */
	#switch-input:checked + #color-scheme-switcher #body {
		@apply bg-base-300 text-base-content rounded-2xl;
	}

	/* Circle */
	#switch-input:checked + #color-scheme-switcher #crescent {
		@apply bg-base-200;

		transform: scale(1);
	}

	#switch-input:checked + #color-scheme-switcher #circle {
		@apply bg-gradient-to-br from-blue-100 via-blue-300 to-blue-500;
	}
</style>

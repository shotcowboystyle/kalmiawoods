---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	aspectRatio: string;
	imgClass?: string;
}

const { src, alt, aspectRatio, imgClass } = Astro.props;
---

<figure class="c-responsive-image">
	<Picture
		pictureAttributes={{
			class: `c-responsive-image__inner c-responsive-image__inner--${aspectRatio}`,
		}}
		class:list={['c-responsive-image__img', imgClass]}
		src={src}
		formats={['avif', 'webp']}
		alt={alt}
		widths={[640, 1140, 2000, src.width]}
	/>
</figure>

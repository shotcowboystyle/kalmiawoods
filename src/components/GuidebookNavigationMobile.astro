---
import SvgSprite from '@/components/SvgSprite.astro';

// import './TreeNavigation.scss';
/* —————————————————————————————————————————————————————————————————————————— */

// interface Props {
//   pages?: Docs;
//   currentPage?: string;
//   headings?: MarkdownHeading[];
// }
// const { pages, headings, currentPage } = Astro.props as Props;
const { pages } = Astro.props;
---

<nav>
	<ul class="grid grid-cols-2 border bg-white shadow-xl shadow-neutral-100 md:lg:xl:grid-cols-3">
		<!-- {
      pages
        ? Object.entries(pages)
            ?.sort(([, prev], [, cur]) =>
              (prev?.main?.frontmatter?.order || 0) < (cur?.main?.frontmatter?.order || 1) ? -1 : 1,
            )
            .map(([key, page]) => (
              <li>
                <Link class:list={['unstyled', currentPage === key && 'current']} href={`docs/${key}`}>
                  {page?.main?.frontmatter?.title}
                </Link>
              </li>
            ))
        : headings?.map((heading) => (
            <li>
              <Link class="unstyled" href={`#${heading.slug}`}>
                {heading.text}
              </Link>
            </li>
          ))
    } -->
		{
			Object.entries(pages).map(([category, categoryData]) => (
				<li class="cursor-pointer border-b border-r p-5 text-center hover:bg-slate-50 md:lg:xl:p-10">
					<div class="inline-block rounded-full bg-red-500 p-5 text-white shadow-lg shadow-red-200">
						<SvgSprite
							name="apple"
							class="h-8 w-8"
						/>
					</div>
					<span class="mt-3 block min-w-0 break-words text-xl font-bold">
						{categoryData.categoryTitle}
					</span>
				</li>
			))
		}
	</ul>
</nav>

---
const nearbyAttractions = [
  {
    name: 'Whitewater Falls',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-waterfall-one.jpeg',
  },
  {
    name: 'Lake Jocassee',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-lake-jocassee-one.jpeg',
  },
  {
    name: 'Lake Keowee',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-lake-keowee-one.jpeg',
  },
  {
    name: 'Whitewater Falls',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-waterfall-two.jpeg',
  },
  {
    name: 'Lake Jocassee',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-lake-jocassee-two.jpeg',
  },
  {
    name: 'Lake Keowee',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-lake-keowee-two.jpeg',
  },
  {
    name: 'Whitewater Falls',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-waterfall-three.jpeg',
  },
  {
    name: 'Lake Jocassee',
    distance: '5-minute drive',
    href: 'https://google.com',
    image: '@/assets/images/attractions-lake-jocassee-three.jpeg',
  },
];
---

<section class="my-10">
  <div class="container max-sm:w-screen max-sm:overflow-hidden">
    <h2 class="mb-4 text-2xl font-bold text-base-content md:mb-4 md:text-3xl lg:mb-8 lg:text-4xl">
      Explore Nearby
    </h2>
    <div
      class="max-sm:carousel-center max-sm:carousel max-sm:space-x-4 max-sm:px-4 sm:grid sm:grid-cols-3 sm:gap-x-1 sm:gap-y-2 lg:grid-cols-4 lg:gap-x-4"
    >
      {
        nearbyAttractions.map((attraction) => (
          <a href={attraction.href} target="_blank" class="max-sm:carousel-item">
            <div class="flex items-center gap-x-4 rounded-xl p-2 drop-shadow-lg duration-300 active:scale-105 active:bg-gray-200 active:bg-opacity-40 sm:p-3">
              <div class="image-container min-h-min">
                <img
                  alt={attraction.name}
                  class="h-16 w-16 rounded-xl object-cover"
                  src={attraction.image}
                  height={64}
                  width={64}
                />
              </div>

              <div class="mt-0">
                <span class="block text-sm font-medium text-base-content lg:text-base">
                  {attraction.name}
                </span>
                <span class="text-sm text-base-content lg:text-base">{attraction.distance}</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

{
  "name": "@kalmiawoods/database",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "build": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy --preview-feature",
    "db:migrate:dev": "prisma migrate dev --preview-feature",
    "db:migrate:dev:create": "prisma migrate dev --create-only --preview-feature",
    "db:migrate:reset": "prisma migrate reset --preview-feature",
    "db:migrate:resolve": "prisma migrate resolve --preview-feature",
    "db:migrate:status": "prisma migrate status --preview-feature",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "prisma db seed",
    "db:docs:serve": "npx prisma-docs-generator serve",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^4.11.0"
  },
  "devDependencies": {
    "@kalmiawoods/tailwind-config": "workspace:*",
    "prisma": "4.12.0",
    "prisma-docs-generator": "^0.7.0",
    "prisma-erd-generator": "^1.5.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.3.12",
    "nestjs-pino": "^3.1.2"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "ts-node ./prisma/seed.ts"
  }
}

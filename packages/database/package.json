{
  "name": "@kalmiawoods/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "prebuild": "pnpm db:generate",
    "predev": "pnpm db:generate",
    "build": "tsup",
    "clean": "rimraf .turbo node_modules dist",
    "dev": "tsup --watch",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --preview-feature",
    "db:migrate:dev:create": "prisma migrate dev --create-only --preview-feature",
    "db:migrate:resolve": "prisma migrate resolve --preview-feature",
    "db:migrate:status": "prisma migrate status --preview-feature",
    "db:deploy": "prisma migrate deploy --preview-feature",
    "db:reset": "prisma migrate reset --skip-seed",
    "db:push": "prisma db push --skip-generate",
    "db:pull": "pnpm dlx prisma db pull",
    "db:seed": "prisma db seed",
    "db:seed:alt": "tsx src/seed.ts",
    "db:docs:serve": "pnpm dlx prisma-docs-generator serve",
    "prisma:studio": "prisma studio",
    "format": "prisma format"
  },
  "dependencies": {
    "@prisma/client": "^4.16.2"
  },
  "devDependencies": {
    "@kalmiawoods/tsconfig": "workspace:^",
    "prisma": "4.16.2",
    "tsup": "^7.1.0"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}

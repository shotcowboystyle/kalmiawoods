{
  "name": "@kalmiawoods/database",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.lib.json",
    "build:watch": "tsc -p tsconfig.lib.json -w --preserveWatchOutput",
    "dev": "pnpm run build:watch",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev --preview-feature",
    "db:migrate:dev:create": "prisma migrate dev --create-only --preview-feature",
    "db:migrate:resolve": "prisma migrate resolve --preview-feature",
    "db:migrate:status": "prisma migrate status --preview-feature",
    "db:deploy": "prisma migrate deploy --preview-feature",
    "db:reset": "prisma migrate reset --skip-seed",
    "db:push": "prisma db push --skip-generate",
    "db:pull": "pnpm dlx prisma db pull",
    "db:seed": "prisma db seed",
    "db:docs:serve": "pnpm dlx prisma-docs-generator serve",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^4.15.0"
  },
  "devDependencies": {
    "@kalmiawoods/tsconfig": "workspace:^",
    "@nestjs/testing": "^9.4.3",
    "dotenv": "^16.1.4",
    "prisma": "4.15.0",
    "prisma-docs-generator": "^0.8.0",
    "prisma-erd-generator": "^1.6.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.3.12",
    "dotenv": "^16.1.4",
    "nestjs-pino": "^3.1.2"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "ts-node ./prisma/seed.ts"
  }
}

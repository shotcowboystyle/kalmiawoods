generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["postgresqlExtensions"]
  // output = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
  // extensions = [uuid_ossp(map: "uuid-ossp")]
}

/// Complete data structure of the User entity for the database and GraphQL.
/// A User represents an account holder.
model AuthUser {
  /// User's unique identifier
  id String @id @unique

  // username       String?

  /// User's email address
  email          String  @unique
  /// User's email address
  email_verified Boolean
  // /// User's password
  // password              String?
  /// User's access role
  role           String  @default("USER")
  /// User's registration status
  status         String  @default("CREATED")

  auth_session AuthSession[]
  auth_key     AuthKey[]
  profile      UserProfile?
  reservation  Reservation[]

  // /// Date of User's creation in the database
  // createdAt             DateTime      @default(now()) @map("created_at")
  // /// Date of last update to User's record
  // updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("auth_users")
}

/// Complete data structure of the Profile entity for the database and GraphQL.
/// A Profile represents a User's details.
model UserProfile {
  /// Profile's unique identifier
  id           String  @id @unique
  /// Profile's mailing address
  address      String?
  /// Profile's first name
  first_name   String
  /// Profile's last name
  last_name    String
  /// Profile's mobilel phone number
  mobile_phone String  @unique
  /// Profile's picture
  avatar       String?
  // /// Date of Profile's creation in the database
  // createdAt   DateTime @default(now()) @map("created_at")
  // /// Date of last update to Profile's record
  // updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  /// The database identifier of the User associated with this Profile
  user_id   String   @unique
  auth_user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_profile")
}

model AuthSession {
  id             String   @id @unique
  active_expires BigInt
  idle_expires   BigInt
  user_id        String
  auth_user      AuthUser @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_sessions")
}

model AuthKey {
  id              String   @id @unique
  hashed_password String?
  primary_key     Boolean
  expires         BigInt?
  user_id         String
  auth_user       AuthUser @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_keys")
}

model Email {
  id            String   @id @unique
  subject       String
  email_address String
  date_sent     DateTime
  content       String

  @@map("emails")
}

model Reservation {
  /// Reservation's unique identifier
  id String @id @unique

  /// Start date of Reservation
  check_in_date  DateTime
  /// End date of Reservation
  check_out_date DateTime

  // /// Date of Reservation's creation in the database
  // createdAt   DateTime @default(now()) @map("created_at")
  // /// Date of last update to Reservation's record
  // updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  user_id   String
  auth_user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("reservations")
}


{
  "name": "@kalmiawoods/ui",
  "version": "0.2.0",
  "private": true,
  "main": "dist/kalmiawoods-ui-vue.umd.js",
  "module": "dist/kalmiawoods-ui-vue.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/*",
    "dist/style.css",
    "src/**/*.vue"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/kalmiawoods-ui-vue.es.js",
      "require": "./dist/kalmiawoods-ui-vue.umd.js"
    },
    "./style.css": {
      "import": "./dist/style.css"
    }
  },
  "scripts": {
    "dev": "vite build -w --mode development",
    "dev-old": "vite --open --force --host",
    "build": "vite build",
    "build:withTypes": "vite build && pnpm run build:types",
    "build:types": "vue-tsc --project tsconfig.build-types.json --declaration --emitDeclarationOnly --outDir dist/types ",
    "typecheck": "vue-tsc --project tsconfig.build-types.json --noEmit",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "lint:fix": "eslint --ext .js,.ts,.vue ./ --fix",
    "lint:style": "stylelint ./src/**/*.vue --fix"
  },
  "peerDependencies": {
    "@nanostores/persistent": "^0.9.0",
    "@nanostores/query": "^0.1.3",
    "@nanostores/vue": "^0.7.0",
    "@vueuse/core": "^9.12.0",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^2.0.0",
    "gsap": "^3.11.4",
    "js-cookie": "^3.0.5",
    "nanoid": "^4.0.1",
    "nanostores": "^0.7.3",
    "v-calendar": "3.0.0-alpha.8",
    "vue": "^3.2.47",
    "zod": "^3.21.4"
  },
  "dependencies": {
    "@nanostores/vue": "^0.9.1",
    "@vueuse/core": "^10.2.1",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "gsap": "^3.12.2",
    "lightcookie": "^1.0.25",
    "nanoid": "^4.0.2",
    "nanostores": "^0.9.3",
    "v-calendar": "3.0.0-alpha.8",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@babel/types": "^7.22.5",
    "@iconify/json": "^2.2.88",
    "@kalmiawoods/constants": "workspace:*",
    "@kalmiawoods/eslint-config": "workspace:*",
    "@kalmiawoods/tsconfig": "workspace:*",
    "@nanostores/persistent": "^0.9.0",
    "@nanostores/query": "^0.1.3",
    "@types/node": "^20.4.1",
    "@types/prettier": "^2.7.3",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/compiler-sfc": "^3.3.4",
    "@vue/devtools-api": "^6.5.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.44.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.15.1",
    "js-cookie": "^3.0.5",
    "prettier": "^3.0.0",
    "typescript": "^5.1.6",
    "unplugin-icons": "^0.16.3",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^4.4.2",
    "vue-tsc": "^1.8.4",
    "zod": "^3.21.4"
  }
}

{
  "name": "@kalmiawoods/ui",
  "version": "0.0.0",
  "private": true,
  "main": "dist/kalmiawoods-ui-vue.umd.js",
  "module": "dist/kalmiawoods-ui-vue.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/*",
    "dist/style.css",
    "src/**/*.vue"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/kalmiawoods-ui-vue.es.js",
      "require": "./dist/kalmiawoods-ui-vue.umd.js"
    },
    "./style.css": {
      "import": "./dist/style.css"
    }
  },
  "scripts": {
    "dev": "vite build -w --mode development",
    "dev-old": "vite --open --force --host",
    "build": "vite build",
    "build:withTypes": "vite build && pnpm run build:types",
    "build:types": "vue-tsc --project tsconfig.build-types.json --declaration --emitDeclarationOnly --outDir dist/types ",
    "typecheck": "vue-tsc --project tsconfig.build-types.json --noEmit",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "lint:style": "npx stylelint src/**/*.{scss,vue} --no-fix",
    "lint:fix": "eslint --fix ."
  },
  "peerDependencies": {
    "@nanostores/vue": "^0.7.0",
    "@vue/compiler-sfc": "^3.2.47",
    "@vueuse/core": "^9.12.0",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^2.0.0",
    "nanostores": "^0.7.3",
    "v-calendar": "3.0.0-alpha.8",
    "vue": "^3.2.47"
  },
  "devDependencies": {
    "@babel/types": "^7.20.5",
    "@iconify/json": "^2.2.24",
    "@kalmiawoods/constants": "workspace:*",
    "@kalmiawoods/tailwind-config": "workspace:*",
    "@kalmiawoods/tsconfig": "workspace:*",
    "@nanostores/vue": "^0.7.0",
    "@types/node": "^18.14.0",
    "@types/prettier": "^2.7.2",
    "@typescript-eslint/eslint-plugin": "^5.45.1",
    "@typescript-eslint/parser": "^5.45.1",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/compiler-sfc": "^3.2.47",
    "@vue/devtools-api": "^6.5.0",
    "@vue/tsconfig": "^0.1.3",
    "@vueuse/core": "^9.13.0",
    "autoprefixer": "^10.4.13",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^2.0.0",
    "eslint": "^8.34.0",
    "eslint-config-kalmiawoods": "workspace:*",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-vue": "^9.8.0",
    "nanostores": "^0.7.4",
    "prettier": "^2.8.4",
    "prettier-plugin-tailwindcss": "^0.2.2",
    "stylelint": "^15.1.0",
    "stylelint-config-css-modules": "^4.1.0",
    "stylelint-config-prettier": "^9.0.4",
    "stylelint-config-recess-order": "^4.0.0",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard": "^30.0.1",
    "stylelint-order": "^6.0.2",
    "tailwindcss": "^3.2.7",
    "typescript": "^4.9.3",
    "unplugin-icons": "^0.15.2",
    "unplugin-vue-components": "^0.24.0",
    "v-calendar": "3.0.0-alpha.8",
    "vite": "^4.1.2",
    "vue": "^3.2.47",
    "vue-tsc": "^1.1.3"
  }
}

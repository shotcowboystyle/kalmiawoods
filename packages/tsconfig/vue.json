{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Vue.js",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext", "DOM.Iterable", "ScriptHost", "WebWorker"],
    "jsx": "preserve",
    "useDefineForClassFields": true
  }
}

{
	"cleanUrls": true,
	"git": {
		"deploymentEnabled": {
			"renovate/**": false
		}
	},
	"ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)README.md' ':(exclude)CHANGELOG.md' ':(exclude)CLAUDE.md' ':(exclude).github'",
	"github": {
		"autoJobCancelation": true,
		"silent": true
	},
	"headers": [
		{
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			],
			"source": "/_astro/(.*)"
		}
	],
	"trailingSlash": false
}

{
	"cleanUrls": true,
	"git": {
		"deploymentEnabled": false
	},
	"github": {
		"autoJobCancelation": true,
		"silent": true
	},
	"headers": [
		{
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			],
			"source": "/_astro/(.*)"
		},
		{
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			],
			"source": "/sw.js"
		},
		{
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			],
			"source": "/manifest-admin.webmanifest"
		}
	],
	"trailingSlash": false
}
